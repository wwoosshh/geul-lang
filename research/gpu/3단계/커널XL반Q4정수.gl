            S2 = 바이트넷곱더하기(x2_1, wq1, S2).
            S2 = 바이트넷곱더하기(x2_2, wq2, S2).
            S2 = 바이트넷곱더하기(x2_3, wq3, S2).
            S2 = 바이트넷곱더하기(x2_4, wq4, S2).
            S2 = 바이트넷곱더하기(x2_5, wq5, S2).
            S2 = 바이트넷곱더하기(x2_6, wq6, S2).
            S2 = 바이트넷곱더하기(x2_7, wq7, S2).
            중간정수 x3_0 = 판i[0 + 3 * 깊이16 + b * 8 + 0].
            중간정수 x3_1 = 판i[0 + 3 * 깊이16 + b * 8 + 1].
            중간정수 x3_2 = 판i[0 + 3 * 깊이16 + b * 8 + 2].
            중간정수 x3_3 = 판i[0 + 3 * 깊이16 + b * 8 + 3].
            중간정수 x3_4 = 판i[0 + 3 * 깊이16 + b * 8 + 4].
            중간정수 x3_5 = 판i[0 + 3 * 깊이16 + b * 8 + 5].
            중간정수 x3_6 = 판i[0 + 3 * 깊이16 + b * 8 + 6].
            중간정수 x3_7 = 판i[0 + 3 * 깊이16 + b * 8 + 7].
            중간정수 S3 = 0.
            S3 = 바이트넷곱더하기(x3_0, wq0, S3).
            S3 = 바이트넷곱더하기(x3_1, wq1, S3).
            S3 = 바이트넷곱더하기(x3_2, wq2, S3).
            S3 = 바이트넷곱더하기(x3_3, wq3, S3).
            S3 = 바이트넷곱더하기(x3_4, wq4, S3).
            S3 = 바이트넷곱더하기(x3_5, wq5, S3).
            S3 = 바이트넷곱더하기(x3_6, wq6, S3).
            S3 = 바이트넷곱더하기(x3_7, wq7, S3).
            중간정수 M0 = 판i[6400 + b].
            판[7400 + b * (w) + nl] = 척도[b * (척도폭) + n].
            판[6600 + b * (w) + nl] = (((비트실수((M0 + 201326592) + S3) - 비트실수(M0 + 201326592)) + (비트실수((M0 + 134217728) + S2) - 비트실수(M0 + 134217728))) + (비트실수((M0 + 67108864) + S1) - 비트실수(M0 + 67108864))) + (비트실수((M0 + 0) + S0) - 비트실수(M0 + 0)).
        }
        동기화().
        {
            정수 열 = (그룹) * (w) + tid.
            (tid < w 그리고 열 < 열수)이면 {
                짧은실수 y = 0 으로 짧은실수.
                반복 (정수 b는 0부터 블록수 전까지) { y = 곱해더하기(판[6600 + b * (w) + tid], 판[7400 + b * (w) + tid], y). }
                짧은실수 v = y + 치우침[열].
                출력[행 * 열수 + 열] = v.
            }
        }
        동기화().
    }
}

(* 임베딩 — gpt2.gl 의 것과 같은 계산. 낱말표는 양자 형식(블록 평면 배치)에서 값 하나를 정확히 풀어 *)
[정수 참조 토큰에서 중간정수 참조 낱말표와 반실수 참조 낱말척도와 짧은실수 참조 위치표와 짧은실수 참조 출력에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 임베딩]는 {
    정수 i = 실행번호().
    i < 행수 * 1600이면 {
        정수 r = i / 1600.
        정수 c = i % 1600.
        정수 t = 토큰[r].
        정수 낱값kb = (c) >> 5.
        중간정수 낱값w = 낱말표[((낱값kb * 50257 + t) * 32 + ((c) & 31)) / 4].
        정수 낱값s = ((c) & 3) * 8.
        짧은실수 낱값 = (((((낱값w >> 낱값s) & 255) ^ 128) - 128) 으로 짧은실수) * 낱말척도[낱값kb * 50304 + t].
        출력[i] = 낱값 + 위치표[(위치시작 + r % 묶음안행수) * 1600 + c].
    }
}

(* 프롬프트 처리의 어텐션 — 블록 하나가 (머리, 질의 64 개). 키 조각마다 점수·최댓값·지수·합·가중합·접기. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 흐름어텐션 256 2 *)
[짧은실수 참조 q에서 반실수 참조 키칸과 반실수 참조 값칸과 짧은실수 참조 출력에 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 흐름어텐션]는 {
    정수 tid = 블록안가로().
    정수 머리 = 블록가로().
    정수 질조각수 = (묶음안행수 + 63) / 64.
    정수 문장 = 블록세로() / 질조각수.
    정수 r0 = (질조각수 - 1 - 블록세로() % 질조각수) * 64.
    정수 끝r = r0 + 63.
    끝r >= 묶음안행수이면 { 끝r = 묶음안행수 - 1. }
    정수 p0 = 위치시작 + r0.
    정수 끝조각 = (위치시작 + 끝r) / 64.
    정수 행바탕 = 문장 * 묶음안행수.
    정수 캐시 = (문장 * 25 + 머리) * 64 * 최대길이.
    짧은실수 참조 판 = 공유판48().
    정수 tq = tid / 16.
    정수 tt = tid % 16.
    정수 우두 = tid % 32 - tt.
    정수 qx = tq * 4.
    정수 kx = tt * 4.
    (* Qᵀ: 스레드가 질의 행 tid % 64 의 d 칸 넷(16 바이트) 넷을 읽어 [d][q] 에 *)
    정수 qr = r0 + tid % 64.
    qr > 끝r이면 { qr = 끝r. }
    정수 qsrc = (행바탕 + qr) * 1600 + 머리 * 64.
    정수 qc = (tid / 64) * 4.
    정수 qdst = qc * 64 + tid % 64.
    짧은실수 qv0_0 = q[qsrc + qc + 0].
    짧은실수 qv0_1 = q[qsrc + qc + 1].
    짧은실수 qv0_2 = q[qsrc + qc + 2].
    짧은실수 qv0_3 = q[qsrc + qc + 3].
    판[qdst + 0] = qv0_0.
    판[qdst + 64] = qv0_1.
    판[qdst + 128] = qv0_2.
    판[qdst + 192] = qv0_3.
    짧은실수 qv1_0 = q[qsrc + qc + 16].
    짧은실수 qv1_1 = q[qsrc + qc + 17].
    짧은실수 qv1_2 = q[qsrc + qc + 18].
    짧은실수 qv1_3 = q[qsrc + qc + 19].
    판[qdst + 1024] = qv1_0.
    판[qdst + 1088] = qv1_1.
    판[qdst + 1152] = qv1_2.
    판[qdst + 1216] = qv1_3.
    짧은실수 qv2_0 = q[qsrc + qc + 32].
    짧은실수 qv2_1 = q[qsrc + qc + 33].
    짧은실수 qv2_2 = q[qsrc + qc + 34].
    짧은실수 qv2_3 = q[qsrc + qc + 35].
    판[qdst + 2048] = qv2_0.
    판[qdst + 2112] = qv2_1.
    판[qdst + 2176] = qv2_2.
    판[qdst + 2240] = qv2_3.
    짧은실수 qv3_0 = q[qsrc + qc + 48].
    짧은실수 qv3_1 = q[qsrc + qc + 49].
    짧은실수 qv3_2 = q[qsrc + qc + 50].
    짧은실수 qv3_3 = q[qsrc + qc + 51].
    판[qdst + 3072] = qv3_0.
    판[qdst + 3136] = qv3_1.
    판[qdst + 3200] = qv3_2.
    판[qdst + 3264] = qv3_3.
    정수 pq0 = p0 + qx + 0.
    정수 pq1 = p0 + qx + 1.
    정수 pq2 = p0 + qx + 2.
    정수 pq3 = p0 + qx + 3.
    정수 ex0 = (qx + 0) % 8.
    정수 ex1 = (qx + 1) % 8.
    정수 ex2 = (qx + 2) % 8.
    정수 ex3 = (qx + 3) % 8.
    정수 eb0 = 4096 + (qx + 0) * 64.
    정수 eb1 = 4096 + (qx + 1) * 64.
    정수 eb2 = 4096 + (qx + 2) * 64.
    정수 eb3 = 4096 + (qx + 3) * 64.
    정수 vq = 8192 + kx.
    짧은실수 영 = 0 으로 짧은실수.
    짧은실수 M = 영.
    짧은실수 L = 영.
    짧은실수 옛비 = 영.
    짧은실수 새비 = 영.
    정수 방식 = 0.
    짧은실수 O0_0 = 영.
    짧은실수 O0_1 = 영.
    짧은실수 O0_2 = 영.
    짧은실수 O0_3 = 영.
    짧은실수 O1_0 = 영.
    짧은실수 O1_1 = 영.
    짧은실수 O1_2 = 영.
    짧은실수 O1_3 = 영.
    짧은실수 O2_0 = 영.
    짧은실수 O2_1 = 영.
    짧은실수 O2_2 = 영.
    짧은실수 O2_3 = 영.
    짧은실수 O3_0 = 영.

        중간정수 s0_2_0_3 = 정수텐서곱(3, a2_0_0, a2_0_1, a2_0_2, a2_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s0_1_0_0 = 정수텐서곱(0, a1_0_0, a1_0_1, a1_0_2, a1_0_3, b0, b1, 영i, 영i, 영i, 영i).

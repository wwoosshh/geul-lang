        중간정수 s1_1_0_2 = 정수텐서곱(2, a1_0_0, a1_0_1, a1_0_2, a1_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s1_1_0_3 = 정수텐서곱(3, a1_0_0, a1_0_1, a1_0_2, a1_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s1_0_0_0 = 정수텐서곱(0, a0_0_0, a0_0_1, a0_0_2, a0_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s1_0_0_1 = 정수텐서곱(1, a0_0_0, a0_0_1, a0_0_2, a0_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s1_0_0_2 = 정수텐서곱(2, a0_0_0, a0_0_1, a0_0_2, a0_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s1_0_0_3 = 정수텐서곱(3, a0_0_0, a0_0_1, a0_0_2, a0_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 T1_0_0 = (s1_3_0_0 * 256 + s1_2_0_0) * 256 + s1_1_0_0.
        y0_1_0 = 곱해더하기(곱해더하기(T1_0_0 으로 짧은실수, P0_0, (비트실수(mp0_0 + s1_0_0_0) - mf0_0)), d0, y0_1_0).
        중간정수 T1_0_1 = (s1_3_0_1 * 256 + s1_2_0_1) * 256 + s1_1_0_1.
        y0_1_1 = 곱해더하기(곱해더하기(T1_0_1 으로 짧은실수, P0_0, (비트실수(mp0_0 + s1_0_0_1) - mf0_0)), d1, y0_1_1).
        중간정수 T1_0_2 = (s1_3_0_2 * 256 + s1_2_0_2) * 256 + s1_1_0_2.
        y0_1_2 = 곱해더하기(곱해더하기(T1_0_2 으로 짧은실수, P0_1, (비트실수(mp0_1 + s1_0_0_2) - mf0_1)), d0, y0_1_2).
        중간정수 T1_0_3 = (s1_3_0_3 * 256 + s1_2_0_3) * 256 + s1_1_0_3.
        y0_1_3 = 곱해더하기(곱해더하기(T1_0_3 으로 짧은실수, P0_1, (비트실수(mp0_1 + s1_0_0_3) - mf0_1)), d1, y0_1_3).
        버퍼 = 버퍼 + 1.
        버퍼 == 2이면 { 버퍼 = 0. }
        올림버퍼 = 올림버퍼 + 1.
        올림버퍼 == 2이면 { 올림버퍼 = 0. }
    }
    짧은실수 v = 0 으로 짧은실수.
    짧은실수 u = v.
    짧은실수 th = v.
    정수 행0_0 = 행0 + wm * 16 + 0 + g.
    정수 행0_1 = 행0 + wm * 16 + 8 + g.
    정수 열0_0 = 열0 + wn * 16 + 0 + t * 2.
    정수 열0_1 = 열0 + wn * 16 + 1 + t * 2.
    정수 열1_0 = 열0 + wn * 16 + 8 + t * 2.
    정수 열1_1 = 열0 + wn * 16 + 9 + t * 2.
    짧은실수 치0_0 = v.
    짧은실수 치0_1 = v.
    짧은실수 치1_0 = v.
    짧은실수 치1_1 = v.
    열0_0 < 열수이면 { 치0_0 = 치우침[열0_0]. }
    열0_1 < 열수이면 { 치0_1 = 치우침[열0_1]. }
    열1_0 < 열수이면 { 치1_0 = 치우침[열1_0]. }
    열1_1 < 열수이면 { 치1_1 = 치우침[열1_1]. }
    정수 줄0_0 = 행0_0 * 열수.
    정수 줄0_1 = 행0_1 * 열수.
    (행0_0 < 행수 그리고 열0_0 < 열수)이면 {
        v = y0_0_0 + 치0_0.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄0_0 + 열0_0] = 0.5 * v * (1.0 + th).
    }
    (행0_0 < 행수 그리고 열0_1 < 열수)이면 {
        v = y0_0_1 + 치0_1.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄0_0 + 열0_1] = 0.5 * v * (1.0 + th).
    }
    (행0_1 < 행수 그리고 열0_0 < 열수)이면 {
        v = y0_0_2 + 치0_0.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄0_1 + 열0_0] = 0.5 * v * (1.0 + th).
    }
    (행0_1 < 행수 그리고 열0_1 < 열수)이면 {
        v = y0_0_3 + 치0_1.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄0_1 + 열0_1] = 0.5 * v * (1.0 + th).
    }
    (행0_0 < 행수 그리고 열1_0 < 열수)이면 {
        v = y0_1_0 + 치1_0.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄0_0 + 열1_0] = 0.5 * v * (1.0 + th).
    }
    (행0_0 < 행수 그리고 열1_1 < 열수)이면 {
        v = y0_1_1 + 치1_1.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄0_0 + 열1_1] = 0.5 * v * (1.0 + th).
    }
    (행0_1 < 행수 그리고 열1_0 < 열수)이면 {
        v = y0_1_2 + 치1_0.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄0_1 + 열1_0] = 0.5 * v * (1.0 + th).
    }
    (행0_1 < 행수 그리고 열1_1 < 열수)이면 {
        v = y0_1_3 + 치1_1.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄0_1 + 열1_1] = 0.5 * v * (1.0 + th).
    }
}

(* 정수 블록 계약의 행렬곱(Q4_0) — 64 × 256 칸, 워프 2 × 4. 커널생성.py 의 설명 *)
(* 실행한도 정수넓은타일선형_겔루 256 1 *)
[중간정수 참조 자릿값에서 중간정수 참조 정보와 중간정수 참조 가중치와 반실수 참조 척도와 짧은실수 참조 치우침과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 척도폭으로 정수넓은타일선형_겔루]는 {
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    정수 g = lane / 4.
    정수 t = lane % 4.
    정수 wm = (tid / 32) / 4.
    정수 wn = (tid / 32) % 4.
    정수 행0 = 블록가로() * 64.
    정수 열0 = 블록세로() * 256.
    짧은실수 참조 판 = 공유판40().
    중간정수 참조 판i = 판 으로 중간정수 참조.
    반실수 참조 판h = 판 으로 반실수 참조.
    짧은실수 참조 자리넓 = 자릿값 으로 짧은실수 참조.
    짧은실수 참조 정보넓 = 정보 으로 짧은실수 참조.
    짧은실수 참조 가중넓 = 가중치 으로 짧은실수 참조.
    짧은실수 참조 척도넓 = 척도 으로 짧은실수 참조.
    정수 블록수 = 깊이 / 32.
    정수 깊이4 = 깊이 / 4.
    정수 정보폭 = (행수 + 63) / 64 * 64.
    정수 ac0 = tid + 0.
    정수 ar0 = (ac0 / 2) % 64.
    정수 rg0 = 행0 + ar0.
    rg0 >= 행수이면 { rg0 = 행수 - 1. }
    정수 a저장0 = (ac0 / 128) * 512 + ar0 * 8 + (ac0 % 2) * 4.
    정수 ga0 = ((ac0 / 128) * 행수 + rg0) * 깊이4 + (ac0 % 2) * 4.
    정수 ac1 = tid + 256.
    정수 ar1 = (ac1 / 2) % 64.
    정수 rg1 = 행0 + ar1.
    rg1 >= 행수이면 { rg1 = 행수 - 1. }
    정수 a저장1 = (ac1 / 128) * 512 + ar1 * 8 + (ac1 % 2) * 4.
    정수 ga1 = ((ac1 / 128) * 행수 + rg1) * 깊이4 + (ac1 % 2) * 4.
    정수 gi = 행0 + tid * 4.
    정수 gs = 블록세로() * 128 + tid * 4.
    정수 척도걸음 = 척도폭 / 2.
    정수 bc0 = tid + 0.
    정수 cg0 = 열0 + bc0.
    cg0 >= 열수이면 { cg0 = 열수 - 1. }
    정수 b저장0 = bc0 * 4.
    정수 gb0 = cg0 * 4.
    정수 열걸음 = 열수 * 4.
    정수 oa = 0 + (wm * 32 + g) * 8 + t * 2.
    정수 oi = 3072 + wm * 32 + g.
    정수 os = 6272 + wn * 64 + t * 2.
    정수 ob = 2048 + (wn * 64 + g) * 4 + (t >> 1).
    정수 nsh = (t & 1) * 4.
    {
        정수 올바탕 = (0) * 3264.
        정수 k8 = (0) * 8.
        비동기복사16(판 에, 올바탕 + 0 + a저장0 를, 자리넓 에서, ga0 + k8 로).
        비동기복사16(판 에, 올바탕 + 0 + a저장1 를, 자리넓 에서, ga1 + k8 로).
        tid < 16이면 { 비동기복사16(판 에, 올바탕 + 3072 + tid * 4 를, 정보넓 에서, gi + (0) * 정보폭 로). }
        비동기복사16(판 에, 올바탕 + 2048 + b저장0 를, 가중넓 에서, gb0 + (0) * 열걸음 로).
        (tid < 32 그리고 열0 + tid * 8 < 척도폭)이면 { 비동기복사16(판 에, 올바탕 + 3136 + tid * 4 를, 척도넓 에서, gs + (0) * 척도걸음 로). }
    }
    비동기묶기().
    1 < 블록수이면 {
        정수 올바탕 = (1) * 3264.
        정수 k8 = (1) * 8.
        비동기복사16(판 에, 올바탕 + 0 + a저장0 를, 자리넓 에서, ga0 + k8 로).
        비동기복사16(판 에, 올바탕 + 0 + a저장1 를, 자리넓 에서, ga1 + k8 로).
        tid < 16이면 { 비동기복사16(판 에, 올바탕 + 3072 + tid * 4 를, 정보넓 에서, gi + (1) * 정보폭 로). }
        비동기복사16(판 에, 올바탕 + 2048 + b저장0 를, 가중넓 에서, gb0 + (1) * 열걸음 로).
        (tid < 32 그리고 열0 + tid * 8 < 척도폭)이면 { 비동기복사16(판 에, 올바탕 + 3136 + tid * 4 를, 척도넓 에서, gs + (1) * 척도걸음 로). }
    }
    비동기묶기().
    중간정수 영i = 0.
    짧은실수 영 = 0 으로 짧은실수.
    짧은실수 y0_0_0 = 영.
    짧은실수 y0_0_1 = 영.

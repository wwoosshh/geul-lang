        짧은실수 m = 큰쪽(큰쪽(큰쪽(x0, 0.0 - x0), 큰쪽(x1, 0.0 - x1)), 큰쪽(큰쪽(x2, 0.0 - x2), 큰쪽(x3, 0.0 - x3))).
        m = 큰쪽(m, 아래에서받기(m, 4)).
        m = 큰쪽(m, 아래에서받기(m, 2)).
        m = 큰쪽(m, 아래에서받기(m, 1)).
        m = 레인에서받기(m, lane - lane % 8).
        정수 E = -98.
        m > 0.0이면 {
            E = ((실수비트(m) >> 23) & 255) - 127.
            E < -98이면 { E = -98. }
            E > 100이면 { E = 100. }
        }
        짧은실수 s = 비트실수(((156 - E) << 23) 으로 중간정수).
        중간정수 n0 = 가까운정수(x0 * s).
        중간정수 d00 = ((n0 + 128) & 255) - 128.
        중간정수 m01 = (n0 - d00) >> 8.
        중간정수 d01 = ((m01 + 128) & 255) - 128.
        중간정수 m02 = (m01 - d01) >> 8.
        중간정수 d02 = ((m02 + 128) & 255) - 128.
        중간정수 d03 = (m02 - d02) >> 8.
        중간정수 n1 = 가까운정수(x1 * s).
        중간정수 d10 = ((n1 + 128) & 255) - 128.
        중간정수 m11 = (n1 - d10) >> 8.
        중간정수 d11 = ((m11 + 128) & 255) - 128.
        중간정수 m12 = (m11 - d11) >> 8.
        중간정수 d12 = ((m12 + 128) & 255) - 128.
        중간정수 d13 = (m12 - d12) >> 8.
        중간정수 n2 = 가까운정수(x2 * s).
        중간정수 d20 = ((n2 + 128) & 255) - 128.
        중간정수 m21 = (n2 - d20) >> 8.
        중간정수 d21 = ((m21 + 128) & 255) - 128.
        중간정수 m22 = (m21 - d21) >> 8.
        중간정수 d22 = ((m22 + 128) & 255) - 128.
        중간정수 d23 = (m22 - d22) >> 8.
        중간정수 n3 = 가까운정수(x3 * s).
        중간정수 d30 = ((n3 + 128) & 255) - 128.
        중간정수 m31 = (n3 - d30) >> 8.
        중간정수 d31 = ((m31 + 128) & 255) - 128.
        중간정수 m32 = (m31 - d31) >> 8.
        중간정수 d32 = ((m32 + 128) & 255) - 128.
        중간정수 d33 = (m32 - d32) >> 8.
        정수 자0 = 0. 자0 = ((d00 & 255) | ((d10 & 255) << 8) | ((d20 & 255) << 16) | (d30 << 24)) 으로 중간정수.
        정수 자1 = 0. 자1 = ((d01 & 255) | ((d11 & 255) << 8) | ((d21 & 255) << 16) | (d31 << 24)) 으로 중간정수.
        정수 자2 = 0. 자2 = ((d02 & 255) | ((d12 & 255) << 8) | ((d22 & 255) << 16) | (d32 << 24)) 으로 중간정수.
        정수 자3 = 0. 자3 = ((d03 & 255) | ((d13 & 255) << 8) | ((d23 & 255) << 16) | (d33 << 24)) 으로 중간정수.
        lane % 8 == 0이면 { r0 + qx + 3 <= 끝r이면 { 정보[b * 정보폭 + (행바탕 + r0 + qx + 3)] = (((121 + E) << 23) + 4194304) 으로 중간정수. } }
        r0 + qx + 3 <= 끝r이면 {
            자릿값[(0 * 행수 + (행바탕 + r0 + qx + 3)) * 400 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자0.
            자릿값[(1 * 행수 + (행바탕 + r0 + qx + 3)) * 400 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자1.
            자릿값[(2 * 행수 + (행바탕 + r0 + qx + 3)) * 400 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자2.
            자릿값[(3 * 행수 + (행바탕 + r0 + qx + 3)) * 400 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자3.
        }
    }
}

(* 정수 블록 계약의 행렬곱(Q4_0) — 64 × 128 칸, 워프 2 × 2. 커널생성.py 의 설명 *)
(* 실행한도 정수타일선형 128 3 *)
[중간정수 참조 자릿값에서 중간정수 참조 정보와 중간정수 참조 가중치와 반실수 참조 척도와 짧은실수 참조 치우침과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 척도폭으로 정수타일선형]는 {
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    정수 g = lane / 4.
    정수 t = lane % 4.
    정수 wm = (tid / 32) / 2.
    정수 wn = (tid / 32) % 2.

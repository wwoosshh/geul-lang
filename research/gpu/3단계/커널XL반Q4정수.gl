        버퍼 = 버퍼 + 1.
        버퍼 == 2이면 { 버퍼 = 0. }
        올림버퍼 = 올림버퍼 + 1.
        올림버퍼 == 2이면 { 올림버퍼 = 0. }
    }
    짧은실수 v = 0 으로 짧은실수.
    짧은실수 u = v.
    짧은실수 th = v.
    정수 행0_0 = 행0 + wm * 16 + 0 + g.
    정수 행0_1 = 행0 + wm * 16 + 8 + g.
    정수 열0_0 = 열0 + wn * 32 + 0 + t * 2.
    정수 열0_1 = 열0 + wn * 32 + 1 + t * 2.
    정수 열1_0 = 열0 + wn * 32 + 8 + t * 2.
    정수 열1_1 = 열0 + wn * 32 + 9 + t * 2.

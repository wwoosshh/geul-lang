        중간정수 s3_0_1_2 = 정수텐서곱(2, a0_1_0, a0_1_1, a0_1_2, a0_1_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s3_0_1_3 = 정수텐서곱(3, a0_1_0, a0_1_1, a0_1_2, a0_1_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 T3_0_0 = (s3_3_0_0 * 256 + s3_2_0_0) * 256 + s3_1_0_0.
        y0_3_0 = 곱해더하기(곱해더하기(T3_0_0 으로 짧은실수, P0_0, (비트실수(mp0_0 + s3_0_0_0) - mf0_0)), d0, y0_3_0).

    짧은실수 y0_1_2 = 영.
    짧은실수 y0_1_3 = 영.
    짧은실수 y0_2_0 = 영.
    짧은실수 y0_2_1 = 영.
    짧은실수 y0_2_2 = 영.
    짧은실수 y0_2_3 = 영.
    짧은실수 y0_3_0 = 영.
    짧은실수 y0_3_1 = 영.
    짧은실수 y0_3_2 = 영.
    짧은실수 y0_3_3 = 영.
    짧은실수 y1_0_0 = 영.
    짧은실수 y1_0_1 = 영.
    짧은실수 y1_0_2 = 영.
    짧은실수 y1_0_3 = 영.
    짧은실수 y1_1_0 = 영.
    짧은실수 y1_1_1 = 영.
    짧은실수 y1_1_2 = 영.
    짧은실수 y1_1_3 = 영.
    짧은실수 y1_2_0 = 영.
    짧은실수 y1_2_1 = 영.
    짧은실수 y1_2_2 = 영.
    짧은실수 y1_2_3 = 영.
    짧은실수 y1_3_0 = 영.
    짧은실수 y1_3_1 = 영.
    짧은실수 y1_3_2 = 영.
    짧은실수 y1_3_3 = 영.
    중간정수 a3_0_0 = 0.
    중간정수 a3_0_1 = 0.
    중간정수 a3_0_2 = 0.
    중간정수 a3_0_3 = 0.
    중간정수 a3_1_0 = 0.
    중간정수 a3_1_1 = 0.
    중간정수 a3_1_2 = 0.
    중간정수 a3_1_3 = 0.
    중간정수 a2_0_0 = 0.
    중간정수 a2_0_1 = 0.
    중간정수 a2_0_2 = 0.
    중간정수 a2_0_3 = 0.
    중간정수 a2_1_0 = 0.
    중간정수 a2_1_1 = 0.
    중간정수 a2_1_2 = 0.
    중간정수 a2_1_3 = 0.
    중간정수 a1_0_0 = 0.
    중간정수 a1_0_1 = 0.
    중간정수 a1_0_2 = 0.
    중간정수 a1_0_3 = 0.
    중간정수 a1_1_0 = 0.

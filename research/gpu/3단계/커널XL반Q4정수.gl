        짧은실수 vh2_3 = 값칸[캐시 + (tb + tq + 32) * 64 + kx + 3].
        짧은실수 kh3_0 = 키칸[캐시 + 조각 * 4096 + (tq + 48) * 64 + kx + 0].
        짧은실수 kh3_1 = 키칸[캐시 + 조각 * 4096 + (tq + 48) * 64 + kx + 1].
        짧은실수 kh3_2 = 키칸[캐시 + 조각 * 4096 + (tq + 48) * 64 + kx + 2].
        짧은실수 kh3_3 = 키칸[캐시 + 조각 * 4096 + (tq + 48) * 64 + kx + 3].
        짧은실수 vh3_0 = 값칸[캐시 + (tb + tq + 48) * 64 + kx + 0].
        짧은실수 vh3_1 = 값칸[캐시 + (tb + tq + 48) * 64 + kx + 1].
        짧은실수 vh3_2 = 값칸[캐시 + (tb + tq + 48) * 64 + kx + 2].
        짧은실수 vh3_3 = 값칸[캐시 + (tb + tq + 48) * 64 + kx + 3].
        판[4096 + (tq + 0) * 64 + kx + 0] = kh0_0.

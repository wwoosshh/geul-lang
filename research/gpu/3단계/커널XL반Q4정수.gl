        판[8192 + (tq + 32) * 64 + kx + 2] = vh2_2.
        판[8192 + (tq + 32) * 64 + kx + 3] = vh2_3.
        판[4096 + (tq + 48) * 64 + kx + 0] = kh3_0.
        판[4096 + (tq + 48) * 64 + kx + 1] = kh3_1.
        판[4096 + (tq + 48) * 64 + kx + 2] = kh3_2.
        판[4096 + (tq + 48) * 64 + kx + 3] = kh3_3.
        판[8192 + (tq + 48) * 64 + kx + 0] = vh3_0.
        판[8192 + (tq + 48) * 64 + kx + 1] = vh3_1.
        판[8192 + (tq + 48) * 64 + kx + 2] = vh3_2.
        판[8192 + (tq + 48) * 64 + kx + 3] = vh3_3.
        동기화().
        짧은실수 s0_0 = 영.
        짧은실수 s0_1 = 영.
        짧은실수 s0_2 = 영.
        짧은실수 s0_3 = 영.
        짧은실수 s1_0 = 영.
        짧은실수 s1_1 = 영.
        짧은실수 s1_2 = 영.
        짧은실수 s1_3 = 영.
        짧은실수 s2_0 = 영.
        짧은실수 s2_1 = 영.
        짧은실수 s2_2 = 영.
        짧은실수 s2_3 = 영.
        짧은실수 s3_0 = 영.
        짧은실수 s3_1 = 영.
        짧은실수 s3_2 = 영.
        짧은실수 s3_3 = 영.
        반복 (정수 d0 = 0: d0 < 64: d0 += 4) {
            정수 qo = qx + d0 * 64.
            정수 ko = kx + d0 * 64.
            짧은실수 a0_0 = 판[qo + 0].
            짧은실수 a0_1 = 판[qo + 1].
            짧은실수 a0_2 = 판[qo + 2].
            짧은실수 a0_3 = 판[qo + 3].

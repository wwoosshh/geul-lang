    블록 < 7이면 {
        정수 ec = 블록 * 256 + tid.
        ec < 1600이면 {
            {
                정수 낱값kb = (ec) >> 5.
                중간정수 낱값w = 낱말표[((낱값kb * 50257 + 토큰) * 32 + ((ec) & 31)) / 4].
                정수 낱값s = ((ec) & 3) * 8.
                짧은실수 낱값 = (((((낱값w >> 낱값s) & 255) ^ 128) - 128) 으로 짧은실수) * 낱말척도[낱값kb * 50304 + 토큰].
                숨칸[ec] = 낱값 + 위치표[위치 * 1600 + ec].
            }
        }
    }
    동기화().
    tid == 0이면 {
        울타리().

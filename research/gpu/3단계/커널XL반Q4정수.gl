        중간정수 s3_1_0_2 = 정수텐서곱(2, a1_0_0, a1_0_1, a1_0_2, a1_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s3_1_0_3 = 정수텐서곱(3, a1_0_0, a1_0_1, a1_0_2, a1_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s3_0_0_0 = 정수텐서곱(0, a0_0_0, a0_0_1, a0_0_2, a0_0_3, b0, b1, 영i, 영i, 영i, 영i).

(* 프롬프트 처리의 어텐션 — 블록 하나가 (머리, 질의 64 개). 키 조각마다 점수·최댓값·지수·합·가중합·접기. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 흐름어텐션정수 256 2 *)
[짧은실수 참조 q에서 반실수 참조 키칸과 반실수 참조 값칸과 중간정수 참조 정보와 중간정수 참조 자릿값에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 흐름어텐션정수]는 {
    정수 tid = 블록안가로().
    정수 머리 = 블록가로().
    정수 질조각수 = (묶음안행수 + 63) / 64.
    정수 문장 = 블록세로() / 질조각수.
    정수 r0 = (질조각수 - 1 - 블록세로() % 질조각수) * 64.
    정수 끝r = r0 + 63.
    끝r >= 묶음안행수이면 { 끝r = 묶음안행수 - 1. }
    정수 p0 = 위치시작 + r0.
    정수 끝조각 = (위치시작 + 끝r) / 64.
    정수 행바탕 = 문장 * 묶음안행수.
    정수 캐시 = (문장 * 25 + 머리) * 64 * 최대길이.
    짧은실수 참조 판 = 공유판48().
    정수 tq = tid / 16.
    정수 tt = tid % 16.
    정수 우두 = tid % 32 - tt.
    정수 qx = tq * 4.
    정수 kx = tt * 4.
    (* Qᵀ: 스레드가 질의 행 tid % 64 의 d 칸 넷(16 바이트) 넷을 읽어 [d][q] 에 *)
    정수 qr = r0 + tid % 64.
    qr > 끝r이면 { qr = 끝r. }
    정수 qsrc = (행바탕 + qr) * 1600 + 머리 * 64.
    정수 qc = (tid / 64) * 4.
    정수 qdst = qc * 64 + tid % 64.
    짧은실수 qv0_0 = q[qsrc + qc + 0].
    짧은실수 qv0_1 = q[qsrc + qc + 1].
    짧은실수 qv0_2 = q[qsrc + qc + 2].
    짧은실수 qv0_3 = q[qsrc + qc + 3].
    판[qdst + 0] = qv0_0.
    판[qdst + 64] = qv0_1.
    판[qdst + 128] = qv0_2.
    판[qdst + 192] = qv0_3.
    짧은실수 qv1_0 = q[qsrc + qc + 16].
    짧은실수 qv1_1 = q[qsrc + qc + 17].
    짧은실수 qv1_2 = q[qsrc + qc + 18].
    짧은실수 qv1_3 = q[qsrc + qc + 19].
    판[qdst + 1024] = qv1_0.
    판[qdst + 1088] = qv1_1.
    판[qdst + 1152] = qv1_2.
    판[qdst + 1216] = qv1_3.
    짧은실수 qv2_0 = q[qsrc + qc + 32].
    짧은실수 qv2_1 = q[qsrc + qc + 33].
    짧은실수 qv2_2 = q[qsrc + qc + 34].
    짧은실수 qv2_3 = q[qsrc + qc + 35].
    판[qdst + 2048] = qv2_0.
    판[qdst + 2112] = qv2_1.
    판[qdst + 2176] = qv2_2.
    판[qdst + 2240] = qv2_3.
    짧은실수 qv3_0 = q[qsrc + qc + 48].
    짧은실수 qv3_1 = q[qsrc + qc + 49].
    짧은실수 qv3_2 = q[qsrc + qc + 50].
    짧은실수 qv3_3 = q[qsrc + qc + 51].
    판[qdst + 3072] = qv3_0.
    판[qdst + 3136] = qv3_1.
    판[qdst + 3200] = qv3_2.
    판[qdst + 3264] = qv3_3.
    정수 pq0 = p0 + qx + 0.
    정수 pq1 = p0 + qx + 1.
    정수 pq2 = p0 + qx + 2.
    정수 pq3 = p0 + qx + 3.
    정수 ex0 = (qx + 0) % 8.
    정수 ex1 = (qx + 1) % 8.
    정수 ex2 = (qx + 2) % 8.
    정수 ex3 = (qx + 3) % 8.
    정수 eb0 = 4096 + (qx + 0) * 64.
    정수 eb1 = 4096 + (qx + 1) * 64.
    정수 eb2 = 4096 + (qx + 2) * 64.
    정수 eb3 = 4096 + (qx + 3) * 64.
    정수 vq = 8192 + kx.

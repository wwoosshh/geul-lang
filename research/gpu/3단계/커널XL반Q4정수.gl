        판[8192 + (tq + 16) * 64 + kx + 1] = vh1_1.
        판[8192 + (tq + 16) * 64 + kx + 2] = vh1_2.
        판[8192 + (tq + 16) * 64 + kx + 3] = vh1_3.
        판[4096 + (tq + 32) * 64 + kx + 0] = kh2_0.

(* 생성의 어텐션 (나) — 조각들을 위치 순서대로 접는다. 순서 약속은 커널생성.py 의 설명 *)
[짧은실수 참조 조각칸에서 짧은실수 참조 출력에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 조각접기]는 {
    정수 tid = 블록안가로().
    정수 쌍 = 블록가로().
    정수 행 = 쌍 / 25.
    정수 머리 = 쌍 % 25.
    정수 조각끝 = (위치시작 + 행 % 묶음안행수) / 64.
    정수 바탕 = 쌍 * (최대길이 / 64) * 68.
    짧은실수 참조 판 = 공유판8().
    정수 조각수끝 = 조각끝 + 1.
    반복 (정수 c = tid: c < 조각수끝: c += 256) {
        판[0 + c] = 조각칸[바탕 + c * 68].
        판[1028 + c] = 조각칸[바탕 + c * 68 + 1].
    }
    동기화().
    {
        짧은실수 pv = -3.0e38.
        tid < 조각수끝이면 { pv = 판[0 + tid]. }
        정수 레인 = tid % 32.
        정수 kk1 = 레인 - 1.
        kk1 < 0이면 { kk1 = 레인. }
        pv = 큰쪽(pv, 레인에서받기(pv, kk1)).
        정수 kk2 = 레인 - 2.
        kk2 < 0이면 { kk2 = 레인. }
        pv = 큰쪽(pv, 레인에서받기(pv, kk2)).
        정수 kk4 = 레인 - 4.
        kk4 < 0이면 { kk4 = 레인. }
        pv = 큰쪽(pv, 레인에서받기(pv, kk4)).
        정수 kk8 = 레인 - 8.
        kk8 < 0이면 { kk8 = 레인. }
        pv = 큰쪽(pv, 레인에서받기(pv, kk8)).
        정수 kk16 = 레인 - 16.
        kk16 < 0이면 { kk16 = 레인. }
        pv = 큰쪽(pv, 레인에서받기(pv, kk16)).
        레인 == 31이면 { 판[1284 + tid / 32] = pv. }
        동기화().
        반복 (정수 w = 0: w < tid / 32: w += 1) { pv = 큰쪽(pv, 판[1284 + w]). }
        tid < 조각수끝이면 { 판[256 + tid] = pv. }
    }
    동기화().
    반복 (정수 c = tid + 1: c < 조각수끝: c += 256) {
        판[512 + c] = 근사지수(판[256 + c - 1] - 판[256 + c]).
        판[768 + c] = 근사지수(판[0 + c] - 판[256 + c]).
    }
    동기화().
    tid == 64이면 {
        짧은실수 L = 판[1028].
        정수 cl = 1.
        반복 (: cl + 7 < 조각수끝: cl += 8) {
            짧은실수 la0 = 판[1028 + cl + 0].
            짧은실수 la1 = 판[1028 + cl + 1].
            짧은실수 la2 = 판[1028 + cl + 2].
            짧은실수 la3 = 판[1028 + cl + 3].
            짧은실수 la4 = 판[1028 + cl + 4].
            짧은실수 la5 = 판[1028 + cl + 5].
            짧은실수 la6 = 판[1028 + cl + 6].
            짧은실수 la7 = 판[1028 + cl + 7].
            짧은실수 lb0 = 판[768 + cl + 0].
            짧은실수 lb1 = 판[768 + cl + 1].
            짧은실수 lb2 = 판[768 + cl + 2].
            짧은실수 lb3 = 판[768 + cl + 3].
            짧은실수 lb4 = 판[768 + cl + 4].
            짧은실수 lb5 = 판[768 + cl + 5].
            짧은실수 lb6 = 판[768 + cl + 6].
            짧은실수 lb7 = 판[768 + cl + 7].
            짧은실수 lc0 = 판[512 + cl + 0].
            짧은실수 lc1 = 판[512 + cl + 1].
            짧은실수 lc2 = 판[512 + cl + 2].
            짧은실수 lc3 = 판[512 + cl + 3].
            짧은실수 lc4 = 판[512 + cl + 4].
            짧은실수 lc5 = 판[512 + cl + 5].
            짧은실수 lc6 = 판[512 + cl + 6].
            짧은실수 lc7 = 판[512 + cl + 7].
            L = 곱해더하기(la0, lb0, L * lc0).
            L = 곱해더하기(la1, lb1, L * lc1).
            L = 곱해더하기(la2, lb2, L * lc2).
            L = 곱해더하기(la3, lb3, L * lc3).
            L = 곱해더하기(la4, lb4, L * lc4).
            L = 곱해더하기(la5, lb5, L * lc5).
            L = 곱해더하기(la6, lb6, L * lc6).
            L = 곱해더하기(la7, lb7, L * lc7).
        }
        반복 (: cl < 조각수끝: cl += 1) { L = 곱해더하기(판[1028 + cl], 판[768 + cl], L * 판[512 + cl]). }
        판[1024] = L.
    }
    짧은실수 O = 0 으로 짧은실수.
    tid < 64이면 {
        O = 조각칸[바탕 + 4 + tid].
        정수 c = 1.

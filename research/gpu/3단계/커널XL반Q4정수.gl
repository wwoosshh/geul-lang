        중간정수 s0_1_0_1 = 정수텐서곱(1, a1_0_0, a1_0_1, a1_0_2, a1_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s0_1_0_2 = 정수텐서곱(2, a1_0_0, a1_0_1, a1_0_2, a1_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s0_1_0_3 = 정수텐서곱(3, a1_0_0, a1_0_1, a1_0_2, a1_0_3, b0, b1, 영i, 영i, 영i, 영i).

        중간정수 s3_3_0_1 = 정수텐서곱(1, a3_0_0, a3_0_1, a3_0_2, a3_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s3_3_0_2 = 정수텐서곱(2, a3_0_0, a3_0_1, a3_0_2, a3_0_3, b0, b1, 영i, 영i, 영i, 영i).

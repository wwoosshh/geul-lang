        중간정수 s1_0_0_1 = 정수텐서곱(1, a0_0_0, a0_0_1, a0_0_2, a0_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s1_0_0_2 = 정수텐서곱(2, a0_0_0, a0_0_1, a0_0_2, a0_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 s1_0_0_3 = 정수텐서곱(3, a0_0_0, a0_0_1, a0_0_2, a0_0_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 T1_0_0 = s1_3_0_0 * 256 + s1_2_0_0.
        y0_1_0 = 곱해더하기(곱해더하기(T1_0_0 으로 짧은실수, P0_0, (비트실수(mq0_0 + s1_1_0_0) - mqf0_0)) + (비트실수(mp0_0 + s1_0_0_0) - mf0_0), d0, y0_1_0).
        중간정수 T1_0_1 = s1_3_0_1 * 256 + s1_2_0_1.
        y0_1_1 = 곱해더하기(곱해더하기(T1_0_1 으로 짧은실수, P0_0, (비트실수(mq0_0 + s1_1_0_1) - mqf0_0)) + (비트실수(mp0_0 + s1_0_0_1) - mf0_0), d1, y0_1_1).
        중간정수 T1_0_2 = s1_3_0_2 * 256 + s1_2_0_2.

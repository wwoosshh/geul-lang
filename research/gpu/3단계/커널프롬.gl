                a = 곱해더하기(판[0 + k + 32], w8, a).
                a = 곱해더하기(판[0 + k + 36], w9, a).
                a = 곱해더하기(판[0 + k + 40], w10, a).
                a = 곱해더하기(판[0 + k + 44], w11, a).
                a = 곱해더하기(판[0 + k + 48], w12, a).
                a = 곱해더하기(판[0 + k + 52], w13, a).
                a = 곱해더하기(판[0 + k + 56], w14, a).
                a = 곱해더하기(판[0 + k + 60], w15, a).
            }
            반복 (: k < 768: k += 4) { a = 곱해더하기(판[0 + k], 전치낱말표[k * 50257 + cc], a). }
        }
        가닥 >= 2이면 { 판[rb + (가닥 - 2) * 32 + tx] = a. }
        동기화().
        가닥 < 2이면 { a = a + 판[rb + 가닥 * 32 + tx]. }
        동기화().
        가닥 == 1이면 { 판[rb + tx] = a. }
        동기화().
        (가닥 == 0 그리고 cg < 1571 그리고 열 < 50257)이면 {
            짧은실수 v = (a + 판[rb + tx]) + 0.0.
            로짓칸[열] = v.
            v > 최고이면 { 최고 = v. 최고번호 = 열. }
        }
        동기화().
    }
    tid % 128 < 32이면 { 판[3200 + 반 * 32 + tx] = 최고. 판[3200 + 64 + 반 * 32 + tx] = 최고번호 으로 짧은실수. }
    동기화().
    tid == 0이면 {
        짧은실수 큰 = 판[3200].
        정수 큰번호 = 판[3264] 으로 정수.
        반복 (정수 i = 1: i < 64: i += 1) {
            정수 번 = 판[3264 + i] 으로 정수.
            (판[3200 + i] > 큰 또는 (판[3200 + i] == 큰 그리고 번 < 큰번호))이면 { 큰 = 판[3200 + i]. 큰번호 = 번. }
        }
        부분값[블록] = 큰.
        부분번호[블록] = 큰번호.
        울타리().
        정수 옛2 = 원자더하기(장벽 에, 0 를, 1 로).
    }
    블록 == 0이면 {
        tid == 0이면 {
            (획득읽기(장벽 에서, 0 로) < 120) 동안 { }
            울타리().
            짧은실수 큰2 = 부분값[0].
            정수 큰번호2 = 부분번호[0].
            반복 (정수 i = 1: i < 120: i += 1) {
                (부분값[i] > 큰2 또는 (부분값[i] == 큰2 그리고 부분번호[i] < 큰번호2))이면 { 큰2 = 부분값[i]. 큰번호2 = 부분번호[i]. }
            }
            생성칸[0] = 큰번호2.
        }
    }
}

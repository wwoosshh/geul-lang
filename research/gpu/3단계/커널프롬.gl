(* 실행한도 프롬메가 256 2 *)
[정수 참조 토큰칸에 짧은실수 참조 낱말표와 짧은실수 참조 위치표와 짧은실수 참조 전치낱말표와 짧은실수 참조 첫감마와 짧은실수 참조 첫베타와 짧은실수 참조 주의가중과 짧은실수 참조 주의치우침과 짧은실수 참조 투영가중과 짧은실수 참조 투영치우침과 짧은실수 참조 둘감마와 짧은실수 참조 둘베타와 짧은실수 참조 확장가중과 짧은실수 참조 확장치우침과 짧은실수 참조 축소가중과 짧은실수 참조 축소치우침과 짧은실수 참조 끝감마와 짧은실수 참조 끝베타와 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 숨칸과 짧은실수 참조 정규칸과 짧은실수 참조 질의칸과 짧은실수 참조 주의출력과 짧은실수 참조 확장출력과 짧은실수 참조 로짓칸과 짧은실수 참조 부분값과 정수 참조 부분번호와 정수 참조 장벽과 정수 참조 일셈과 정수 참조 끝셈과 정수 참조 블록일과 정수 참조 생성칸과 정수 참조 시각칸과 정수 행수로 정수 최대길이로 정수 캐시문장수로 정수 묶음최대로 정수 시각기록으로 프롬메가]는 {
    정수 tid = 블록안가로().
    정수 블록 = 블록가로().
    짧은실수 참조 판 = 공유판48().
    짧은실수 영 = 0 으로 짧은실수.
    정수 캐시크기 = 캐시문장수 * 최대길이 * 768.
    정수 R = (행수 + 63) / 64.
    정수 작2 = 0.
    R * 36 < 240이면 { 작2 = 1. }
    정수 T2 = 36.
    작2 == 1이면 { T2 = 144. }
    정수 작4 = 0.
    R * 12 < 240이면 { 작4 = 1. }
    정수 T4 = 12.
    작4 == 1이면 { T4 = 48. }
    정수 작6 = 0.
    R * 48 < 240이면 { 작6 = 1. }
    정수 T6 = 48.
    작6 == 1이면 { T6 = 192. }
    정수 작7 = 0.
    R * 12 < 240이면 { 작7 = 1. }
    정수 T7 = 12.
    작7 == 1이면 { T7 = 48. }
    정수 경1 = 8 * R.
    정수 경2 = 경1 + T2 * R.
    정수 경3 = 경2 + 12 * R.
    정수 경4 = 경3 + T4 * R.
    정수 경5 = 경4 + 8 * R.
    정수 경6 = 경5 + T6 * R.
    정수 층일 = 경6 + T7 * R.
    정수 총일 = 8 * R + 12 * 층일.
    반복 (정수 영원 = 0: 영원 < 1: 영원 = 0) {
        tid == 0이면 { 블록일[블록] = 원자더하기(일셈 에, 0 를, 1 로). }
        동기화().
        정수 일 = 블록일[블록].
        동기화().
        일 >= 총일이면 { 탈출. }
        (시각기록 > 0 그리고 tid == 0)이면 { 시각칸[일 * 4] = 시각(). 시각칸[일 * 4 + 3] = 블록. }
        정수 단계 = 0.
        정수 층 = 0.
        정수 r = 일 / 8.
        정수 서브 = 일 % 8.
        일 >= 8 * R이면 {
            정수 j = 일 - 8 * R.
            층 = j / 층일.
            정수 k = j % 층일.
            k < 경1이면 { 단계 = 1. r = k / 8. 서브 = k % 8. }
            아니면 k < 경2이면 { 단계 = 2. r = (k - 경1) / T2. 서브 = (k - 경1) % T2. }
            아니면 k < 경3이면 { 단계 = 3. r = (k - 경2) / 12. 서브 = (k - 경2) % 12. }
            아니면 k < 경4이면 { 단계 = 4. r = (k - 경3) / T4. 서브 = (k - 경3) % T4. }
            아니면 k < 경5이면 { 단계 = 5. r = (k - 경4) / 8. 서브 = (k - 경4) % 8. }
            아니면 k < 경6이면 { 단계 = 6. r = (k - 경5) / T6. 서브 = (k - 경5) % T6. }
            아니면 { 단계 = 7. r = (k - 경6) / T7. 서브 = (k - 경6) % T7. }
        }
        정수 셈바탕 = 층 * 8 * 묶음최대.
        tid == 0이면 {
            단계 == 1이면 {
                층 == 0이면 {
                    (획득읽기(끝셈 에서, r 로) < 8) 동안 { }
                }
                아니면 {
                    (획득읽기(끝셈 에서, 셈바탕 - 묶음최대 + r 로) < T7) 동안 { }
                }
            }
            단계 == 2이면 {
                (획득읽기(끝셈 에서, 셈바탕 + 묶음최대 + r 로) < 8) 동안 { }
            }
            단계 == 3이면 {
                반복 (정수 rr = 0: rr <= r: rr += 1) {
                    (획득읽기(끝셈 에서, 셈바탕 + 2 * 묶음최대 + rr 로) < T2) 동안 { }
                }
            }
            단계 == 4이면 {
                (획득읽기(끝셈 에서, 셈바탕 + 3 * 묶음최대 + r 로) < 12) 동안 { }
            }
            단계 == 5이면 {
                (획득읽기(끝셈 에서, 셈바탕 + 4 * 묶음최대 + r 로) < T4) 동안 { }
            }
            단계 == 6이면 {
                (획득읽기(끝셈 에서, 셈바탕 + 5 * 묶음최대 + r 로) < 8) 동안 { }
            }
            단계 == 7이면 {
                (획득읽기(끝셈 에서, 셈바탕 + 6 * 묶음최대 + r 로) < T6) 동안 { }
            }
            울타리().
            시각기록 > 0이면 { 시각칸[일 * 4 + 1] = 시각(). }
        }
        동기화().
        단계 == 0이면 {
            (r * 64 + 서브 * 8 + 0 < 행수)이면 {
                정수 행 = r * 64 + 서브 * 8 + 0.
                정수 토 = 토큰칸[행].
                숨칸[행 * 768 + tid + 0] = 낱말표[토 * 768 + tid + 0] + 위치표[행 * 768 + tid + 0].
                숨칸[행 * 768 + tid + 256] = 낱말표[토 * 768 + tid + 256] + 위치표[행 * 768 + tid + 256].
                숨칸[행 * 768 + tid + 512] = 낱말표[토 * 768 + tid + 512] + 위치표[행 * 768 + tid + 512].
            }
            (r * 64 + 서브 * 8 + 1 < 행수)이면 {
                정수 행 = r * 64 + 서브 * 8 + 1.
                정수 토 = 토큰칸[행].
                숨칸[행 * 768 + tid + 0] = 낱말표[토 * 768 + tid + 0] + 위치표[행 * 768 + tid + 0].
                숨칸[행 * 768 + tid + 256] = 낱말표[토 * 768 + tid + 256] + 위치표[행 * 768 + tid + 256].
                숨칸[행 * 768 + tid + 512] = 낱말표[토 * 768 + tid + 512] + 위치표[행 * 768 + tid + 512].
            }
            (r * 64 + 서브 * 8 + 2 < 행수)이면 {
                정수 행 = r * 64 + 서브 * 8 + 2.
                정수 토 = 토큰칸[행].
                숨칸[행 * 768 + tid + 0] = 낱말표[토 * 768 + tid + 0] + 위치표[행 * 768 + tid + 0].
                숨칸[행 * 768 + tid + 256] = 낱말표[토 * 768 + tid + 256] + 위치표[행 * 768 + tid + 256].
                숨칸[행 * 768 + tid + 512] = 낱말표[토 * 768 + tid + 512] + 위치표[행 * 768 + tid + 512].
            }
            (r * 64 + 서브 * 8 + 3 < 행수)이면 {
                정수 행 = r * 64 + 서브 * 8 + 3.
                정수 토 = 토큰칸[행].
                숨칸[행 * 768 + tid + 0] = 낱말표[토 * 768 + tid + 0] + 위치표[행 * 768 + tid + 0].
                숨칸[행 * 768 + tid + 256] = 낱말표[토 * 768 + tid + 256] + 위치표[행 * 768 + tid + 256].
                숨칸[행 * 768 + tid + 512] = 낱말표[토 * 768 + tid + 512] + 위치표[행 * 768 + tid + 512].
            }
            (r * 64 + 서브 * 8 + 4 < 행수)이면 {
                정수 행 = r * 64 + 서브 * 8 + 4.
                정수 토 = 토큰칸[행].
                숨칸[행 * 768 + tid + 0] = 낱말표[토 * 768 + tid + 0] + 위치표[행 * 768 + tid + 0].
                숨칸[행 * 768 + tid + 256] = 낱말표[토 * 768 + tid + 256] + 위치표[행 * 768 + tid + 256].
                숨칸[행 * 768 + tid + 512] = 낱말표[토 * 768 + tid + 512] + 위치표[행 * 768 + tid + 512].
            }
            (r * 64 + 서브 * 8 + 5 < 행수)이면 {
                정수 행 = r * 64 + 서브 * 8 + 5.
                정수 토 = 토큰칸[행].
                숨칸[행 * 768 + tid + 0] = 낱말표[토 * 768 + tid + 0] + 위치표[행 * 768 + tid + 0].
                숨칸[행 * 768 + tid + 256] = 낱말표[토 * 768 + tid + 256] + 위치표[행 * 768 + tid + 256].
                숨칸[행 * 768 + tid + 512] = 낱말표[토 * 768 + tid + 512] + 위치표[행 * 768 + tid + 512].
            }
            (r * 64 + 서브 * 8 + 6 < 행수)이면 {
                정수 행 = r * 64 + 서브 * 8 + 6.
                정수 토 = 토큰칸[행].
                숨칸[행 * 768 + tid + 0] = 낱말표[토 * 768 + tid + 0] + 위치표[행 * 768 + tid + 0].
                숨칸[행 * 768 + tid + 256] = 낱말표[토 * 768 + tid + 256] + 위치표[행 * 768 + tid + 256].
                숨칸[행 * 768 + tid + 512] = 낱말표[토 * 768 + tid + 512] + 위치표[행 * 768 + tid + 512].
            }
            (r * 64 + 서브 * 8 + 7 < 행수)이면 {
                정수 행 = r * 64 + 서브 * 8 + 7.
                정수 토 = 토큰칸[행].
                숨칸[행 * 768 + tid + 0] = 낱말표[토 * 768 + tid + 0] + 위치표[행 * 768 + tid + 0].
                숨칸[행 * 768 + tid + 256] = 낱말표[토 * 768 + tid + 256] + 위치표[행 * 768 + tid + 256].
                숨칸[행 * 768 + tid + 512] = 낱말표[토 * 768 + tid + 512] + 위치표[행 * 768 + tid + 512].
            }
        }
        단계 == 1이면 {
            (r * 64 + 서브 * 8 + tid / 32 < 행수)이면 {
                {
                    정수 바탕 = (r * 64 + 서브 * 8 + tid / 32) * 768.
                    정수 l = tid % 32.
                    짧은실수 영 = 0 으로 짧은실수.
                    짧은실수 x0_0 = 숨칸[바탕 + l + 0].
                    짧은실수 x0_1 = 숨칸[바탕 + l + 256].
                    짧은실수 x0_2 = 숨칸[바탕 + l + 512].
                    짧은실수 x1_0 = 숨칸[바탕 + l + 32].
                    짧은실수 x1_1 = 숨칸[바탕 + l + 288].
                    짧은실수 x1_2 = 숨칸[바탕 + l + 544].
                    짧은실수 x2_0 = 숨칸[바탕 + l + 64].
                    짧은실수 x2_1 = 숨칸[바탕 + l + 320].
                    짧은실수 x2_2 = 숨칸[바탕 + l + 576].
                    짧은실수 x3_0 = 숨칸[바탕 + l + 96].
                    짧은실수 x3_1 = 숨칸[바탕 + l + 352].
                    짧은실수 x3_2 = 숨칸[바탕 + l + 608].
                    짧은실수 x4_0 = 숨칸[바탕 + l + 128].
                    짧은실수 x4_1 = 숨칸[바탕 + l + 384].
                    짧은실수 x4_2 = 숨칸[바탕 + l + 640].
                    짧은실수 x5_0 = 숨칸[바탕 + l + 160].
                    짧은실수 x5_1 = 숨칸[바탕 + l + 416].
                    짧은실수 x5_2 = 숨칸[바탕 + l + 672].
                    짧은실수 x6_0 = 숨칸[바탕 + l + 192].
                    짧은실수 x6_1 = 숨칸[바탕 + l + 448].
                    짧은실수 x6_2 = 숨칸[바탕 + l + 704].
                    짧은실수 x7_0 = 숨칸[바탕 + l + 224].
                    짧은실수 x7_1 = 숨칸[바탕 + l + 480].
                    짧은실수 x7_2 = 숨칸[바탕 + l + 736].
                    짧은실수 p0 = ((영 + x0_0) + x0_1) + x0_2.
                    짧은실수 p1 = ((영 + x1_0) + x1_1) + x1_2.
                    짧은실수 p2 = ((영 + x2_0) + x2_1) + x2_2.
                    짧은실수 p3 = ((영 + x3_0) + x3_1) + x3_2.
                    짧은실수 p4 = ((영 + x4_0) + x4_1) + x4_2.
                    짧은실수 p5 = ((영 + x5_0) + x5_1) + x5_2.
                    짧은실수 p6 = ((영 + x6_0) + x6_1) + x6_2.
                    짧은실수 p7 = ((영 + x7_0) + x7_1) + x7_2.
                    짧은실수 합 = ((p0 + p4) + (p2 + p6)) + ((p1 + p5) + (p3 + p7)).
                    합 = 합 + 아래에서받기(합, 16).
                    합 = 합 + 아래에서받기(합, 8).
                    합 = 합 + 아래에서받기(합, 4).
                    합 = 합 + 아래에서받기(합, 2).
                    합 = 합 + 아래에서받기(합, 1).
                    합 = 레인에서받기(합, 0).
                    짧은실수 평균 = 합 / 768.0.
                    짧은실수 d0_0 = x0_0 - 평균.

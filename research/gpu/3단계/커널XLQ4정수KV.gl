    }
    (행2_0 < 행수 그리고 열3_0 < 열수)이면 {
        v = y2_3_0 + 치3_0.
        출력[줄2_0 + 열3_0] = 잔차[줄2_0 + 열3_0] + v.
    }
    (행2_0 < 행수 그리고 열3_1 < 열수)이면 {
        v = y2_3_1 + 치3_1.
        출력[줄2_0 + 열3_1] = 잔차[줄2_0 + 열3_1] + v.
    }
    (행2_1 < 행수 그리고 열3_0 < 열수)이면 {
        v = y2_3_2 + 치3_0.
        출력[줄2_1 + 열3_0] = 잔차[줄2_1 + 열3_0] + v.
    }
    (행2_1 < 행수 그리고 열3_1 < 열수)이면 {
        v = y2_3_3 + 치3_1.
        출력[줄2_1 + 열3_1] = 잔차[줄2_1 + 열3_1] + v.
    }
    (행3_0 < 행수 그리고 열0_0 < 열수)이면 {
        v = y3_0_0 + 치0_0.
        출력[줄3_0 + 열0_0] = 잔차[줄3_0 + 열0_0] + v.
    }
    (행3_0 < 행수 그리고 열0_1 < 열수)이면 {
        v = y3_0_1 + 치0_1.
        출력[줄3_0 + 열0_1] = 잔차[줄3_0 + 열0_1] + v.
    }
    (행3_1 < 행수 그리고 열0_0 < 열수)이면 {
        v = y3_0_2 + 치0_0.
        출력[줄3_1 + 열0_0] = 잔차[줄3_1 + 열0_0] + v.
    }

    중간정수 mp0_0 = 0.
    중간정수 mp0_1 = 0.
    중간정수 mp1_0 = 0.
    중간정수 mp1_1 = 0.
    짧은실수 mf0_0 = 영.
    짧은실수 mf0_1 = 영.
    짧은실수 mf1_0 = 영.
    짧은실수 mf1_1 = 영.
    짧은실수 P0_0 = 영.

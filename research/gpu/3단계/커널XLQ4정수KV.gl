        }
        워프동기화().
        정수 정보폭 = (행수 + 63) / 64 * 64.
        반복 (정수 bb = 0: bb < 50: bb += 4) {
            정수 b0 = bb + lane / 8.
            정수 b = b0.
            b >= 50이면 { b = 49. }
            짧은실수 x0 = 판[wb + b * 32 + (lane % 8) * 4 + 0].
            짧은실수 x1 = 판[wb + b * 32 + (lane % 8) * 4 + 1].
            짧은실수 x2 = 판[wb + b * 32 + (lane % 8) * 4 + 2].
            짧은실수 x3 = 판[wb + b * 32 + (lane % 8) * 4 + 3].
            짧은실수 m = 큰쪽(큰쪽(큰쪽(x0, 0.0 - x0), 큰쪽(x1, 0.0 - x1)), 큰쪽(큰쪽(x2, 0.0 - x2), 큰쪽(x3, 0.0 - x3))).

(* 정수 블록 계약의 활성값 바꾸기 — 블록마다 지수, 14 비트 고정소수점, 균형 256진 두 자리, 마법수 *)
[짧은실수 참조 입력에서 중간정수 참조 자릿값에 중간정수 참조 정보에 정수 행수로 정수 깊이로 정수로]는 {
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    정수 r = 블록세로().
    정수 블록수 = 깊이 / 32.
    정수 깊이4 = 깊이 / 4 * 4.
    정수 면 = 깊이 / 4.
    정수 정보폭 = (행수 + 63) / 64 * 64.
    정수 b0 = 블록가로() * 32 + (tid / 32) * 4 + lane / 8.
    정수 b = b0.
    b >= 블록수이면 { b = 블록수 - 1. }
    정수 xa = r * 깊이4 + b * 32 + (lane % 8) * 4.
    짧은실수 x0 = 입력[xa + 0].
    짧은실수 x1 = 입력[xa + 1].
    짧은실수 x2 = 입력[xa + 2].
    짧은실수 x3 = 입력[xa + 3].
    짧은실수 m = 큰쪽(큰쪽(큰쪽(x0, 0.0 - x0), 큰쪽(x1, 0.0 - x1)), 큰쪽(큰쪽(x2, 0.0 - x2), 큰쪽(x3, 0.0 - x3))).
    m = 큰쪽(m, 아래에서받기(m, 4)).
    m = 큰쪽(m, 아래에서받기(m, 2)).
    m = 큰쪽(m, 아래에서받기(m, 1)).
    m = 레인에서받기(m, lane - lane % 8).
    정수 E = -98.
    m > 0.0이면 {
        E = ((실수비트(m) >> 23) & 255) - 127.
        E < -98이면 { E = -98. }
        E > 100이면 { E = 100. }
    }
    짧은실수 s = 비트실수(((140 - E) << 23) 으로 중간정수).
    중간정수 n0 = 가까운정수(x0 * s).
    중간정수 d00 = ((n0 + 128) & 255) - 128.
    중간정수 d01 = (n0 - d00) >> 8.
    중간정수 n1 = 가까운정수(x1 * s).
    중간정수 d10 = ((n1 + 128) & 255) - 128.
    중간정수 d11 = (n1 - d10) >> 8.
    중간정수 n2 = 가까운정수(x2 * s).
    중간정수 d20 = ((n2 + 128) & 255) - 128.
    중간정수 d21 = (n2 - d20) >> 8.
    중간정수 n3 = 가까운정수(x3 * s).
    중간정수 d30 = ((n3 + 128) & 255) - 128.
    중간정수 d31 = (n3 - d30) >> 8.
    정수 자0 = 0. 자0 = ((d00 & 255) | ((d10 & 255) << 8) | ((d20 & 255) << 16) | (d30 << 24)) 으로 중간정수.
    정수 자1 = 0. 자1 = ((d01 & 255) | ((d11 & 255) << 8) | ((d21 & 255) << 16) | (d31 << 24)) 으로 중간정수.
    lane % 8 == 0이면 { b0 < 블록수이면 { 정보[b * 정보폭 + r] = (((137 + E) << 23) + 4194304) 으로 중간정수. } }
    b0 < 블록수이면 {
        자릿값[(0 * 행수 + r) * 면 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자0.
        자릿값[(1 * 행수 + r) * 면 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자1.
    }
}

(* 층정규화 + 정수 블록 계약의 활성값 바꾸기 — 커널생성.py 의 설명 *)
[짧은실수 참조 입력에서 짧은실수 참조 감마와 짧은실수 참조 베타와 중간정수 참조 자릿값에 중간정수 참조 정보에 정수 행수로 층정규화정수]는 {
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    정수 행 = 블록가로() * 4 + tid / 32.
    짧은실수 참조 판 = 공유판28().
    정수 wb = (tid / 32) * 1600.
    행 < 행수이면 {
        {
            정수 바탕 = (행) * 1600.
            정수 l = tid % 32.
            짧은실수 영 = 0 으로 짧은실수.
            짧은실수 x0_0 = 입력[바탕 + l + 0].
            짧은실수 x0_1 = 입력[바탕 + l + 256].
            짧은실수 x0_2 = 입력[바탕 + l + 512].
            짧은실수 x0_3 = 입력[바탕 + l + 768].
            짧은실수 x0_4 = 입력[바탕 + l + 1024].
            짧은실수 x0_5 = 입력[바탕 + l + 1280].
            짧은실수 x0_6 = 입력[바탕 + l + 1536].
            짧은실수 x1_0 = 입력[바탕 + l + 32].
            짧은실수 x1_1 = 입력[바탕 + l + 288].
            짧은실수 x1_2 = 입력[바탕 + l + 544].
            짧은실수 x1_3 = 입력[바탕 + l + 800].
            짧은실수 x1_4 = 입력[바탕 + l + 1056].
            짧은실수 x1_5 = 입력[바탕 + l + 1312].
            짧은실수 x1_6 = 입력[바탕 + l + 1568].
            짧은실수 x2_0 = 입력[바탕 + l + 64].
            짧은실수 x2_1 = 입력[바탕 + l + 320].
            짧은실수 x2_2 = 입력[바탕 + l + 576].
            짧은실수 x2_3 = 입력[바탕 + l + 832].
            짧은실수 x2_4 = 입력[바탕 + l + 1088].
            짧은실수 x2_5 = 입력[바탕 + l + 1344].
            짧은실수 x3_0 = 입력[바탕 + l + 96].
            짧은실수 x3_1 = 입력[바탕 + l + 352].
            짧은실수 x3_2 = 입력[바탕 + l + 608].
            짧은실수 x3_3 = 입력[바탕 + l + 864].
            짧은실수 x3_4 = 입력[바탕 + l + 1120].
            짧은실수 x3_5 = 입력[바탕 + l + 1376].
            짧은실수 x4_0 = 입력[바탕 + l + 128].
            짧은실수 x4_1 = 입력[바탕 + l + 384].
            짧은실수 x4_2 = 입력[바탕 + l + 640].
            짧은실수 x4_3 = 입력[바탕 + l + 896].
            짧은실수 x4_4 = 입력[바탕 + l + 1152].
            짧은실수 x4_5 = 입력[바탕 + l + 1408].
            짧은실수 x5_0 = 입력[바탕 + l + 160].
            짧은실수 x5_1 = 입력[바탕 + l + 416].
            짧은실수 x5_2 = 입력[바탕 + l + 672].
            짧은실수 x5_3 = 입력[바탕 + l + 928].
            짧은실수 x5_4 = 입력[바탕 + l + 1184].
            짧은실수 x5_5 = 입력[바탕 + l + 1440].
            짧은실수 x6_0 = 입력[바탕 + l + 192].
            짧은실수 x6_1 = 입력[바탕 + l + 448].
            짧은실수 x6_2 = 입력[바탕 + l + 704].
            짧은실수 x6_3 = 입력[바탕 + l + 960].
            짧은실수 x6_4 = 입력[바탕 + l + 1216].
            짧은실수 x6_5 = 입력[바탕 + l + 1472].
            짧은실수 x7_0 = 입력[바탕 + l + 224].
            짧은실수 x7_1 = 입력[바탕 + l + 480].
            짧은실수 x7_2 = 입력[바탕 + l + 736].
            짧은실수 x7_3 = 입력[바탕 + l + 992].
            짧은실수 x7_4 = 입력[바탕 + l + 1248].
            짧은실수 x7_5 = 입력[바탕 + l + 1504].
            짧은실수 p0 = ((((((영 + x0_0) + x0_1) + x0_2) + x0_3) + x0_4) + x0_5) + x0_6.
            짧은실수 p1 = ((((((영 + x1_0) + x1_1) + x1_2) + x1_3) + x1_4) + x1_5) + x1_6.
            짧은실수 p2 = (((((영 + x2_0) + x2_1) + x2_2) + x2_3) + x2_4) + x2_5.
            짧은실수 p3 = (((((영 + x3_0) + x3_1) + x3_2) + x3_3) + x3_4) + x3_5.
            짧은실수 p4 = (((((영 + x4_0) + x4_1) + x4_2) + x4_3) + x4_4) + x4_5.
            짧은실수 p5 = (((((영 + x5_0) + x5_1) + x5_2) + x5_3) + x5_4) + x5_5.
            짧은실수 p6 = (((((영 + x6_0) + x6_1) + x6_2) + x6_3) + x6_4) + x6_5.
            짧은실수 p7 = (((((영 + x7_0) + x7_1) + x7_2) + x7_3) + x7_4) + x7_5.
            짧은실수 합 = ((p0 + p4) + (p2 + p6)) + ((p1 + p5) + (p3 + p7)).
            합 = 합 + 아래에서받기(합, 16).
            합 = 합 + 아래에서받기(합, 8).
            합 = 합 + 아래에서받기(합, 4).
            합 = 합 + 아래에서받기(합, 2).
            합 = 합 + 아래에서받기(합, 1).
            합 = 레인에서받기(합, 0).
            짧은실수 평균 = 합 / 1600.0.
            짧은실수 d0_0 = x0_0 - 평균.
            짧은실수 d0_1 = x0_1 - 평균.
            짧은실수 d0_2 = x0_2 - 평균.
            짧은실수 d0_3 = x0_3 - 평균.
            짧은실수 d0_4 = x0_4 - 평균.
            짧은실수 d0_5 = x0_5 - 평균.
            짧은실수 d0_6 = x0_6 - 평균.
            짧은실수 r0 = ((((((영 + d0_0 * d0_0) + d0_1 * d0_1) + d0_2 * d0_2) + d0_3 * d0_3) + d0_4 * d0_4) + d0_5 * d0_5) + d0_6 * d0_6.
            짧은실수 d1_0 = x1_0 - 평균.
            짧은실수 d1_1 = x1_1 - 평균.
            짧은실수 d1_2 = x1_2 - 평균.
            짧은실수 d1_3 = x1_3 - 평균.
            짧은실수 d1_4 = x1_4 - 평균.
            짧은실수 d1_5 = x1_5 - 평균.
            짧은실수 d1_6 = x1_6 - 평균.
            짧은실수 r1 = ((((((영 + d1_0 * d1_0) + d1_1 * d1_1) + d1_2 * d1_2) + d1_3 * d1_3) + d1_4 * d1_4) + d1_5 * d1_5) + d1_6 * d1_6.
            짧은실수 d2_0 = x2_0 - 평균.
            짧은실수 d2_1 = x2_1 - 평균.
            짧은실수 d2_2 = x2_2 - 평균.
            짧은실수 d2_3 = x2_3 - 평균.
            짧은실수 d2_4 = x2_4 - 평균.
            짧은실수 d2_5 = x2_5 - 평균.
            짧은실수 r2 = (((((영 + d2_0 * d2_0) + d2_1 * d2_1) + d2_2 * d2_2) + d2_3 * d2_3) + d2_4 * d2_4) + d2_5 * d2_5.
            짧은실수 d3_0 = x3_0 - 평균.
            짧은실수 d3_1 = x3_1 - 평균.
            짧은실수 d3_2 = x3_2 - 평균.
            짧은실수 d3_3 = x3_3 - 평균.
            짧은실수 d3_4 = x3_4 - 평균.
            짧은실수 d3_5 = x3_5 - 평균.
            짧은실수 r3 = (((((영 + d3_0 * d3_0) + d3_1 * d3_1) + d3_2 * d3_2) + d3_3 * d3_3) + d3_4 * d3_4) + d3_5 * d3_5.
            짧은실수 d4_0 = x4_0 - 평균.
            짧은실수 d4_1 = x4_1 - 평균.
            짧은실수 d4_2 = x4_2 - 평균.
            짧은실수 d4_3 = x4_3 - 평균.
            짧은실수 d4_4 = x4_4 - 평균.
            짧은실수 d4_5 = x4_5 - 평균.
            짧은실수 r4 = (((((영 + d4_0 * d4_0) + d4_1 * d4_1) + d4_2 * d4_2) + d4_3 * d4_3) + d4_4 * d4_4) + d4_5 * d4_5.
            짧은실수 d5_0 = x5_0 - 평균.
            짧은실수 d5_1 = x5_1 - 평균.
            짧은실수 d5_2 = x5_2 - 평균.
            짧은실수 d5_3 = x5_3 - 평균.
            짧은실수 d5_4 = x5_4 - 평균.
            짧은실수 d5_5 = x5_5 - 평균.
            짧은실수 r5 = (((((영 + d5_0 * d5_0) + d5_1 * d5_1) + d5_2 * d5_2) + d5_3 * d5_3) + d5_4 * d5_4) + d5_5 * d5_5.
            짧은실수 d6_0 = x6_0 - 평균.
            짧은실수 d6_1 = x6_1 - 평균.
            짧은실수 d6_2 = x6_2 - 평균.

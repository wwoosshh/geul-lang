            }
        }
    }
}

(* 층정규화 + 정수 블록 계약의 활성값 바꾸기 — 블록 하나가 한 행(256 스레드), 워프 판과 같은 비트. 커널생성.py 의 설명 *)
[짧은실수 참조 입력에서 짧은실수 참조 감마와 짧은실수 참조 베타와 중간정수 참조 자릿값에 중간정수 참조 정보에 정수 행수로 층정규화정수줄]는 {
    정수 행 = 블록가로().
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    짧은실수 참조 판 = 공유판8().
    정수 바탕 = 행 * 1600.
    짧은실수 부분 = 0 으로 짧은실수.
    반복 (정수 c = tid: c < 1600: c += 256) { 부분 += 입력[바탕 + c]. }
    판[1600 + tid] = 부분.
    동기화().
    반복 (정수 접기 = 128: 접기 > 0: 접기 /= 2) {
        tid < 접기이면 { 판[1600 + tid] = 판[1600 + tid] + 판[1600 + tid + 접기]. }
        동기화().
    }
    짧은실수 평균 = 판[1600] / 1600.0.
    동기화().
    짧은실수 제곱부분 = 0 으로 짧은실수.
    반복 (정수 c = tid: c < 1600: c += 256) {
        짧은실수 d = 입력[바탕 + c] - 평균.
        제곱부분 += d * d.
    }
    판[1600 + tid] = 제곱부분.
    동기화().
    반복 (정수 접기2 = 128: 접기2 > 0: 접기2 /= 2) {
        tid < 접기2이면 { 판[1600 + tid] = 판[1600 + tid] + 판[1600 + tid + 접기2]. }
        동기화().
    }
    짧은실수 역표준 = 1.0 / 제곱근(판[1600] / 1600.0 + 0.00001).
    반복 (정수 c = tid: c < 1600: c += 256) {
        판[c] = (입력[바탕 + c] - 평균) * 역표준 * 감마[c] + 베타[c].
    }
    동기화().
    정수 정보폭 = (행수 + 63) / 64 * 64.
    반복 (정수 bb = 0: bb < 50: bb += 32) {
        정수 b0 = bb + tid / 8.
        정수 b = b0.
        b >= 50이면 { b = 49. }
        짧은실수 x0 = 판[b * 32 + (lane % 8) * 4 + 0].
        짧은실수 x1 = 판[b * 32 + (lane % 8) * 4 + 1].
        짧은실수 x2 = 판[b * 32 + (lane % 8) * 4 + 2].
        짧은실수 x3 = 판[b * 32 + (lane % 8) * 4 + 3].
        짧은실수 m = 큰쪽(큰쪽(큰쪽(x0, 0.0 - x0), 큰쪽(x1, 0.0 - x1)), 큰쪽(큰쪽(x2, 0.0 - x2), 큰쪽(x3, 0.0 - x3))).
        m = 큰쪽(m, 아래에서받기(m, 4)).
        m = 큰쪽(m, 아래에서받기(m, 2)).
        m = 큰쪽(m, 아래에서받기(m, 1)).
        m = 레인에서받기(m, lane - lane % 8).
        정수 E = -98.
        m > 0.0이면 {
            E = ((실수비트(m) >> 23) & 255) - 127.
            E < -98이면 { E = -98. }
            E > 100이면 { E = 100. }
        }
        짧은실수 s = 비트실수(((140 - E) << 23) 으로 중간정수).
        중간정수 n0 = 가까운정수(x0 * s).
        중간정수 d00 = ((n0 + 128) & 255) - 128.
        중간정수 d01 = (n0 - d00) >> 8.
        중간정수 n1 = 가까운정수(x1 * s).
        중간정수 d10 = ((n1 + 128) & 255) - 128.
        중간정수 d11 = (n1 - d10) >> 8.
        중간정수 n2 = 가까운정수(x2 * s).
        중간정수 d20 = ((n2 + 128) & 255) - 128.
        중간정수 d21 = (n2 - d20) >> 8.
        중간정수 n3 = 가까운정수(x3 * s).
        중간정수 d30 = ((n3 + 128) & 255) - 128.
        중간정수 d31 = (n3 - d30) >> 8.
        정수 자0 = 0. 자0 = ((d00 & 255) | ((d10 & 255) << 8) | ((d20 & 255) << 16) | (d30 << 24)) 으로 중간정수.
        정수 자1 = 0. 자1 = ((d01 & 255) | ((d11 & 255) << 8) | ((d21 & 255) << 16) | (d31 << 24)) 으로 중간정수.
        lane % 8 == 0이면 { b0 < 50이면 { 정보[b * 정보폭 + 행] = (((137 + E) << 23) + 4194304) 으로 중간정수. } }
        b0 < 50이면 {
            자릿값[(0 * 행수 + 행) * 400 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자0.
            자릿값[(1 * 행수 + 행) * 400 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자1.
        }
    }
}

(* 정수 블록 계약의 행렬곱(Q4_0) — 64 × 128 칸, 워프 2 × 2. 커널생성.py 의 설명 *)
(* 실행한도 정수타일선형 128 3 *)
[중간정수 참조 자릿값에서 중간정수 참조 정보와 중간정수 참조 가중치와 반실수 참조 척도와 짧은실수 참조 치우침과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 척도폭으로 정수 행시작으로 정수 열시작으로 정수타일선형]는 {
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    정수 g = lane / 4.
    정수 t = lane % 4.
    정수 wm = (tid / 32) / 2.
    정수 wn = (tid / 32) % 2.
    정수 행0 = 행시작 + 블록가로() * 64.
    정수 열0 = 열시작 + 블록세로() * 128.
    짧은실수 참조 판 = 공유판16().
    중간정수 참조 판i = 판 으로 중간정수 참조.
    반실수 참조 판h = 판 으로 반실수 참조.

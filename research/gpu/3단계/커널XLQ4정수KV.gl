                정수 자1 = 0. 자1 = ((d01 & 255) | ((d11 & 255) << 8) | ((d21 & 255) << 16) | (d31 << 24)) 으로 중간정수.
                lane % 8 == 0이면 { b0_6 < 블록수이면 { 판i[6400 + b_6] = (((137 + E) << 23) + 4194304) 으로 중간정수. } }
                b0_6 < 블록수이면 {
                    판i[0 + 0 * ((깊이) / 4) + b_6 * 8 + lane % 8] = 자0.
                    판i[0 + 1 * ((깊이) / 4) + b_6 * 8 + lane % 8] = 자1.
                }
            }
            동기화().
        }
        반복 (정수 p = tid: p < (w) * (블록수): p += 256) {
            정수 nl = p % (w).
            정수 b = p / (w).
            정수 n = (그룹) * (w) + nl.
            n >= 열수이면 { n = 열수 - 1. }
            정수 wb = (b * (열수) + n) * 8.
            중간정수 wq0 = 가중치[wb + 0].
            중간정수 wq1 = 가중치[wb + 1].
            중간정수 wq2 = 가중치[wb + 2].
            중간정수 wq3 = 가중치[wb + 3].
            중간정수 wq4 = 가중치[wb + 4].
            중간정수 wq5 = 가중치[wb + 5].
            중간정수 wq6 = 가중치[wb + 6].
            중간정수 wq7 = 가중치[wb + 7].
            중간정수 x0_0 = 판i[0 + 0 * 깊이16 + b * 8 + 0].
            중간정수 x0_1 = 판i[0 + 0 * 깊이16 + b * 8 + 1].
            중간정수 x0_2 = 판i[0 + 0 * 깊이16 + b * 8 + 2].
            중간정수 x0_3 = 판i[0 + 0 * 깊이16 + b * 8 + 3].
            중간정수 x0_4 = 판i[0 + 0 * 깊이16 + b * 8 + 4].
            중간정수 x0_5 = 판i[0 + 0 * 깊이16 + b * 8 + 5].
            중간정수 x0_6 = 판i[0 + 0 * 깊이16 + b * 8 + 6].
            중간정수 x0_7 = 판i[0 + 0 * 깊이16 + b * 8 + 7].
            중간정수 S0 = 0.
            S0 = 바이트넷곱더하기(x0_0, wq0, S0).
            S0 = 바이트넷곱더하기(x0_1, wq1, S0).
            S0 = 바이트넷곱더하기(x0_2, wq2, S0).
            S0 = 바이트넷곱더하기(x0_3, wq3, S0).
            S0 = 바이트넷곱더하기(x0_4, wq4, S0).
            S0 = 바이트넷곱더하기(x0_5, wq5, S0).
            S0 = 바이트넷곱더하기(x0_6, wq6, S0).
            S0 = 바이트넷곱더하기(x0_7, wq7, S0).
            중간정수 x1_0 = 판i[0 + 1 * 깊이16 + b * 8 + 0].
            중간정수 x1_1 = 판i[0 + 1 * 깊이16 + b * 8 + 1].
            중간정수 x1_2 = 판i[0 + 1 * 깊이16 + b * 8 + 2].
            중간정수 x1_3 = 판i[0 + 1 * 깊이16 + b * 8 + 3].
            중간정수 x1_4 = 판i[0 + 1 * 깊이16 + b * 8 + 4].
            중간정수 x1_5 = 판i[0 + 1 * 깊이16 + b * 8 + 5].
            중간정수 x1_6 = 판i[0 + 1 * 깊이16 + b * 8 + 6].
            중간정수 x1_7 = 판i[0 + 1 * 깊이16 + b * 8 + 7].
            중간정수 S1 = 0.
            S1 = 바이트넷곱더하기(x1_0, wq0, S1).
            S1 = 바이트넷곱더하기(x1_1, wq1, S1).
            S1 = 바이트넷곱더하기(x1_2, wq2, S1).
            S1 = 바이트넷곱더하기(x1_3, wq3, S1).
            S1 = 바이트넷곱더하기(x1_4, wq4, S1).
            S1 = 바이트넷곱더하기(x1_5, wq5, S1).
            S1 = 바이트넷곱더하기(x1_6, wq6, S1).
            S1 = 바이트넷곱더하기(x1_7, wq7, S1).
            중간정수 M0 = 판i[6400 + b].
            판[7400 + b * (w) + nl] = 척도[b * (척도폭) + n].
            판[6600 + b * (w) + nl] = (비트실수((M0 + 67108864) + S1) - 비트실수(M0 + 67108864)) + (비트실수((M0 + 0) + S0) - 비트실수(M0 + 0)).
        }
        동기화().
        {
            정수 열 = (그룹) * (w) + tid.
            (tid < w 그리고 열 < 열수)이면 {
                짧은실수 y = 0 으로 짧은실수.
                반복 (정수 b는 0부터 블록수 전까지) { y = 곱해더하기(판[6600 + b * (w) + tid], 판[7400 + b * (w) + tid], y). }
                짧은실수 v = y + 치우침[열].
                출력[행 * 열수 + 열] = v.
            }
        }
        동기화().
    }
}

(* 임베딩 — gpt2.gl 의 것과 같은 계산. 낱말표는 양자 형식(블록 평면 배치)에서 값 하나를 정확히 풀어 *)
[정수 참조 토큰에서 중간정수 참조 낱말표와 반실수 참조 낱말척도와 짧은실수 참조 위치표와 짧은실수 참조 출력에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 임베딩]는 {
    정수 i = 실행번호().
    i < 행수 * 1600이면 {
        정수 r = i / 1600.
        정수 c = i % 1600.
        정수 t = 토큰[r].
        정수 낱값kb = (c) >> 5.
        중간정수 낱값w = 낱말표[((낱값kb * 50257 + t) * 32 + ((c) & 31)) / 4].
        정수 낱값s = ((c) & 3) * 8.
        짧은실수 낱값 = (((((낱값w >> 낱값s) & 255) ^ 128) - 128) 으로 짧은실수) * 낱말척도[낱값kb * 50304 + t].
        출력[i] = 낱값 + 위치표[(위치시작 + r % 묶음안행수) * 1600 + c].
    }
}

(* 정수 KV 계약 — c_attn 의 q · k · v 행을 자리 둘 · 지수로: q 는 자릿값q, 키 · 값은 캐시에. 커널생성.py 의 설명 *)
[짧은실수 참조 입력에서 중간정수 참조 자릿값q에 중간정수 참조 정보q에 중간정수 참조 키칸과 중간정수 참조 값칸과 부호없는 작은정수 참조 키지수와 부호없는 작은정수 참조 값지수와 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 KV정수로]는 {
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    정수 r = 블록세로().
    정수 블록수 = 150.
    정수 정보폭 = (행수 + 63) / 64 * 64.
    정수 b0 = 블록가로() * 32 + (tid / 32) * 4 + lane / 8.
    정수 b = b0.
    b >= 블록수이면 { b = 블록수 - 1. }
    정수 xa = r * 4800 + b * 32 + (lane % 8) * 4.
    정수 문장 = r / 묶음안행수.
    정수 위치 = 위치시작 + r % 묶음안행수.
    정수 머리바탕 = 문장 * 25 + (b % 50) / 2.
    정수 bb = (b % 50) % 2.
    작은정수 참조 값바이트 = 값칸 으로 작은정수 참조.
    중간정수 M0 = 0.
    짧은실수 x0 = 입력[xa + 0].
    짧은실수 x1 = 입력[xa + 1].
    짧은실수 x2 = 입력[xa + 2].
    짧은실수 x3 = 입력[xa + 3].
    짧은실수 m = 큰쪽(큰쪽(큰쪽(x0, 0.0 - x0), 큰쪽(x1, 0.0 - x1)), 큰쪽(큰쪽(x2, 0.0 - x2), 큰쪽(x3, 0.0 - x3))).
    m = 큰쪽(m, 아래에서받기(m, 4)).
    m = 큰쪽(m, 아래에서받기(m, 2)).
    m = 큰쪽(m, 아래에서받기(m, 1)).
    m = 레인에서받기(m, lane - lane % 8).
    정수 E = -98.
    m > 0.0이면 {
        E = ((실수비트(m) >> 23) & 255) - 127.
        E < -98이면 { E = -98. }
        E > 100이면 { E = 100. }
    }
    짧은실수 s = 비트실수(((140 - E) << 23) 으로 중간정수).
    중간정수 n0 = 가까운정수(x0 * s).
    중간정수 d00 = ((n0 + 128) & 255) - 128.
    중간정수 d01 = (n0 - d00) >> 8.
    중간정수 n1 = 가까운정수(x1 * s).
    중간정수 d10 = ((n1 + 128) & 255) - 128.
    중간정수 d11 = (n1 - d10) >> 8.
    중간정수 n2 = 가까운정수(x2 * s).
    중간정수 d20 = ((n2 + 128) & 255) - 128.
    중간정수 d21 = (n2 - d20) >> 8.
    중간정수 n3 = 가까운정수(x3 * s).
    중간정수 d30 = ((n3 + 128) & 255) - 128.
    중간정수 d31 = (n3 - d30) >> 8.
    정수 자0 = 0. 자0 = ((d00 & 255) | ((d10 & 255) << 8) | ((d20 & 255) << 16) | (d30 << 24)) 으로 중간정수.
    정수 자1 = 0. 자1 = ((d01 & 255) | ((d11 & 255) << 8) | ((d21 & 255) << 16) | (d31 << 24)) 으로 중간정수.
    lane % 8 == 0이면 { M0 = (((137 + E) << 23) + 4194304) 으로 중간정수. }
    정수 pos = ((lane % 8) % 4) * 2 + (lane % 8) / 4.
    b0 < 블록수이면 {
        b < 50이면 {
            자릿값q[(0 * 행수 + r) * 400 + b * 8 + pos] = 자0.
            자릿값q[(1 * 행수 + r) * 400 + b * 8 + pos] = 자1.
            lane % 8 == 0이면 { 정보q[b * 정보폭 + r] = M0. }
        }
        아니면 b < 100이면 {
            키칸[(머리바탕 * 2 + 0) * 최대길이 * 16 + 위치 * 16 + bb * 8 + pos] = 자0.
            키칸[(머리바탕 * 2 + 1) * 최대길이 * 16 + 위치 * 16 + bb * 8 + pos] = 자1.
            lane % 8 == 0이면 { 키지수[(머리바탕 * 최대길이 + 위치) * 2 + bb] = (E + 114) 으로 부호없는 작은정수. }
        }
        아니면 {
            정수 r32 = 위치 % 32.
            정수 r16 = r32 % 16.
            정수 낱말 = ((r16 % 8) / 2) * 2 + r32 / 16.
            정수 바이트 = (r16 / 8) * 2 + r16 % 2.
            정수 d0 = bb * 32 + (lane % 8) * 4.
            정수 값바탕 = ((머리바탕 * (최대길이 / 32) + 위치 / 32) * 2) * 2048.
            값바이트[값바탕 + 0 * 2048 + (d0 + 0) * 32 + 낱말 * 4 + 바이트] = d00 으로 작은정수.
            값바이트[값바탕 + 0 * 2048 + (d0 + 1) * 32 + 낱말 * 4 + 바이트] = d10 으로 작은정수.
            값바이트[값바탕 + 0 * 2048 + (d0 + 2) * 32 + 낱말 * 4 + 바이트] = d20 으로 작은정수.
            값바이트[값바탕 + 0 * 2048 + (d0 + 3) * 32 + 낱말 * 4 + 바이트] = d30 으로 작은정수.
            값바이트[값바탕 + 1 * 2048 + (d0 + 0) * 32 + 낱말 * 4 + 바이트] = d01 으로 작은정수.
            값바이트[값바탕 + 1 * 2048 + (d0 + 1) * 32 + 낱말 * 4 + 바이트] = d11 으로 작은정수.
            값바이트[값바탕 + 1 * 2048 + (d0 + 2) * 32 + 낱말 * 4 + 바이트] = d21 으로 작은정수.
            값바이트[값바탕 + 1 * 2048 + (d0 + 3) * 32 + 낱말 * 4 + 바이트] = d31 으로 작은정수.
            lane % 8 == 0이면 { 값지수[(머리바탕 * 최대길이 + 위치) * 2 + bb] = (E + 114) 으로 부호없는 작은정수. }
        }
    }
}

(* 정수 KV 계약의 프롬프트 어텐션 — 블록 하나가 (머리, 질의 64 개), 워프마다 16. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 정수어텐션 128 2 *)
[중간정수 참조 자릿값q에서 중간정수 참조 정보q와 중간정수 참조 키칸과 중간정수 참조 값칸과 부호없는 작은정수 참조 키지수와 부호없는 작은정수 참조 값지수와 중간정수 참조 정보와 중간정수 참조 자릿값에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 정수어텐션]는 {
    정수 tid = 블록안가로().
    정수 머리 = 블록가로().
    정수 질조각수 = (묶음안행수 + 63) / 64.
    정수 문장 = 블록세로() / 질조각수.
    정수 r0 = (질조각수 - 1 - 블록세로() % 질조각수) * 64.
    정수 끝r = r0 + 63.
    끝r >= 묶음안행수이면 { 끝r = 묶음안행수 - 1. }
    정수 p0 = 위치시작 + r0.
    정수 끝조각 = (위치시작 + 끝r) / 64.
    정수 행바탕 = 문장 * 묶음안행수.
    정수 정보폭 = (행수 + 63) / 64 * 64.
    정수 머리바탕 = 문장 * 25 + 머리.
    정수 키바탕 = 머리바탕 * 2 * 최대길이 * 16.
    정수 값바탕 = 머리바탕 * (최대길이 / 32) * 1024.
    정수 지수바이트 = 머리바탕 * 최대길이 * 2.
    정수 lane = tid % 32.
    정수 g = lane / 4.
    정수 t = lane % 4.
    정수 w = tid / 32.
    짧은실수 참조 판 = 공유판36().
    중간정수 참조 판i = 판 으로 중간정수 참조.
    부호없는 작은정수 참조 판b = 판 으로 부호없는 작은정수 참조.
    짧은실수 참조 키넓 = 키칸 으로 짧은실수 참조.
    짧은실수 참조 값넓 = 값칸 으로 짧은실수 참조.
    짧은실수 참조 키지넓 = 키지수 으로 짧은실수 참조.
    짧은실수 참조 값지넓 = 값지수 으로 짧은실수 참조.
    중간정수 영i = 0.
    짧은실수 영 = 0 으로 짧은실수.
    정수 qr0 = r0 + w * 16 + g + 0.
    qr0 > 끝r이면 { qr0 = 끝r. }
    정수 pq0 = 위치시작 + qr0.
    정수 qo0_0_0 = (0 * 행수 + 행바탕 + qr0) * 400 + (머리 * 2 + 0) * 8 + t * 2.
    중간정수 qa0_0_0_0 = 자릿값q[qo0_0_0].
    중간정수 qa0_0_0_1 = 자릿값q[qo0_0_0 + 1].
    정수 qo0_1_0 = (0 * 행수 + 행바탕 + qr0) * 400 + (머리 * 2 + 1) * 8 + t * 2.
    중간정수 qa0_1_0_0 = 자릿값q[qo0_1_0].
    중간정수 qa0_1_0_1 = 자릿값q[qo0_1_0 + 1].
    정수 qo1_0_0 = (1 * 행수 + 행바탕 + qr0) * 400 + (머리 * 2 + 0) * 8 + t * 2.
    중간정수 qa1_0_0_0 = 자릿값q[qo1_0_0].
    중간정수 qa1_0_0_1 = 자릿값q[qo1_0_0 + 1].
    정수 qo1_1_0 = (1 * 행수 + 행바탕 + qr0) * 400 + (머리 * 2 + 1) * 8 + t * 2.
    중간정수 qa1_1_0_0 = 자릿값q[qo1_1_0].
    중간정수 qa1_1_0_1 = 자릿값q[qo1_1_0 + 1].
    짧은실수 pqs0_0 = 비트실수(정보q[(머리 * 2 + 0) * 정보폭 + 행바탕 + qr0] - 222298112).
    짧은실수 pqs1_0 = 비트실수(정보q[(머리 * 2 + 1) * 정보폭 + 행바탕 + qr0] - 222298112).
    정수 qr1 = r0 + w * 16 + g + 8.
    qr1 > 끝r이면 { qr1 = 끝r. }
    정수 pq1 = 위치시작 + qr1.
    정수 qo0_0_1 = (0 * 행수 + 행바탕 + qr1) * 400 + (머리 * 2 + 0) * 8 + t * 2.
    중간정수 qa0_0_1_0 = 자릿값q[qo0_0_1].
    중간정수 qa0_0_1_1 = 자릿값q[qo0_0_1 + 1].
    정수 qo0_1_1 = (0 * 행수 + 행바탕 + qr1) * 400 + (머리 * 2 + 1) * 8 + t * 2.

        출력[줄3_0 + 열0_1] = 0.5 * v * (1.0 + th).
    }
    (행3_1 < 행수 그리고 열0_0 < 열수)이면 {
        v = y3_0_2 + 치0_0.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄3_1 + 열0_0] = 0.5 * v * (1.0 + th).
    }
    (행3_1 < 행수 그리고 열0_1 < 열수)이면 {
        v = y3_0_3 + 치0_1.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄3_1 + 열0_1] = 0.5 * v * (1.0 + th).
    }
    (행3_0 < 행수 그리고 열1_0 < 열수)이면 {
        v = y3_1_0 + 치1_0.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).
        th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
        출력[줄3_0 + 열1_0] = 0.5 * v * (1.0 + th).
    }
    (행3_0 < 행수 그리고 열1_1 < 열수)이면 {
        v = y3_1_1 + 치1_1.
        u = 0.7978845608 * (v + 0.044715 * v * v * v).

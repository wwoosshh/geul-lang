            중간정수 d31 = (n3 - d30) >> 8.
            중간정수 n4 = 가까운정수(x4 * s).
            중간정수 d40 = ((n4 + 128) & 255) - 128.
            중간정수 d41 = (n4 - d40) >> 8.
            중간정수 n5 = 가까운정수(x5 * s).
            중간정수 d50 = ((n5 + 128) & 255) - 128.
            중간정수 d51 = (n5 - d50) >> 8.
            중간정수 n6 = 가까운정수(x6 * s).
            중간정수 d60 = ((n6 + 128) & 255) - 128.
            중간정수 d61 = (n6 - d60) >> 8.
            중간정수 n7 = 가까운정수(x7 * s).
            중간정수 d70 = ((n7 + 128) & 255) - 128.
            중간정수 d71 = (n7 - d70) >> 8.
            판s[(wb + 0 + (8 + g) * 8 + ((0 + t / 2) % 4) * 2 + 0) * 2 + t % 2] = ((d00 & 255) | ((d10 & 255) << 8)) 으로 짧은정수.
            판s[(wb + 128 + (8 + g) * 8 + ((0 + t / 2) % 4) * 2 + 0) * 2 + t % 2] = ((d01 & 255) | ((d11 & 255) << 8)) 으로 짧은정수.
            판s[(wb + 0 + (8 + g) * 8 + ((2 + t / 2) % 4) * 2 + 0) * 2 + t % 2] = ((d20 & 255) | ((d30 & 255) << 8)) 으로 짧은정수.
            판s[(wb + 128 + (8 + g) * 8 + ((2 + t / 2) % 4) * 2 + 0) * 2 + t % 2] = ((d21 & 255) | ((d31 & 255) << 8)) 으로 짧은정수.
            판s[(wb + 0 + (8 + g) * 8 + ((4 + t / 2) % 4) * 2 + 1) * 2 + t % 2] = ((d40 & 255) | ((d50 & 255) << 8)) 으로 짧은정수.
            판s[(wb + 128 + (8 + g) * 8 + ((4 + t / 2) % 4) * 2 + 1) * 2 + t % 2] = ((d41 & 255) | ((d51 & 255) << 8)) 으로 짧은정수.
            판s[(wb + 0 + (8 + g) * 8 + ((6 + t / 2) % 4) * 2 + 1) * 2 + t % 2] = ((d60 & 255) | ((d70 & 255) << 8)) 으로 짧은정수.
            판s[(wb + 128 + (8 + g) * 8 + ((6 + t / 2) % 4) * 2 + 1) * 2 + t % 2] = ((d61 & 255) | ((d71 & 255) << 8)) 으로 짧은정수.
            (행1_1 < 행수 그리고 t == 0)이면 { 다음정보[(블록열 / 32) * 정보폭 + 행1_1] = (((137 + E) << 23) + 4194304) 으로 중간정수. }
        }
        워프동기화().
        {
            정수 조 = 0 + lane.
            정수 행안 = (조 % 32) / 2.
            정수 출행 = 행0 + wm * 32 + 16 + 행안.
            정수 판자리 = wb + (조 / 32) * 128 + 행안 * 8 + (조 % 2) * 4.
            정수 전역 = (((조 / 32) * 행수 + 출행) * 열16 + 블록열 / 16 + 조 % 2) * 4.
            출행 < 행수이면 {
                짧은실수 w0 = 판[판자리 + 0].
                짧은실수 w1 = 판[판자리 + 1].
                짧은실수 w2 = 판[판자리 + 2].
                짧은실수 w3 = 판[판자리 + 3].
                다음넓[전역 + 0] = w0.
                다음넓[전역 + 1] = w1.
                다음넓[전역 + 2] = w2.
                다음넓[전역 + 3] = w3.
            }
        }
        {
            정수 조 = 32 + lane.
            정수 행안 = (조 % 32) / 2.
            정수 출행 = 행0 + wm * 32 + 16 + 행안.
            정수 판자리 = wb + (조 / 32) * 128 + 행안 * 8 + (조 % 2) * 4.
            정수 전역 = (((조 / 32) * 행수 + 출행) * 열16 + 블록열 / 16 + 조 % 2) * 4.
            출행 < 행수이면 {
                짧은실수 w0 = 판[판자리 + 0].
                짧은실수 w1 = 판[판자리 + 1].
                짧은실수 w2 = 판[판자리 + 2].
                짧은실수 w3 = 판[판자리 + 3].
                다음넓[전역 + 0] = w0.
                다음넓[전역 + 1] = w1.
                다음넓[전역 + 2] = w2.
                다음넓[전역 + 3] = w3.
            }
        }
        워프동기화().
    }
}

(* 정수 블록 계약의 행렬곱(Q4_0) — 64 × 128 칸, 워프 2 × 2. 커널생성.py 의 설명 *)
(* 실행한도 정수세판타일선형_KV정수 128 3 *)
[중간정수 참조 자릿값에서 중간정수 참조 정보와 중간정수 참조 가중치와 반실수 참조 척도와 짧은실수 참조 치우침과 중간정수 참조 자릿값q와 중간정수 참조 정보q와 중간정수 참조 키칸과 중간정수 참조 값칸과 부호없는 작은정수 참조 키지수와 부호없는 작은정수 참조 값지수에 정수 행수로 정수 깊이로 정수 열수로 정수 척도폭으로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 정수 행시작으로 정수 열시작으로 정수세판타일선형_KV정수]는 {
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    정수 g = lane / 4.
    정수 t = lane % 4.
    정수 wm = (tid / 32) / 2.
    정수 wn = (tid / 32) % 2.
    정수 행0 = 행시작 + 블록가로() * 64.
    정수 열0 = 열시작 + 블록세로() * 128.
    짧은실수 참조 판 = 공유판24().
    중간정수 참조 판i = 판 으로 중간정수 참조.
    반실수 참조 판h = 판 으로 반실수 참조.
    짧은실수 참조 자리넓 = 자릿값 으로 짧은실수 참조.
    짧은실수 참조 정보넓 = 정보 으로 짧은실수 참조.
    짧은실수 참조 가중넓 = 가중치 으로 짧은실수 참조.
    짧은실수 참조 척도넓 = 척도 으로 짧은실수 참조.
    정수 블록수 = 깊이 / 32.
    정수 깊이4 = 깊이 / 4.
    정수 정보폭 = (행수 + 63) / 64 * 64.
    정수 ac0 = tid + 0.
    정수 ar0 = (ac0 / 2) % 64.
    정수 rg0 = 행0 + ar0.
    rg0 >= 행수이면 { rg0 = 행수 - 1. }
    정수 a저장0 = (ac0 / 128) * 512 + ar0 * 8 + ((ac0 % 2) ^ ((ar0 >> 2) & 1)) * 4.
    정수 ga0 = ((ac0 / 128) * 행수 + rg0) * 깊이4 + (ac0 % 2) * 4.
    정수 ac1 = tid + 128.
    정수 ar1 = (ac1 / 2) % 64.
    정수 rg1 = 행0 + ar1.
    rg1 >= 행수이면 { rg1 = 행수 - 1. }
    정수 a저장1 = (ac1 / 128) * 512 + ar1 * 8 + ((ac1 % 2) ^ ((ar1 >> 2) & 1)) * 4.
    정수 ga1 = ((ac1 / 128) * 행수 + rg1) * 깊이4 + (ac1 % 2) * 4.
    정수 gi = 행0 + tid * 4.
    정수 gs = 블록세로() * 64 + tid * 4.
    정수 척도걸음 = 척도폭 / 2.
    정수 bc0 = tid + 0.
    정수 cg0 = 열0 + bc0.
    cg0 >= 열수이면 { cg0 = 열수 - 1. }
    정수 b저장0 = bc0 * 4.
    정수 gb0 = cg0 * 4.
    정수 열걸음 = 열수 * 4.
    정수 oa = 0 + (wm * 32 + ((lane >> 3) & 1) * 8 + (lane & 7)) * 8 + ((lane >> 4) ^ ((lane >> 2) & 1)) * 4.
    정수 oi = 1536 + wm * 32 + g.

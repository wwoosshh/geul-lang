        중간정수 s3_0_1_3 = 정수텐서곱(3, a0_1_0, a0_1_1, a0_1_2, a0_1_3, b0, b1, 영i, 영i, 영i, 영i).
        중간정수 T2_1_2 = s2_1_1_2 * 256 + s2_0_1_2.
        y1_2_2 = 곱해더하기(T2_1_2 으로 짧은실수, Pdn2_1_1_0, y1_2_2).

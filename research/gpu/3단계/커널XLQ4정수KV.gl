        v = y3_1_1 + 치1_1.
        출력[줄3_0 + 열1_1] = v.
    }
    (행3_1 < 행수 그리고 열1_0 < 열수)이면 {
        v = y3_1_2 + 치1_0.
        출력[줄3_1 + 열1_0] = v.
    }
    (행3_1 < 행수 그리고 열1_1 < 열수)이면 {
        v = y3_1_3 + 치1_1.
        출력[줄3_1 + 열1_1] = v.
    }
    (행3_0 < 행수 그리고 열2_0 < 열수)이면 {
        v = y3_2_0 + 치2_0.
        출력[줄3_0 + 열2_0] = v.
    }
    (행3_0 < 행수 그리고 열2_1 < 열수)이면 {
        v = y3_2_1 + 치2_1.
        출력[줄3_0 + 열2_1] = v.
    }
    (행3_1 < 행수 그리고 열2_0 < 열수)이면 {
        v = y3_2_2 + 치2_0.
        출력[줄3_1 + 열2_0] = v.
    }
    (행3_1 < 행수 그리고 열2_1 < 열수)이면 {
        v = y3_2_3 + 치2_1.
        출력[줄3_1 + 열2_1] = v.
    }
    (행3_0 < 행수 그리고 열3_0 < 열수)이면 {
        v = y3_3_0 + 치3_0.
        출력[줄3_0 + 열3_0] = v.
    }
    (행3_0 < 행수 그리고 열3_1 < 열수)이면 {
        v = y3_3_1 + 치3_1.
        출력[줄3_0 + 열3_1] = v.
    }
    (행3_1 < 행수 그리고 열3_0 < 열수)이면 {
        v = y3_3_2 + 치3_0.
        출력[줄3_1 + 열3_0] = v.
    }
    (행3_1 < 행수 그리고 열3_1 < 열수)이면 {
        v = y3_3_3 + 치3_1.
        출력[줄3_1 + 열3_1] = v.
    }
}

(* 정수 블록 계약의 행렬곱(Q8_0) — 128 × 64 칸, 워프 2 × 2. 커널생성.py 의 설명 *)
(* 실행한도 로짓정수깊은넓은타일선형 128 3 *)
[중간정수 참조 자릿값에서 중간정수 참조 정보와 중간정수 참조 가중치와 반실수 참조 척도와 짧은실수 참조 치우침과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 척도폭으로 정수 행시작으로 정수 열시작으로 로짓정수깊은넓은타일선형]는 {
    정수 tid = 블록안가로().
    정수 lane = tid % 32.
    정수 g = lane / 4.
    정수 t = lane % 4.
    정수 wm = (tid / 32) / 2.
    정수 wn = (tid / 32) % 2.
    정수 행0 = 행시작 + 블록가로() * 128.
    정수 열0 = 열시작 + 블록세로() * 64.
    짧은실수 참조 판 = 공유판36().
    중간정수 참조 판i = 판 으로 중간정수 참조.
    반실수 참조 판h = 판 으로 반실수 참조.
    짧은실수 참조 자리넓 = 자릿값 으로 짧은실수 참조.
    짧은실수 참조 정보넓 = 정보 으로 짧은실수 참조.
    짧은실수 참조 가중넓 = 가중치 으로 짧은실수 참조.
    짧은실수 참조 척도넓 = 척도 으로 짧은실수 참조.
    정수 블록수 = 깊이 / 32.
    정수 깊이4 = 깊이 / 4.
    정수 정보폭 = (행수 + 63) / 64 * 64.
    정수 ac0 = tid + 0.
    정수 ar0 = (ac0 / 2) % 128.
    정수 rg0 = 행0 + ar0.
    rg0 >= 행수이면 { rg0 = 행수 - 1. }
    정수 a저장0 = (ac0 / 256) * 1024 + ar0 * 8 + ((ac0 % 2) ^ ((ar0 >> 2) & 1)) * 4.
    정수 ga0 = ((ac0 / 256) * 행수 + rg0) * 깊이4 + (ac0 % 2) * 4.
    정수 ac1 = tid + 128.
    정수 ar1 = (ac1 / 2) % 128.
    정수 rg1 = 행0 + ar1.
    rg1 >= 행수이면 { rg1 = 행수 - 1. }
    정수 a저장1 = (ac1 / 256) * 1024 + ar1 * 8 + ((ac1 % 2) ^ ((ar1 >> 2) & 1)) * 4.
    정수 ga1 = ((ac1 / 256) * 행수 + rg1) * 깊이4 + (ac1 % 2) * 4.
    정수 ac2 = tid + 256.
    정수 ar2 = (ac2 / 2) % 128.
    정수 rg2 = 행0 + ar2.
    rg2 >= 행수이면 { rg2 = 행수 - 1. }
    정수 a저장2 = (ac2 / 256) * 1024 + ar2 * 8 + ((ac2 % 2) ^ ((ar2 >> 2) & 1)) * 4.
    정수 ga2 = ((ac2 / 256) * 행수 + rg2) * 깊이4 + (ac2 % 2) * 4.
    정수 ac3 = tid + 384.
    정수 ar3 = (ac3 / 2) % 128.
    정수 rg3 = 행0 + ar3.
    rg3 >= 행수이면 { rg3 = 행수 - 1. }
    정수 a저장3 = (ac3 / 256) * 1024 + ar3 * 8 + ((ac3 % 2) ^ ((ar3 >> 2) & 1)) * 4.
    정수 ga3 = ((ac3 / 256) * 행수 + rg3) * 깊이4 + (ac3 % 2) * 4.
    정수 gi = 행0 + tid * 4.
    정수 gs = 블록세로() * 32 + tid * 4.
    정수 척도걸음 = 척도폭 / 2.
    정수 bc0 = (tid + 0) / 2.
    정수 bh0 = tid % 2.
    정수 cg0 = 열0 + bc0.
    cg0 >= 열수이면 { cg0 = 열수 - 1. }
    정수 b저장0 = bc0 * 8 + ((bh0 ^ ((bc0 >> 2) & 1)) * 4).
    정수 gb0 = cg0 * 8 + bh0 * 4.
    정수 열걸음 = 열수 * 8.
    정수 oa = 0 + (wm * 64 + ((lane >> 3) & 1) * 8 + (lane & 7)) * 8 + ((lane >> 4) ^ ((lane >> 2) & 1)) * 4.
    정수 oi = 2560 + wm * 64 + g.
    정수 os = 2688 + wn * 32 + t * 2.
    정수 gsc = 열0 + tid.
    반실수 sc0 = (0 으로 짧은실수) 으로 반실수.
    (tid < 64 그리고 gsc < 척도폭)이면 { sc0 = 척도[gsc + 0]. }
    정수 sw = (g >> 2) & 1.
    정수 ob0 = 2048 + (wn * 32 + g) * 8 + (((t >> 1) + (t & 1) * 4) ^ (sw * 4)).
    정수 ob1 = ob0 + 2.
    {
        정수 올바탕 = (0) * 2752.
        정수 k8 = (0) * 8.
        비동기복사16(판 에, 올바탕 + 0 + a저장0 를, 자리넓 에서, ga0 + k8 로).
        비동기복사16(판 에, 올바탕 + 0 + a저장1 를, 자리넓 에서, ga1 + k8 로).
        비동기복사16(판 에, 올바탕 + 0 + a저장2 를, 자리넓 에서, ga2 + k8 로).
        비동기복사16(판 에, 올바탕 + 0 + a저장3 를, 자리넓 에서, ga3 + k8 로).
        tid < 32이면 { 비동기복사16(판 에, 올바탕 + 2560 + tid * 4 를, 정보넓 에서, gi + (0) * 정보폭 로). }
        비동기복사16(판 에, 올바탕 + 2048 + b저장0 를, 가중넓 에서, gb0 + (0) * 열걸음 로).
        (tid < 64 그리고 gsc < 척도폭)이면 {
            판[올바탕 + 2688 + tid + 0] = sc0.
            (0) + 1 < 블록수이면 { sc0 = 척도[((0) + 1) * 척도폭 + gsc + 0]. }
        }
    }
    비동기묶기().
    1 < 블록수이면 {
        정수 올바탕 = (1) * 2752.
        정수 k8 = (1) * 8.
        비동기복사16(판 에, 올바탕 + 0 + a저장0 를, 자리넓 에서, ga0 + k8 로).
        비동기복사16(판 에, 올바탕 + 0 + a저장1 를, 자리넓 에서, ga1 + k8 로).
        비동기복사16(판 에, 올바탕 + 0 + a저장2 를, 자리넓 에서, ga2 + k8 로).
        비동기복사16(판 에, 올바탕 + 0 + a저장3 를, 자리넓 에서, ga3 + k8 로).
        tid < 32이면 { 비동기복사16(판 에, 올바탕 + 2560 + tid * 4 를, 정보넓 에서, gi + (1) * 정보폭 로). }
        비동기복사16(판 에, 올바탕 + 2048 + b저장0 를, 가중넓 에서, gb0 + (1) * 열걸음 로).
        (tid < 64 그리고 gsc < 척도폭)이면 {
            판[올바탕 + 2688 + tid + 0] = sc0.
            (1) + 1 < 블록수이면 { sc0 = 척도[((1) + 1) * 척도폭 + gsc + 0]. }
        }
    }
    비동기묶기().
    정수 pa0 = ga0 + 16.
    정수 pa1 = ga1 + 16.
    정수 pa2 = ga2 + 16.
    정수 pa3 = ga3 + 16.
    정수 pi = gi + 2 * 정보폭.
    정수 pb0 = gb0 + 2 * 열걸음.
    정수 psc = 3 * 척도폭 + gsc.
    중간정수 영i = 0.
    짧은실수 영 = 0 으로 짧은실수.
    짧은실수 y0_0_0 = 영.
    짧은실수 y0_0_1 = 영.

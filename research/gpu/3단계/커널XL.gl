        a3_2 = 곱해더하기(x3, w2, a3_2).
        a3_3 = 곱해더하기(x3, w3, a3_3).
        정수 aq7 = A바탕 + ty4x7.
        x0 = 판[aq7 + 896].
        x1 = 판[aq7 + 897].
        x2 = 판[aq7 + 898].

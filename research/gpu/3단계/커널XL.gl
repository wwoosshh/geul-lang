        a0 = 곱해더하기(입력[x바탕0 + k + 160], w40, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 164], w41, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 168], w42, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 172], w43, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 176], w44, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 180], w45, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 184], w46, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 188], w47, a0).
    }
    반복 (: k < 깊이: k += 4) {
        w0 = 가중치[k * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k], w0, a0).
    }
    짧은실수 참조 판 = 공유판4().
    가닥 >= 2이면 {
        판[((가닥 - 2) * 1 + 0) * 32 + tx] = a0.
    }
    동기화().
    가닥 < 2이면 {
        a0 = a0 + 판[(가닥 * 1 + 0) * 32 + tx].
    }
    동기화().
    가닥 == 1이면 {
        판[0 + tx] = a0.
    }
    동기화().
    (가닥 == 0 그리고 열 < 열수)이면 {
        짧은실수 v = 영.
        짧은실수 u = 영.
        짧은실수 th = 영.
        정수 자리 = 0.
        정수 자리위 = 0.
        0 < 행수이면 {
            v = (a0 + 판[0 + tx]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 0. }
            아니면 { 자리 = (0 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 0 % 묶음안행수. }
            열 < 1600이면 { 출력[0 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }
    }
    (* 다음 커널의 가중치를 L2 로 미리 — 128 바이트 줄마다 한 번, 모든 스레드가 나눠서 *)
    반복 (정수 미 = 실행번호() * 32: 미 < 다음수: 미 += 실행개수() * 32) { 미리읽기(다음, 미). }
}

(* 프롬프트 처리의 어텐션 — 블록 하나가 (머리, 질의 64 개). 키 조각마다 점수·최댓값·지수·합·가중합·접기. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 흐름어텐션 256 2 *)
[짧은실수 참조 q에서 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 흐름어텐션]는 {
    정수 tid = 블록안가로().
    정수 머리 = 블록가로().
    정수 질조각수 = (묶음안행수 + 63) / 64.
    정수 문장 = 블록세로() / 질조각수.
    정수 r0 = (질조각수 - 1 - 블록세로() % 질조각수) * 64.
    정수 끝r = r0 + 63.
    끝r >= 묶음안행수이면 { 끝r = 묶음안행수 - 1. }
    정수 p0 = 위치시작 + r0.
    정수 끝조각 = (위치시작 + 끝r) / 64.
    정수 행바탕 = 문장 * 묶음안행수.
    정수 캐시 = (문장 * 25 + 머리) * 64 * 최대길이.
    짧은실수 참조 판 = 공유판48().
    정수 tq = tid / 16.
    정수 tt = tid % 16.
    정수 우두 = tid % 32 - tt.
    정수 qx = tq * 4.
    정수 kx = tt * 4.
    (* Qᵀ: 스레드가 질의 행 tid % 64 의 d 칸 넷(16 바이트) 넷을 읽어 [d][q] 에 *)
    정수 qr = r0 + tid % 64.
    qr > 끝r이면 { qr = 끝r. }
    정수 qsrc = (행바탕 + qr) * 1600 + 머리 * 64.
    정수 qc = (tid / 64) * 4.
    정수 qdst = qc * 64 + tid % 64.
    짧은실수 qv0_0 = q[qsrc + qc + 0].
    짧은실수 qv0_1 = q[qsrc + qc + 1].
    짧은실수 qv0_2 = q[qsrc + qc + 2].
    짧은실수 qv0_3 = q[qsrc + qc + 3].
    판[qdst + 0] = qv0_0.
    판[qdst + 64] = qv0_1.
    판[qdst + 128] = qv0_2.
    판[qdst + 192] = qv0_3.
    짧은실수 qv1_0 = q[qsrc + qc + 16].
    짧은실수 qv1_1 = q[qsrc + qc + 17].
    짧은실수 qv1_2 = q[qsrc + qc + 18].
    짧은실수 qv1_3 = q[qsrc + qc + 19].
    판[qdst + 1024] = qv1_0.
    판[qdst + 1088] = qv1_1.
    판[qdst + 1152] = qv1_2.
    판[qdst + 1216] = qv1_3.
    짧은실수 qv2_0 = q[qsrc + qc + 32].
    짧은실수 qv2_1 = q[qsrc + qc + 33].
    짧은실수 qv2_2 = q[qsrc + qc + 34].
    짧은실수 qv2_3 = q[qsrc + qc + 35].
    판[qdst + 2048] = qv2_0.
    판[qdst + 2112] = qv2_1.
    판[qdst + 2176] = qv2_2.
    판[qdst + 2240] = qv2_3.
    짧은실수 qv3_0 = q[qsrc + qc + 48].
    짧은실수 qv3_1 = q[qsrc + qc + 49].
    짧은실수 qv3_2 = q[qsrc + qc + 50].
    짧은실수 qv3_3 = q[qsrc + qc + 51].
    판[qdst + 3072] = qv3_0.
    판[qdst + 3136] = qv3_1.
    판[qdst + 3200] = qv3_2.
    판[qdst + 3264] = qv3_3.
    정수 pq0 = p0 + qx + 0.
    정수 pq1 = p0 + qx + 1.
    정수 pq2 = p0 + qx + 2.
    정수 pq3 = p0 + qx + 3.
    정수 ex0 = (qx + 0) % 8.
    정수 ex1 = (qx + 1) % 8.
    정수 ex2 = (qx + 2) % 8.
    정수 ex3 = (qx + 3) % 8.
    정수 eb0 = 4096 + (qx + 0) * 64.
    정수 eb1 = 4096 + (qx + 1) * 64.
    정수 eb2 = 4096 + (qx + 2) * 64.
    정수 eb3 = 4096 + (qx + 3) * 64.
    정수 vq = 8192 + kx.
    짧은실수 영 = 0 으로 짧은실수.
    짧은실수 M = 영.
    짧은실수 L = 영.
    짧은실수 옛비 = 영.
    짧은실수 새비 = 영.
    정수 방식 = 0.
    짧은실수 O0_0 = 영.
    짧은실수 O0_1 = 영.
    짧은실수 O0_2 = 영.
    짧은실수 O0_3 = 영.
    짧은실수 O1_0 = 영.
    짧은실수 O1_1 = 영.
    짧은실수 O1_2 = 영.
    짧은실수 O1_3 = 영.
    짧은실수 O2_0 = 영.
    짧은실수 O2_1 = 영.
    짧은실수 O2_2 = 영.
    짧은실수 O2_3 = 영.
    짧은실수 O3_0 = 영.
    짧은실수 O3_1 = 영.
    짧은실수 O3_2 = 영.
    짧은실수 O3_3 = 영.
    반복 (정수 조각 = 0: 조각 <= 끝조각: 조각 += 1) {
        정수 tb = 조각 * 64.
        비동기복사16(판 에, 4096 + (tq + 0) * 64 + kx 를, 키칸 에서, 캐시 + (tq + 0) * 최대길이 + tb + kx 로).
        비동기복사16(판 에, 8192 + (tq + 0) * 64 + kx 를, 값칸 에서, 캐시 + (tb + tq + 0) * 64 + kx 로).
        비동기복사16(판 에, 4096 + (tq + 16) * 64 + kx 를, 키칸 에서, 캐시 + (tq + 16) * 최대길이 + tb + kx 로).
        비동기복사16(판 에, 8192 + (tq + 16) * 64 + kx 를, 값칸 에서, 캐시 + (tb + tq + 16) * 64 + kx 로).
        비동기복사16(판 에, 4096 + (tq + 32) * 64 + kx 를, 키칸 에서, 캐시 + (tq + 32) * 최대길이 + tb + kx 로).
        비동기복사16(판 에, 8192 + (tq + 32) * 64 + kx 를, 값칸 에서, 캐시 + (tb + tq + 32) * 64 + kx 로).
        비동기복사16(판 에, 4096 + (tq + 48) * 64 + kx 를, 키칸 에서, 캐시 + (tq + 48) * 최대길이 + tb + kx 로).
        비동기복사16(판 에, 8192 + (tq + 48) * 64 + kx 를, 값칸 에서, 캐시 + (tb + tq + 48) * 64 + kx 로).
        비동기묶기().
        비동기기다리기(0).
        동기화().
        짧은실수 s0_0 = 영.
        짧은실수 s0_1 = 영.
        짧은실수 s0_2 = 영.
        짧은실수 s0_3 = 영.
        짧은실수 s1_0 = 영.
        짧은실수 s1_1 = 영.
        짧은실수 s1_2 = 영.
        짧은실수 s1_3 = 영.
        짧은실수 s2_0 = 영.
        짧은실수 s2_1 = 영.
        짧은실수 s2_2 = 영.
        짧은실수 s2_3 = 영.
        짧은실수 s3_0 = 영.
        짧은실수 s3_1 = 영.
        짧은실수 s3_2 = 영.
        짧은실수 s3_3 = 영.
        반복 (정수 d0 = 0: d0 < 64: d0 += 4) {
            정수 qo = qx + d0 * 64.
            정수 ko = kx + d0 * 64.
            짧은실수 a0_0 = 판[qo + 0].
            짧은실수 a0_1 = 판[qo + 1].
            짧은실수 a0_2 = 판[qo + 2].
            짧은실수 a0_3 = 판[qo + 3].
            짧은실수 b0_0 = 판[ko + 4096].
            짧은실수 b0_1 = 판[ko + 4097].
            짧은실수 b0_2 = 판[ko + 4098].
            짧은실수 b0_3 = 판[ko + 4099].
            s0_0 = 곱해더하기(a0_0, b0_0, s0_0).
            s0_1 = 곱해더하기(a0_0, b0_1, s0_1).
            s0_2 = 곱해더하기(a0_0, b0_2, s0_2).
            s0_3 = 곱해더하기(a0_0, b0_3, s0_3).
            s1_0 = 곱해더하기(a0_1, b0_0, s1_0).
            s1_1 = 곱해더하기(a0_1, b0_1, s1_1).
            s1_2 = 곱해더하기(a0_1, b0_2, s1_2).
            s1_3 = 곱해더하기(a0_1, b0_3, s1_3).
            s2_0 = 곱해더하기(a0_2, b0_0, s2_0).
            s2_1 = 곱해더하기(a0_2, b0_1, s2_1).
            s2_2 = 곱해더하기(a0_2, b0_2, s2_2).
            s2_3 = 곱해더하기(a0_2, b0_3, s2_3).
            s3_0 = 곱해더하기(a0_3, b0_0, s3_0).
            s3_1 = 곱해더하기(a0_3, b0_1, s3_1).
            s3_2 = 곱해더하기(a0_3, b0_2, s3_2).
            s3_3 = 곱해더하기(a0_3, b0_3, s3_3).
            짧은실수 a1_0 = 판[qo + 64].
            짧은실수 a1_1 = 판[qo + 65].
            짧은실수 a1_2 = 판[qo + 66].
            짧은실수 a1_3 = 판[qo + 67].
            짧은실수 b1_0 = 판[ko + 4160].
            짧은실수 b1_1 = 판[ko + 4161].
            짧은실수 b1_2 = 판[ko + 4162].
            짧은실수 b1_3 = 판[ko + 4163].
            s0_0 = 곱해더하기(a1_0, b1_0, s0_0).
            s0_1 = 곱해더하기(a1_0, b1_1, s0_1).
            s0_2 = 곱해더하기(a1_0, b1_2, s0_2).
            s0_3 = 곱해더하기(a1_0, b1_3, s0_3).
            s1_0 = 곱해더하기(a1_1, b1_0, s1_0).
            s1_1 = 곱해더하기(a1_1, b1_1, s1_1).
            s1_2 = 곱해더하기(a1_1, b1_2, s1_2).
            s1_3 = 곱해더하기(a1_1, b1_3, s1_3).
            s2_0 = 곱해더하기(a1_2, b1_0, s2_0).
            s2_1 = 곱해더하기(a1_2, b1_1, s2_1).
            s2_2 = 곱해더하기(a1_2, b1_2, s2_2).
            s2_3 = 곱해더하기(a1_2, b1_3, s2_3).
            s3_0 = 곱해더하기(a1_3, b1_0, s3_0).
            s3_1 = 곱해더하기(a1_3, b1_1, s3_1).
            s3_2 = 곱해더하기(a1_3, b1_2, s3_2).
            s3_3 = 곱해더하기(a1_3, b1_3, s3_3).
            짧은실수 a2_0 = 판[qo + 128].
            짧은실수 a2_1 = 판[qo + 129].
            짧은실수 a2_2 = 판[qo + 130].
            짧은실수 a2_3 = 판[qo + 131].
            짧은실수 b2_0 = 판[ko + 4224].
            짧은실수 b2_1 = 판[ko + 4225].
            짧은실수 b2_2 = 판[ko + 4226].
            짧은실수 b2_3 = 판[ko + 4227].
            s0_0 = 곱해더하기(a2_0, b2_0, s0_0).
            s0_1 = 곱해더하기(a2_0, b2_1, s0_1).
            s0_2 = 곱해더하기(a2_0, b2_2, s0_2).
            s0_3 = 곱해더하기(a2_0, b2_3, s0_3).
            s1_0 = 곱해더하기(a2_1, b2_0, s1_0).
            s1_1 = 곱해더하기(a2_1, b2_1, s1_1).
            s1_2 = 곱해더하기(a2_1, b2_2, s1_2).
            s1_3 = 곱해더하기(a2_1, b2_3, s1_3).
            s2_0 = 곱해더하기(a2_2, b2_0, s2_0).
            s2_1 = 곱해더하기(a2_2, b2_1, s2_1).
            s2_2 = 곱해더하기(a2_2, b2_2, s2_2).
            s2_3 = 곱해더하기(a2_2, b2_3, s2_3).
            s3_0 = 곱해더하기(a2_3, b2_0, s3_0).
            s3_1 = 곱해더하기(a2_3, b2_1, s3_1).
            s3_2 = 곱해더하기(a2_3, b2_2, s3_2).
            s3_3 = 곱해더하기(a2_3, b2_3, s3_3).
            짧은실수 a3_0 = 판[qo + 192].
            짧은실수 a3_1 = 판[qo + 193].
            짧은실수 a3_2 = 판[qo + 194].
            짧은실수 a3_3 = 판[qo + 195].
            짧은실수 b3_0 = 판[ko + 4288].
            짧은실수 b3_1 = 판[ko + 4289].
            짧은실수 b3_2 = 판[ko + 4290].
            짧은실수 b3_3 = 판[ko + 4291].
            s0_0 = 곱해더하기(a3_0, b3_0, s0_0).
            s0_1 = 곱해더하기(a3_0, b3_1, s0_1).
            s0_2 = 곱해더하기(a3_0, b3_2, s0_2).
            s0_3 = 곱해더하기(a3_0, b3_3, s0_3).
            s1_0 = 곱해더하기(a3_1, b3_0, s1_0).
            s1_1 = 곱해더하기(a3_1, b3_1, s1_1).
            s1_2 = 곱해더하기(a3_1, b3_2, s1_2).
            s1_3 = 곱해더하기(a3_1, b3_3, s1_3).
            s2_0 = 곱해더하기(a3_2, b3_0, s2_0).
            s2_1 = 곱해더하기(a3_2, b3_1, s2_1).
            s2_2 = 곱해더하기(a3_2, b3_2, s2_2).
            s2_3 = 곱해더하기(a3_2, b3_3, s2_3).
            s3_0 = 곱해더하기(a3_3, b3_0, s3_0).
            s3_1 = 곱해더하기(a3_3, b3_1, s3_1).
            s3_2 = 곱해더하기(a3_3, b3_2, s3_2).
            s3_3 = 곱해더하기(a3_3, b3_3, s3_3).
        }
        s0_0 = s0_0 * 0.125.
        s0_1 = s0_1 * 0.125.
        s0_2 = s0_2 * 0.125.
        s0_3 = s0_3 * 0.125.

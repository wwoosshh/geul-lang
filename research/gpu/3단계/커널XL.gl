        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + tx * 4 + 2] = a7_2.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + tx * 4 + 3] = a7_3.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 0] = a7_4.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 1] = a7_5.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 2] = a7_6.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 3] = a7_7.
    }
    동기화().
    정수 행 = 0.
    정수 열 = 0.
    정수 자리 = 0.
    정수 자리위 = 0.
    정수 칸 = 0.
    짧은실수 v = 영.
    짧은실수 u = 영.
    짧은실수 th = 영.
    정수 rr = 0.
    정수 cc = 0.
    반복 (정수 m는 0부터 16 전까지) {
        칸 = m * 256 + tid.
        rr = 칸 / 64.
        cc = 칸 % 64.
        행 = 행0 + rr.
        열 = 열0 + cc.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[rr * 68 + cc] + 판[4352 + rr * 68 + cc]) + 치우침[열].
            u = 0.7978845608 * (v + 0.044715 * v * v * v).
            th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
            출력[행 * 열수 + 열] = 0.5 * v * (1.0 + th).
        }
    }
}

(* 32 × 32 칸을 블록 하나가 — 가닥 g 의 스레드 64 개가 k ≡ g (mod 4) 를 맡고, 스레드 하나가 4 × 4 칸 *)
(* 실행한도 작은타일선형_겔루 256 4 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 작은타일선형_겔루]는 {
    정수 tid = 블록안가로().
    정수 가닥 = tid / 64.
    정수 t64 = tid % 64.
    정수 ty = t64 / 8.
    정수 tx = t64 % 8.

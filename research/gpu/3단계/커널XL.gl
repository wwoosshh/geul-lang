        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + tx * 4 + 3] = a7_3.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 0] = a7_4.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 1] = a7_5.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 2] = a7_6.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 3] = a7_7.
    }
    동기화().
    정수 행 = 0.
    정수 열 = 0.
    정수 자리 = 0.
    정수 자리위 = 0.
    정수 칸 = 0.
    짧은실수 v = 영.
    짧은실수 u = 영.
    짧은실수 th = 영.
    정수 rr = 0.
    정수 cc = 0.
    정수 키타일 = 0.
    (열0 >= 1600 그리고 열0 < 3200)이면 { 키타일 = 1. }
    반복 (정수 m는 0부터 16 전까지) {
        칸 = m * 256 + tid.
        키타일 == 1이면 { rr = 칸 % 64. cc = 칸 / 64. }
        아니면 { rr = 칸 / 64. cc = 칸 % 64. }
        행 = 행0 + rr.
        열 = 열0 + cc.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[rr * 68 + cc] + 판[4352 + rr * 68 + cc]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 행. }
            아니면 { 자리 = (행 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 행 % 묶음안행수. }
            열 < 1600이면 { 출력[행 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }
    }
}

(* 32 × 32 칸을 블록 하나가 — 가닥 g 의 스레드 64 개가 k ≡ g (mod 4) 를 맡고, 스레드 하나가 4 × 4 칸 *)
(* 실행한도 작은타일선형_KV 256 4 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 작은타일선형_KV]는 {
    정수 tid = 블록안가로().
    정수 가닥 = tid / 64.
    정수 t64 = tid % 64.
    정수 ty = t64 / 8.
    정수 tx = t64 % 8.
    정수 행0 = 블록가로() * 32.
    정수 열0 = 블록세로() * 32.
    짧은실수 참조 판 = 공유판24().
    정수 a행 = 행0 + tid / 8.
    a행 >= 행수이면 { a행 = 행수 - 1. }
    정수 ak = (tid % 8) * 4.
    정수 a저장 = ak * 32 + ((tid / 8) ^ ((tid % 8) * 4)).
    정수 a원 = a행 * 깊이 + ak.
    정수 열32 = 열수 * 32.
    정수 b저장 = (tid / 8) * 32 + (tid % 8) * 4.
    정수 b원 = (tid / 8) * 열수 + 열0 + (tid % 8) * 4.
    정수 타일수 = 깊이 / 32.
    정수 올판 = 0.
    정수 깊이4 = 깊이 / 4 * 4.
    정수 ra원 = a행 * 깊이4 + ak.
    짧은실수 ra0 = 입력[ra원 + 0].
    짧은실수 ra1 = 입력[ra원 + 1].
    짧은실수 ra2 = 입력[ra원 + 2].
    짧은실수 ra3 = 입력[ra원 + 3].
    판[0 + a저장 + 0] = ra0.
    판[0 + a저장 + 32] = ra1.
    판[0 + a저장 + 64] = ra2.
    판[0 + a저장 + 96] = ra3.
    올판 = 0.
    비동기복사16(판 에, 3072 + 올판 * 1024 + b저장 를, 가중치 에서, b원 로).
    비동기묶기().
    타일수 > 1이면 {
        b원 = b원 + 열32.
        올판 = 1.
        비동기복사16(판 에, 3072 + 올판 * 1024 + b저장 를, 가중치 에서, b원 로).
        ra원 = ra원 + 32.
        ra0 = 입력[ra원 + 0].
        ra1 = 입력[ra원 + 1].
        ra2 = 입력[ra원 + 2].
        ra3 = 입력[ra원 + 3].
    }
    비동기묶기().
    짧은실수 영 = 0 으로 짧은실수.
    짧은실수 a0_0 = 영.
    짧은실수 a0_1 = 영.
    짧은실수 a0_2 = 영.

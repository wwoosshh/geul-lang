            }
        }
        방식0 == 1이면 {
            O0_0 = o0_0.
            O0_1 = o0_1.
            O0_2 = o0_2.
            O0_3 = o0_3.
        }
        아니면 방식0 == 2이면 {
            O0_0 = 곱해더하기(o0_0, 새비0, O0_0 * 옛비0).
            O0_1 = 곱해더하기(o0_1, 새비0, O0_1 * 옛비0).
            O0_2 = 곱해더하기(o0_2, 새비0, O0_2 * 옛비0).
            O0_3 = 곱해더하기(o0_3, 새비0, O0_3 * 옛비0).
        }
        방식1 == 1이면 {
            O1_0 = o1_0.
            O1_1 = o1_1.
            O1_2 = o1_2.
            O1_3 = o1_3.
        }
        아니면 방식1 == 2이면 {
            O1_0 = 곱해더하기(o1_0, 새비1, O1_0 * 옛비1).
            O1_1 = 곱해더하기(o1_1, 새비1, O1_1 * 옛비1).
            O1_2 = 곱해더하기(o1_2, 새비1, O1_2 * 옛비1).
            O1_3 = 곱해더하기(o1_3, 새비1, O1_3 * 옛비1).
        }
        방식2 == 1이면 {
            O2_0 = o2_0.
            O2_1 = o2_1.
            O2_2 = o2_2.
            O2_3 = o2_3.
        }
        아니면 방식2 == 2이면 {
            O2_0 = 곱해더하기(o2_0, 새비2, O2_0 * 옛비2).
            O2_1 = 곱해더하기(o2_1, 새비2, O2_1 * 옛비2).
            O2_2 = 곱해더하기(o2_2, 새비2, O2_2 * 옛비2).
            O2_3 = 곱해더하기(o2_3, 새비2, O2_3 * 옛비2).
        }
        방식3 == 1이면 {
            O3_0 = o3_0.
            O3_1 = o3_1.
            O3_2 = o3_2.
            O3_3 = o3_3.
        }
        아니면 방식3 == 2이면 {
            O3_0 = 곱해더하기(o3_0, 새비3, O3_0 * 옛비3).
            O3_1 = 곱해더하기(o3_1, 새비3, O3_1 * 옛비3).
            O3_2 = 곱해더하기(o3_2, 새비3, O3_2 * 옛비3).
            O3_3 = 곱해더하기(o3_3, 새비3, O3_3 * 옛비3).
        }
        동기화().
    }
    짧은실수 L0 = 레인에서받기(L, 우두 + 0).
    짧은실수 L1 = 레인에서받기(L, 우두 + 1).
    짧은실수 L2 = 레인에서받기(L, 우두 + 2).
    짧은실수 L3 = 레인에서받기(L, 우두 + 3).
    r0 + qx + 0 <= 끝r이면 {
        출력[(행바탕 + r0 + qx + 0) * 1600 + 머리 * 64 + kx + 0] = O0_0 / L0.
        출력[(행바탕 + r0 + qx + 0) * 1600 + 머리 * 64 + kx + 1] = O0_1 / L0.
        출력[(행바탕 + r0 + qx + 0) * 1600 + 머리 * 64 + kx + 2] = O0_2 / L0.
        출력[(행바탕 + r0 + qx + 0) * 1600 + 머리 * 64 + kx + 3] = O0_3 / L0.
    }
    r0 + qx + 1 <= 끝r이면 {
        출력[(행바탕 + r0 + qx + 1) * 1600 + 머리 * 64 + kx + 0] = O1_0 / L1.
        출력[(행바탕 + r0 + qx + 1) * 1600 + 머리 * 64 + kx + 1] = O1_1 / L1.
        출력[(행바탕 + r0 + qx + 1) * 1600 + 머리 * 64 + kx + 2] = O1_2 / L1.
        출력[(행바탕 + r0 + qx + 1) * 1600 + 머리 * 64 + kx + 3] = O1_3 / L1.
    }
    r0 + qx + 2 <= 끝r이면 {
        출력[(행바탕 + r0 + qx + 2) * 1600 + 머리 * 64 + kx + 0] = O2_0 / L2.
        출력[(행바탕 + r0 + qx + 2) * 1600 + 머리 * 64 + kx + 1] = O2_1 / L2.
        출력[(행바탕 + r0 + qx + 2) * 1600 + 머리 * 64 + kx + 2] = O2_2 / L2.
        출력[(행바탕 + r0 + qx + 2) * 1600 + 머리 * 64 + kx + 3] = O2_3 / L2.
    }
    r0 + qx + 3 <= 끝r이면 {
        출력[(행바탕 + r0 + qx + 3) * 1600 + 머리 * 64 + kx + 0] = O3_0 / L3.
        출력[(행바탕 + r0 + qx + 3) * 1600 + 머리 * 64 + kx + 1] = O3_1 / L3.
        출력[(행바탕 + r0 + qx + 3) * 1600 + 머리 * 64 + kx + 2] = O3_2 / L3.
        출력[(행바탕 + r0 + qx + 3) * 1600 + 머리 * 64 + kx + 3] = O3_3 / L3.
    }
}

(* 생성의 어텐션 (가) — 블록 하나가 (행, 머리)의 키 조각 넷. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 조각어텐션 256 2 *)
[짧은실수 참조 q에서 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 조각칸에 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 조각어텐션]는 {
    정수 tid = 블록안가로().
    정수 행 = 블록세로() / 25.
    정수 머리 = 블록세로() % 25.
    정수 g = tid / 64.
    정수 j = tid % 64.
    정수 조각 = 블록가로() * 4 + g.
    정수 위치 = 위치시작 + 행 % 묶음안행수.

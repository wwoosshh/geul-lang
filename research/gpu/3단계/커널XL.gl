        a1 = 곱해더하기(입력[x바탕1 + k + 12], w3, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 12], w3, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 12], w3, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 16], w4, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 16], w4, a1).

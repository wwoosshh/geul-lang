    정수 rr = 0.
    정수 cc = 0.
    반복 (정수 m는 0부터 16 전까지) {
        칸 = m * 256 + tid.
        rr = 칸 / 64.
        cc = 칸 % 64.
        행 = 행0 + rr.
        열 = 열0 + cc.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[rr * 68 + cc] + 판[4352 + rr * 68 + cc]) + 치우침[열].
            출력[행 * 열수 + 열] = v.
        }
    }
}

(* 32 × 32 칸을 블록 하나가 — 가닥 g 의 스레드 64 개가 k ≡ g (mod 4) 를 맡고, 스레드 하나가 4 × 4 칸 *)
(* 실행한도 작은타일선형 256 4 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 작은타일선형]는 {
    정수 tid = 블록안가로().
    정수 가닥 = tid / 64.
    정수 t64 = tid % 64.
    정수 ty = t64 / 8.
    정수 tx = t64 % 8.
    정수 행0 = 블록가로() * 32.
    정수 열0 = 블록세로() * 32.
    짧은실수 참조 판 = 공유판24().
    정수 a행 = 행0 + tid / 8.
    a행 >= 행수이면 { a행 = 행수 - 1. }
    정수 ak = (tid % 8) * 4.
    정수 a저장 = ak * 32 + ((tid / 8) ^ ((tid % 8) * 4)).
    정수 a원 = a행 * 깊이 + ak.
    정수 열32 = 열수 * 32.
    정수 b저장 = (tid / 8) * 32 + (tid % 8) * 4.
    정수 b원 = (tid / 8) * 열수 + 열0 + (tid % 8) * 4.
    정수 타일수 = 깊이 / 32.
    정수 올판 = 0.
    정수 깊이4 = 깊이 / 4 * 4.
    정수 ra원 = a행 * 깊이4 + ak.
    짧은실수 ra0 = 입력[ra원 + 0].
    짧은실수 ra1 = 입력[ra원 + 1].
    짧은실수 ra2 = 입력[ra원 + 2].
    짧은실수 ra3 = 입력[ra원 + 3].
    판[0 + a저장 + 0] = ra0.
    판[0 + a저장 + 32] = ra1.
    판[0 + a저장 + 64] = ra2.
    판[0 + a저장 + 96] = ra3.
    올판 = 0.
    비동기복사16(판 에, 3072 + 올판 * 1024 + b저장 를, 가중치 에서, b원 로).
    비동기묶기().
    타일수 > 1이면 {
        b원 = b원 + 열32.
        올판 = 1.
        비동기복사16(판 에, 3072 + 올판 * 1024 + b저장 를, 가중치 에서, b원 로).
        ra원 = ra원 + 32.
        ra0 = 입력[ra원 + 0].
        ra1 = 입력[ra원 + 1].
        ra2 = 입력[ra원 + 2].
        ra3 = 입력[ra원 + 3].
    }
    비동기묶기().

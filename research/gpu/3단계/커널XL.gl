        아니면 {
            정수 한계0 = pq0 - tb.
            정수 한계1 = pq1 - tb.
            정수 한계2 = pq2 - tb.
            정수 한계3 = pq3 - tb.
            반복 (정수 t0 = 0: t0 < 64: t0 += 4) {
                정수 t4 = t0 / 4.

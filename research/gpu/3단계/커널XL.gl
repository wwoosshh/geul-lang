        a3_2 = 곱해더하기(x3, w2, a3_2).
        a3_3 = 곱해더하기(x3, w3, a3_3).
        t + 1 < 타일수이면 {
            정수 다음버퍼 = 버퍼 + 1.
            다음버퍼 == 3이면 { 다음버퍼 = 0. }
            판[다음버퍼 * 1024 + a저장 + 0] = ra0.
            판[다음버퍼 * 1024 + a저장 + 32] = ra1.
            판[다음버퍼 * 1024 + a저장 + 64] = ra2.
            판[다음버퍼 * 1024 + a저장 + 96] = ra3.
            t + 2 < 타일수이면 {
                ra원 = ra원 + 32.
                ra0 = 입력[ra원 + 0].
                ra1 = 입력[ra원 + 1].
                ra2 = 입력[ra원 + 2].
                ra3 = 입력[ra원 + 3].
            }
        }
        버퍼 = 버퍼 + 1.
        버퍼 == 3이면 { 버퍼 = 0. }
        앞판 = 앞판 + 1.
        앞판 == 3이면 { 앞판 = 0. }
    }
    동기화().
    가닥 >= 2이면 {
        판[0 + (가닥 - 2) * 64 + t64] = a0_0.
        판[128 + (가닥 - 2) * 64 + t64] = a0_1.
        판[256 + (가닥 - 2) * 64 + t64] = a0_2.
        판[384 + (가닥 - 2) * 64 + t64] = a0_3.
        판[512 + (가닥 - 2) * 64 + t64] = a1_0.
        판[640 + (가닥 - 2) * 64 + t64] = a1_1.
        판[768 + (가닥 - 2) * 64 + t64] = a1_2.
        판[896 + (가닥 - 2) * 64 + t64] = a1_3.
        판[1024 + (가닥 - 2) * 64 + t64] = a2_0.
        판[1152 + (가닥 - 2) * 64 + t64] = a2_1.
        판[1280 + (가닥 - 2) * 64 + t64] = a2_2.
        판[1408 + (가닥 - 2) * 64 + t64] = a2_3.
        판[1536 + (가닥 - 2) * 64 + t64] = a3_0.
        판[1664 + (가닥 - 2) * 64 + t64] = a3_1.
        판[1792 + (가닥 - 2) * 64 + t64] = a3_2.
        판[1920 + (가닥 - 2) * 64 + t64] = a3_3.
    }
    동기화().
    가닥 < 2이면 {
        a0_0 = a0_0 + 판[0 + 가닥 * 64 + t64].
        a0_1 = a0_1 + 판[128 + 가닥 * 64 + t64].
        a0_2 = a0_2 + 판[256 + 가닥 * 64 + t64].
        a0_3 = a0_3 + 판[384 + 가닥 * 64 + t64].
        a1_0 = a1_0 + 판[512 + 가닥 * 64 + t64].
        a1_1 = a1_1 + 판[640 + 가닥 * 64 + t64].
        a1_2 = a1_2 + 판[768 + 가닥 * 64 + t64].
        a1_3 = a1_3 + 판[896 + 가닥 * 64 + t64].
        a2_0 = a2_0 + 판[1024 + 가닥 * 64 + t64].
        a2_1 = a2_1 + 판[1152 + 가닥 * 64 + t64].
        a2_2 = a2_2 + 판[1280 + 가닥 * 64 + t64].
        a2_3 = a2_3 + 판[1408 + 가닥 * 64 + t64].
        a3_0 = a3_0 + 판[1536 + 가닥 * 64 + t64].
        a3_1 = a3_1 + 판[1664 + 가닥 * 64 + t64].
        a3_2 = a3_2 + 판[1792 + 가닥 * 64 + t64].
        a3_3 = a3_3 + 판[1920 + 가닥 * 64 + t64].
    }
    동기화().
    가닥 < 2이면 {
        판[2048 + 가닥 * 1056 + (ty * 4 + 0) * 33 + tx * 4 + 0] = a0_0.
        판[2048 + 가닥 * 1056 + (ty * 4 + 0) * 33 + tx * 4 + 1] = a0_1.
        판[2048 + 가닥 * 1056 + (ty * 4 + 0) * 33 + tx * 4 + 2] = a0_2.
        판[2048 + 가닥 * 1056 + (ty * 4 + 0) * 33 + tx * 4 + 3] = a0_3.
        판[2048 + 가닥 * 1056 + (ty * 4 + 1) * 33 + tx * 4 + 0] = a1_0.
        판[2048 + 가닥 * 1056 + (ty * 4 + 1) * 33 + tx * 4 + 1] = a1_1.
        판[2048 + 가닥 * 1056 + (ty * 4 + 1) * 33 + tx * 4 + 2] = a1_2.
        판[2048 + 가닥 * 1056 + (ty * 4 + 1) * 33 + tx * 4 + 3] = a1_3.
        판[2048 + 가닥 * 1056 + (ty * 4 + 2) * 33 + tx * 4 + 0] = a2_0.
        판[2048 + 가닥 * 1056 + (ty * 4 + 2) * 33 + tx * 4 + 1] = a2_1.
        판[2048 + 가닥 * 1056 + (ty * 4 + 2) * 33 + tx * 4 + 2] = a2_2.
        판[2048 + 가닥 * 1056 + (ty * 4 + 2) * 33 + tx * 4 + 3] = a2_3.
        판[2048 + 가닥 * 1056 + (ty * 4 + 3) * 33 + tx * 4 + 0] = a3_0.
        판[2048 + 가닥 * 1056 + (ty * 4 + 3) * 33 + tx * 4 + 1] = a3_1.
        판[2048 + 가닥 * 1056 + (ty * 4 + 3) * 33 + tx * 4 + 2] = a3_2.
        판[2048 + 가닥 * 1056 + (ty * 4 + 3) * 33 + tx * 4 + 3] = a3_3.
    }
    동기화().
    정수 행 = 0.
    정수 열 = 0.
    정수 자리 = 0.
    정수 자리위 = 0.
    정수 칸 = 0.
    짧은실수 v = 영.
    짧은실수 u = 영.
    짧은실수 th = 영.
    반복 (정수 m는 0부터 4 전까지) {
        칸 = m * 256 + tid.
        행 = 행0 + 칸 / 32.
        열 = 열0 + 칸 % 32.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[2048 + (칸 / 32) * 33 + 칸 % 32] + 판[3104 + (칸 / 32) * 33 + 칸 % 32]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 행. }
            아니면 { 자리 = (행 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 행 % 묶음안행수. }
            열 < 1600이면 { 출력[행 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }
    }
}

(* 행 1 개 × 열 32 개를 블록 하나(가닥 4 × 열 32)가 — 가중치를 16 개씩 먼저 읽고 차례로 곱해더한다 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 짧은실수 참조 다음을 정수 다음수로 줄선형1_KV]는 {
    정수 tid = 블록안가로().
    정수 가닥 = tid / 32.
    정수 tx = tid % 32.
    정수 열 = 블록가로() * 32 + tx.
    정수 c = 열.
    c >= 열수이면 { c = 열수 - 1. }
    정수 i0 = 0.
    i0 >= 행수이면 { i0 = 행수 - 1. }
    정수 x바탕0 = i0 * 깊이.
    짧은실수 영 = 0 으로 짧은실수.
    짧은실수 a0 = 영.
    짧은실수 w0 = 영.
    짧은실수 w1 = 영.
    짧은실수 w2 = 영.
    짧은실수 w3 = 영.
    짧은실수 w4 = 영.
    짧은실수 w5 = 영.
    짧은실수 w6 = 영.
    짧은실수 w7 = 영.
    짧은실수 w8 = 영.
    짧은실수 w9 = 영.
    짧은실수 w10 = 영.
    짧은실수 w11 = 영.
    짧은실수 w12 = 영.
    짧은실수 w13 = 영.
    짧은실수 w14 = 영.
    짧은실수 w15 = 영.
    정수 k = 가닥.
    반복 (: k + 60 < 깊이: k += 64) {
        w0 = 가중치[(k + 0) * 열수 + c].
        w1 = 가중치[(k + 4) * 열수 + c].
        w2 = 가중치[(k + 8) * 열수 + c].
        w3 = 가중치[(k + 12) * 열수 + c].
        w4 = 가중치[(k + 16) * 열수 + c].
        w5 = 가중치[(k + 20) * 열수 + c].
        w6 = 가중치[(k + 24) * 열수 + c].
        w7 = 가중치[(k + 28) * 열수 + c].
        w8 = 가중치[(k + 32) * 열수 + c].
        w9 = 가중치[(k + 36) * 열수 + c].
        w10 = 가중치[(k + 40) * 열수 + c].
        w11 = 가중치[(k + 44) * 열수 + c].
        w12 = 가중치[(k + 48) * 열수 + c].
        w13 = 가중치[(k + 52) * 열수 + c].
        w14 = 가중치[(k + 56) * 열수 + c].
        w15 = 가중치[(k + 60) * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k + 0], w0, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 4], w1, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 8], w2, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 12], w3, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 16], w4, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 20], w5, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 24], w6, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 28], w7, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 32], w8, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 36], w9, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 40], w10, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 44], w11, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 48], w12, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 52], w13, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 56], w14, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 60], w15, a0).
    }
    반복 (: k < 깊이: k += 4) {
        w0 = 가중치[k * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k], w0, a0).
    }
    짧은실수 참조 판 = 공유판4().
    가닥 >= 2이면 {
        판[((가닥 - 2) * 1 + 0) * 32 + tx] = a0.
    }
    동기화().
    가닥 < 2이면 {
        a0 = a0 + 판[(가닥 * 1 + 0) * 32 + tx].
    }
    동기화().
    가닥 == 1이면 {
        판[0 + tx] = a0.
    }
    동기화().
    (가닥 == 0 그리고 열 < 열수)이면 {
        짧은실수 v = 영.
        짧은실수 u = 영.
        짧은실수 th = 영.
        정수 자리 = 0.
        정수 자리위 = 0.
        0 < 행수이면 {
            v = (a0 + 판[0 + tx]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 0. }
            아니면 { 자리 = (0 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 0 % 묶음안행수. }
            열 < 1600이면 { 출력[0 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }
    }
    (* 다음 커널의 가중치를 L2 로 미리 — 128 바이트 줄마다 한 번, 모든 스레드가 나눠서 *)
    반복 (정수 미 = 실행번호() * 32: 미 < 다음수: 미 += 실행개수() * 32) { 미리읽기(다음, 미). }
}

(* 행 4 개 × 열 32 개를 블록 하나(가닥 4 × 열 32)가 — 가중치를 16 개씩 먼저 읽고 차례로 곱해더한다 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 짧은실수 참조 다음을 정수 다음수로 줄선형4_KV]는 {

    정수 행 = 0.
    정수 열 = 0.
    정수 자리 = 0.
    정수 자리위 = 0.
    정수 칸 = 0.
    짧은실수 v = 영.
    짧은실수 u = 영.
    짧은실수 th = 영.
    정수 rr = 0.
    정수 cc = 0.
    반복 (정수 m는 0부터 16 전까지) {
        칸 = m * 256 + tid.
        rr = 칸 / 64.
        cc = 칸 % 64.
        행 = 행0 + rr.
        열 = 열0 + cc.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[rr * 68 + cc] + 판[4352 + rr * 68 + cc]) + 치우침[열].
            출력[행 * 열수 + 열] = v.
        }
    }
}

(* 64 × 64 칸을 블록 하나가 — 가닥 g 의 스레드 64 개가 k ≡ g (mod 4) 를 맡고, 스레드 하나가 8 × 8 칸. 커널생성.py 의 설명 *)
(* 실행한도 타일선형넷 256 2 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 타일선형넷]는 {
    정수 tid = 블록안가로().
    정수 가닥 = tid / 64.
    정수 t64 = tid % 64.
    정수 ty = t64 / 8.
    정수 tx = t64 % 8.
    정수 행0 = 블록가로() * 64.
    정수 열0 = 블록세로() * 64.
    짧은실수 참조 판 = 공유판48().
    정수 a행 = 행0 + tid / 4.
    a행 >= 행수이면 { a행 = 행수 - 1. }
    정수 ak = (tid % 4) * 8.
    정수 a저장 = ak * 64 + ((tid / 4) ^ ((tid % 4) * 8)).
    정수 a원 = a행 * 깊이 + ak.
    정수 열32 = 열수 * 32.
    정수 열16 = 열수 * 16.
    정수 b저장 = (tid / 16) * 64 + (tid % 16) * 4.
    정수 b원 = (tid / 16) * 열수 + 열0 + (tid % 16) * 4.
    정수 타일수 = 깊이 / 32.
    정수 올판 = 0.
    정수 ar0 = tid / 8.
    정수 ac = (tid % 8) * 4.
    정수 sa = 8 * ((tid % 8) / 2).
    정수 깊이4 = 깊이 / 4 * 4.
    정수 행a0 = 행0 + ar0.
    행a0 >= 행수이면 { 행a0 = 행수 - 1. }
    정수 행a1 = 행0 + ar0 + 32.
    행a1 >= 행수이면 { 행a1 = 행수 - 1. }
    정수 ra원0 = 행a0 * 깊이4 + ac.
    정수 ra원1 = 행a1 * 깊이4 + ac.
    정수 저a = ac * 64 + (ar0 ^ sa).
    짧은실수 ra0_0 = 입력[ra원0 + 0].
    짧은실수 ra0_1 = 입력[ra원0 + 1].
    짧은실수 ra0_2 = 입력[ra원0 + 2].
    짧은실수 ra0_3 = 입력[ra원0 + 3].
    짧은실수 ra1_0 = 입력[ra원1 + 0].
    짧은실수 ra1_1 = 입력[ra원1 + 1].
    짧은실수 ra1_2 = 입력[ra원1 + 2].
    짧은실수 ra1_3 = 입력[ra원1 + 3].
    판[0 + 저a + 0] = ra0_0.
    판[0 + 저a + 64] = ra0_1.
    판[0 + 저a + 128] = ra0_2.
    판[0 + 저a + 192] = ra0_3.
    판[0 + 저a + 32] = ra1_0.

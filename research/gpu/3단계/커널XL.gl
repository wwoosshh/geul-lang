        a3 = 곱해더하기(입력[x바탕3 + k + 60], w15, a3).
    }
    반복 (: k < 깊이: k += 4) {
        w0 = 가중치[k * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k], w0, a0).
        a1 = 곱해더하기(입력[x바탕1 + k], w0, a1).
        a2 = 곱해더하기(입력[x바탕2 + k], w0, a2).
        a3 = 곱해더하기(입력[x바탕3 + k], w0, a3).
    }
    짧은실수 참조 판 = 공유판4().
    가닥 >= 2이면 {
        판[((가닥 - 2) * 4 + 0) * 32 + tx] = a0.
        판[((가닥 - 2) * 4 + 1) * 32 + tx] = a1.
        판[((가닥 - 2) * 4 + 2) * 32 + tx] = a2.
        판[((가닥 - 2) * 4 + 3) * 32 + tx] = a3.
    }
    동기화().
    가닥 < 2이면 {
        a0 = a0 + 판[(가닥 * 4 + 0) * 32 + tx].
        a1 = a1 + 판[(가닥 * 4 + 1) * 32 + tx].
        a2 = a2 + 판[(가닥 * 4 + 2) * 32 + tx].
        a3 = a3 + 판[(가닥 * 4 + 3) * 32 + tx].
    }
    동기화().
    가닥 == 1이면 {
        판[0 + tx] = a0.
        판[32 + tx] = a1.
        판[64 + tx] = a2.
        판[96 + tx] = a3.
    }
    동기화().
    (가닥 == 0 그리고 열 < 열수)이면 {
        짧은실수 v = 영.
        짧은실수 u = 영.
        짧은실수 th = 영.
        정수 자리 = 0.
        정수 자리위 = 0.
        0 < 행수이면 {
            v = (a0 + 판[0 + tx]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 0. }
            아니면 { 자리 = (0 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 0 % 묶음안행수. }
            열 < 1600이면 { 출력[0 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }
        1 < 행수이면 {
            v = (a1 + 판[32 + tx]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 1. }
            아니면 { 자리 = (1 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 1 % 묶음안행수. }
            열 < 1600이면 { 출력[1 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }
        2 < 행수이면 {
            v = (a2 + 판[64 + tx]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 2. }
            아니면 { 자리 = (2 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 2 % 묶음안행수. }
            열 < 1600이면 { 출력[2 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }
        3 < 행수이면 {
            v = (a3 + 판[96 + tx]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 3. }
            아니면 { 자리 = (3 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 3 % 묶음안행수. }
            열 < 1600이면 { 출력[3 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }
    }
    (* 다음 커널의 가중치를 L2 로 미리 — 128 바이트 줄마다 한 번, 모든 스레드가 나눠서 *)
    반복 (정수 미 = 실행번호() * 32: 미 < 다음수: 미 += 실행개수() * 32) { 미리읽기(다음, 미). }
}

(* 행 1 개 × 열 32 개를 블록 하나(가닥 4 × 열 32)가 — 가중치를 48 개씩 먼저 읽고 차례로 곱해더한다 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 짧은실수 참조 다음을 정수 다음수로 깊은줄선형1_KV]는 {

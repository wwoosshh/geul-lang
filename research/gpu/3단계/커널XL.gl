        w4 = 가중치[(k + 16) * 열수 + c].
        w5 = 가중치[(k + 20) * 열수 + c].
        w6 = 가중치[(k + 24) * 열수 + c].
        w7 = 가중치[(k + 28) * 열수 + c].
        w8 = 가중치[(k + 32) * 열수 + c].
        w9 = 가중치[(k + 36) * 열수 + c].
        w10 = 가중치[(k + 40) * 열수 + c].
        w11 = 가중치[(k + 44) * 열수 + c].
        w12 = 가중치[(k + 48) * 열수 + c].
        w13 = 가중치[(k + 52) * 열수 + c].
        w14 = 가중치[(k + 56) * 열수 + c].
        w15 = 가중치[(k + 60) * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k + 0], w0, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 0], w0, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 0], w0, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 0], w0, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 4], w1, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 4], w1, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 4], w1, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 4], w1, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 8], w2, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 8], w2, a1).

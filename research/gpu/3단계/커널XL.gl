                짧은실수 ev2_2 = 판[er2 + 2].
                짧은실수 ev2_3 = 판[er2 + 3].
                정수 er3 = eb3 + ((t4 ^ ex3) * 4).
                짧은실수 ev3_0 = 판[er3 + 0].
                짧은실수 ev3_1 = 판[er3 + 1].
                짧은실수 ev3_2 = 판[er3 + 2].
                짧은실수 ev3_3 = 판[er3 + 3].
                짧은실수 vv0_0 = 판[vt + 0].
                짧은실수 vv0_1 = 판[vt + 1].
                짧은실수 vv0_2 = 판[vt + 2].
                짧은실수 vv0_3 = 판[vt + 3].
                짧은실수 vv1_0 = 판[vt + 64].
                짧은실수 vv1_1 = 판[vt + 65].
                짧은실수 vv1_2 = 판[vt + 66].
                짧은실수 vv1_3 = 판[vt + 67].
                짧은실수 vv2_0 = 판[vt + 128].
                짧은실수 vv2_1 = 판[vt + 129].
                짧은실수 vv2_2 = 판[vt + 130].
                짧은실수 vv2_3 = 판[vt + 131].
                짧은실수 vv3_0 = 판[vt + 192].
                짧은실수 vv3_1 = 판[vt + 193].
                짧은실수 vv3_2 = 판[vt + 194].
                짧은실수 vv3_3 = 판[vt + 195].
                t0 + 0 <= 한계0이면 {
                    o0_0 = 곱해더하기(ev0_0, vv0_0, o0_0).
                    o0_1 = 곱해더하기(ev0_0, vv0_1, o0_1).
                    o0_2 = 곱해더하기(ev0_0, vv0_2, o0_2).
                    o0_3 = 곱해더하기(ev0_0, vv0_3, o0_3).
                }
                t0 + 0 <= 한계1이면 {
                    o1_0 = 곱해더하기(ev1_0, vv0_0, o1_0).
                    o1_1 = 곱해더하기(ev1_0, vv0_1, o1_1).

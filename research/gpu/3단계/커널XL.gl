        a3 = 곱해더하기(입력[x바탕3 + k + 20], w5, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 24], w6, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 24], w6, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 24], w6, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 24], w6, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 28], w7, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 28], w7, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 28], w7, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 28], w7, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 32], w8, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 32], w8, a1).

        a3 = 곱해더하기(입력[x바탕3 + k + 4], w1, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 8], w2, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 8], w2, a1).

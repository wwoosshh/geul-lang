        s3_1 = s3_1 * 0.125.
        s3_2 = s3_2 * 0.125.
        s3_3 = s3_3 * 0.125.
        tb + kx + 0 > pq0이면 { s0_0 = -3.0e38. }
        tb + kx + 1 > pq0이면 { s0_1 = -3.0e38. }
        tb + kx + 2 > pq0이면 { s0_2 = -3.0e38. }
        tb + kx + 3 > pq0이면 { s0_3 = -3.0e38. }
        tb + kx + 0 > pq1이면 { s1_0 = -3.0e38. }
        tb + kx + 1 > pq1이면 { s1_1 = -3.0e38. }
        tb + kx + 2 > pq1이면 { s1_2 = -3.0e38. }
        tb + kx + 3 > pq1이면 { s1_3 = -3.0e38. }
        tb + kx + 0 > pq2이면 { s2_0 = -3.0e38. }
        tb + kx + 1 > pq2이면 { s2_1 = -3.0e38. }
        tb + kx + 2 > pq2이면 { s2_2 = -3.0e38. }

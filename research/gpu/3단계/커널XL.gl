        w42 = 가중치[(k + 168) * 열수 + c].
        w43 = 가중치[(k + 172) * 열수 + c].
        w44 = 가중치[(k + 176) * 열수 + c].
        w45 = 가중치[(k + 180) * 열수 + c].
        w46 = 가중치[(k + 184) * 열수 + c].
        w47 = 가중치[(k + 188) * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k + 0], w0, a0).

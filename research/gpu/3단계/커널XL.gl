        키타일 == 1이면 { rr = 칸 % 64. cc = 칸 / 64. }
        아니면 { rr = 칸 / 64. cc = 칸 % 64. }
        행 = 행0 + rr.
        열 = 열0 + cc.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[rr * 68 + cc] + 판[4352 + rr * 68 + cc]) + 치우침[열].
            묶음안행수 >= 행수이면 { 자리 = 0. 자리위 = 위치시작 + 행. }
            아니면 { 자리 = (행 / 묶음안행수) * 1600 * 최대길이. 자리위 = 위치시작 + 행 % 묶음안행수. }
            열 < 1600이면 { 출력[행 * 1600 + 열] = v. }
            아니면 열 < 3200이면 { 키칸[자리 + (열 - 1600) * 최대길이 + 자리위] = v. }
            아니면 { 값칸[자리 + ((열 - 3200) / 64) * 최대길이 * 64 + 자리위 * 64 + (열 - 3200) % 64] = v. }
        }

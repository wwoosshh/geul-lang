        }
    }
    동기화().
    칸[가닥 * 128 + tx + 0] = a3_0.
    칸[가닥 * 128 + tx + 32] = a3_1.
    칸[가닥 * 128 + tx + 64] = a3_2.
    칸[가닥 * 128 + tx + 96] = a3_3.
    동기화().
    가닥 < 4이면 {

        }
    }
    동기화().
    칸[가닥 * 128 + tx + 0] = a2_0.
    칸[가닥 * 128 + tx + 32] = a2_1.
    칸[가닥 * 128 + tx + 64] = a2_2.
    칸[가닥 * 128 + tx + 96] = a2_3.
    동기화().
    가닥 < 4이면 {

        a0 = 곱해더하기(입력[x바탕0 + k + 164], w41, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 168], w42, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 172], w43, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 176], w44, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 180], w45, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 184], w46, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 188], w47, a0).
    }
    반복 (: k < 깊이: k += 4) {
        w0 = 가중치[k * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k], w0, a0).
    }
    짧은실수 참조 판 = 공유판4().
    가닥 >= 2이면 {
        판[((가닥 - 2) * 1 + 0) * 32 + tx] = a0.
    }
    동기화().
    가닥 < 2이면 {
        a0 = a0 + 판[(가닥 * 1 + 0) * 32 + tx].
    }
    동기화().
    가닥 == 1이면 {
        판[0 + tx] = a0.
    }
    동기화().
    (가닥 == 0 그리고 열 < 열수)이면 {
        짧은실수 v = 영.
        짧은실수 u = 영.
        짧은실수 th = 영.
        정수 자리 = 0.
        0 < 행수이면 {
            v = (a0 + 판[0 + tx]) + 치우침[열].
            자리 = ((0 / 묶음안행수) * 최대길이 + 위치시작 + 0 % 묶음안행수) * 768.
            열 < 768이면 { 출력[0 * 768 + 열] = v. }
            아니면 열 < 1536이면 { 키칸[자리 + 열 - 768] = v. }
            아니면 { 값칸[자리 + 열 - 1536] = v. }
        }
    }
    (* 다음 커널의 가중치를 L2 로 미리 — 128 바이트 줄마다 한 번, 모든 스레드가 나눠서 *)
    반복 (정수 미 = 실행번호() * 32: 미 < 다음수: 미 += 실행개수() * 32) { 미리읽기(다음, 미). }
}


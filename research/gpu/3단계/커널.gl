    정수 ty4x0 = (ty * 4) ^ 0.
    정수 ty4x1 = (ty * 4) ^ 8.
    정수 ty4x2 = (ty * 4) ^ 16.
    정수 ty4x3 = (ty * 4) ^ 24.
    정수 aq = 0.

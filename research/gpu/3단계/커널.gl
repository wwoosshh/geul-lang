        출력[(행바탕 + 내m) * 768 + 머리 * 64 + tj * 4 + 2] = ((o0_2 + o2_2) + (o1_2 + o3_2)) / 합.
        출력[(행바탕 + 내m) * 768 + 머리 * 64 + tj * 4 + 3] = ((o0_3 + o2_3) + (o1_3 + o3_3)) / 합.
    }
}

(* 어텐션 (가) — 블록 하나가 (머리, 질의 64 개, 키 64 개)의 점수와 줄마다의 조각 최댓값. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 점수타일 256 2 *)
[짧은실수 참조 q에서 짧은실수 참조 키칸과 짧은실수 참조 점수칸에 짧은실수 참조 최대칸에 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 점수타일]는 {
    정수 tid = 블록안가로().
    정수 키조각 = 블록가로().
    정수 질조각수 = (묶음안행수 + 63) / 64.
    정수 머리 = (블록세로() / 질조각수) % 12.
    정수 문장 = 블록세로() / (질조각수 * 12).
    정수 m0 = (블록세로() % 질조각수) * 64.
    정수 끝m = m0 + 64.
    끝m > 묶음안행수이면 { 끝m = 묶음안행수. }
    정수 끝위치 = 위치시작 + 끝m - 1.
    정수 t0 = 키조각 * 64.
    t0 <= 끝위치이면 {
        정수 캐시 = 문장 * 최대길이 * 768 + 머리 * 64.
        정수 행바탕 = 문장 * 묶음안행수.
        짧은실수 참조 판 = 공유판40().
        정수 옮줄 = tid / 16.
        정수 옮칸 = (tid % 16) * 4.
        정수 qm = 0.
        정수 kp = 0.
        qm = m0 + 0 + 옮줄.
        qm >= 끝m이면 { qm = 끝m - 1. }
        비동기복사16(판 에, (0 + 옮줄) * 68 + 옮칸 를, q 에서, (행바탕 + qm) * 768 + 머리 * 64 + 옮칸 로).
        kp = t0 + 0 + 옮줄.
        kp > 끝위치이면 { kp = 끝위치. }
        비동기복사16(판 에, 4352 + (0 + 옮줄) * 68 + 옮칸 를, 키칸 에서, 캐시 + kp * 768 + 옮칸 로).
        qm = m0 + 16 + 옮줄.
        qm >= 끝m이면 { qm = 끝m - 1. }
        비동기복사16(판 에, (16 + 옮줄) * 68 + 옮칸 를, q 에서, (행바탕 + qm) * 768 + 머리 * 64 + 옮칸 로).
        kp = t0 + 16 + 옮줄.
        kp > 끝위치이면 { kp = 끝위치. }
        비동기복사16(판 에, 4352 + (16 + 옮줄) * 68 + 옮칸 를, 키칸 에서, 캐시 + kp * 768 + 옮칸 로).
        qm = m0 + 32 + 옮줄.
        qm >= 끝m이면 { qm = 끝m - 1. }
        비동기복사16(판 에, (32 + 옮줄) * 68 + 옮칸 를, q 에서, (행바탕 + qm) * 768 + 머리 * 64 + 옮칸 로).
        kp = t0 + 32 + 옮줄.
        kp > 끝위치이면 { kp = 끝위치. }
        비동기복사16(판 에, 4352 + (32 + 옮줄) * 68 + 옮칸 를, 키칸 에서, 캐시 + kp * 768 + 옮칸 로).
        qm = m0 + 48 + 옮줄.
        qm >= 끝m이면 { qm = 끝m - 1. }
        비동기복사16(판 에, (48 + 옮줄) * 68 + 옮칸 를, q 에서, (행바탕 + qm) * 768 + 머리 * 64 + 옮칸 로).
        kp = t0 + 48 + 옮줄.
        kp > 끝위치이면 { kp = 끝위치. }
        비동기복사16(판 에, 4352 + (48 + 옮줄) * 68 + 옮칸 를, 키칸 에서, 캐시 + kp * 768 + 옮칸 로).
        비동기묶기().
        비동기기다리기(0).

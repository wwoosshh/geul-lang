        a0 = 곱해더하기(입력[x바탕0 + k + 152], w38, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 156], w39, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 160], w40, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 164], w41, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 168], w42, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 172], w43, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 176], w44, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 180], w45, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 184], w46, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 188], w47, a0).
    }
    반복 (: k < 깊이: k += 4) {
        w0 = 가중치[k * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k], w0, a0).
    }
    짧은실수 참조 판 = 공유판4().
    가닥 >= 2이면 {
        판[((가닥 - 2) * 1 + 0) * 32 + tx] = a0.
    }
    동기화().
    가닥 < 2이면 {
        a0 = a0 + 판[(가닥 * 1 + 0) * 32 + tx].
    }
    동기화().
    가닥 == 1이면 {
        판[0 + tx] = a0.
    }
    동기화().
    (가닥 == 0 그리고 열 < 열수)이면 {
        짧은실수 v = 영.
        짧은실수 u = 영.
        짧은실수 th = 영.
        정수 자리 = 0.
        0 < 행수이면 {
            v = (a0 + 판[0 + tx]) + 치우침[열].
            자리 = ((0 / 묶음안행수) * 최대길이 + 위치시작 + 0 % 묶음안행수) * 768.
            열 < 768이면 { 출력[0 * 768 + 열] = v. }
            아니면 열 < 1536이면 { 키칸[자리 + 열 - 768] = v. }
            아니면 { 값칸[자리 + 열 - 1536] = v. }
        }
    }
    (* 다음 커널의 가중치를 L2 로 미리 — 128 바이트 줄마다 한 번, 모든 스레드가 나눠서 *)
    반복 (정수 미 = 실행번호() * 32: 미 < 다음수: 미 += 실행개수() * 32) { 미리읽기(다음, 미). }
}

(* 블록 하나가 (머리, 질의 행) 하나 — 순서 약속은 커널생성.py 의 설명 *)
[짧은실수 참조 q에서 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 줄어텐션]는 {
    정수 머리 = 블록가로().
    정수 행 = 블록세로().
    정수 tid = 블록안가로().
    정수 위치 = 위치시작 + 행 % 묶음안행수.
    정수 캐시 = (행 / 묶음안행수) * 최대길이 * 768 + 머리 * 64.
    짧은실수 참조 판 = 공유판8().
    tid < 64이면 { 판[1280 + tid] = q[행 * 768 + 머리 * 64 + tid]. }
    동기화().
    짧은실수 내큰값 = -3.0e38.
    짧은실수 s = 0 으로 짧은실수.
    정수 kb = 0.
    반복 (정수 t = tid: t <= 위치: t += 256) {
        s = 0 으로 짧은실수.
        kb = 캐시 + t * 768.
        s = 곱해더하기(판[1280 + 0], 키칸[kb + 0], s).
        s = 곱해더하기(판[1280 + 1], 키칸[kb + 1], s).
        s = 곱해더하기(판[1280 + 2], 키칸[kb + 2], s).
        s = 곱해더하기(판[1280 + 3], 키칸[kb + 3], s).
        s = 곱해더하기(판[1280 + 4], 키칸[kb + 4], s).
        s = 곱해더하기(판[1280 + 5], 키칸[kb + 5], s).
        s = 곱해더하기(판[1280 + 6], 키칸[kb + 6], s).
        s = 곱해더하기(판[1280 + 7], 키칸[kb + 7], s).
        s = 곱해더하기(판[1280 + 8], 키칸[kb + 8], s).
        s = 곱해더하기(판[1280 + 9], 키칸[kb + 9], s).
        s = 곱해더하기(판[1280 + 10], 키칸[kb + 10], s).
        s = 곱해더하기(판[1280 + 11], 키칸[kb + 11], s).
        s = 곱해더하기(판[1280 + 12], 키칸[kb + 12], s).
        s = 곱해더하기(판[1280 + 13], 키칸[kb + 13], s).
        s = 곱해더하기(판[1280 + 14], 키칸[kb + 14], s).
        s = 곱해더하기(판[1280 + 15], 키칸[kb + 15], s).
        s = 곱해더하기(판[1280 + 16], 키칸[kb + 16], s).
        s = 곱해더하기(판[1280 + 17], 키칸[kb + 17], s).
        s = 곱해더하기(판[1280 + 18], 키칸[kb + 18], s).
        s = 곱해더하기(판[1280 + 19], 키칸[kb + 19], s).
        s = 곱해더하기(판[1280 + 20], 키칸[kb + 20], s).
        s = 곱해더하기(판[1280 + 21], 키칸[kb + 21], s).
        s = 곱해더하기(판[1280 + 22], 키칸[kb + 22], s).
        s = 곱해더하기(판[1280 + 23], 키칸[kb + 23], s).
        s = 곱해더하기(판[1280 + 24], 키칸[kb + 24], s).
        s = 곱해더하기(판[1280 + 25], 키칸[kb + 25], s).
        s = 곱해더하기(판[1280 + 26], 키칸[kb + 26], s).
        s = 곱해더하기(판[1280 + 27], 키칸[kb + 27], s).
        s = 곱해더하기(판[1280 + 28], 키칸[kb + 28], s).
        s = 곱해더하기(판[1280 + 29], 키칸[kb + 29], s).
        s = 곱해더하기(판[1280 + 30], 키칸[kb + 30], s).
        s = 곱해더하기(판[1280 + 31], 키칸[kb + 31], s).
        s = 곱해더하기(판[1280 + 32], 키칸[kb + 32], s).
        s = 곱해더하기(판[1280 + 33], 키칸[kb + 33], s).
        s = 곱해더하기(판[1280 + 34], 키칸[kb + 34], s).
        s = 곱해더하기(판[1280 + 35], 키칸[kb + 35], s).
        s = 곱해더하기(판[1280 + 36], 키칸[kb + 36], s).
        s = 곱해더하기(판[1280 + 37], 키칸[kb + 37], s).
        s = 곱해더하기(판[1280 + 38], 키칸[kb + 38], s).
        s = 곱해더하기(판[1280 + 39], 키칸[kb + 39], s).
        s = 곱해더하기(판[1280 + 40], 키칸[kb + 40], s).
        s = 곱해더하기(판[1280 + 41], 키칸[kb + 41], s).
        s = 곱해더하기(판[1280 + 42], 키칸[kb + 42], s).
        s = 곱해더하기(판[1280 + 43], 키칸[kb + 43], s).
        s = 곱해더하기(판[1280 + 44], 키칸[kb + 44], s).
        s = 곱해더하기(판[1280 + 45], 키칸[kb + 45], s).
        s = 곱해더하기(판[1280 + 46], 키칸[kb + 46], s).
        s = 곱해더하기(판[1280 + 47], 키칸[kb + 47], s).
        s = 곱해더하기(판[1280 + 48], 키칸[kb + 48], s).
        s = 곱해더하기(판[1280 + 49], 키칸[kb + 49], s).
        s = 곱해더하기(판[1280 + 50], 키칸[kb + 50], s).
        s = 곱해더하기(판[1280 + 51], 키칸[kb + 51], s).
        s = 곱해더하기(판[1280 + 52], 키칸[kb + 52], s).
        s = 곱해더하기(판[1280 + 53], 키칸[kb + 53], s).
        s = 곱해더하기(판[1280 + 54], 키칸[kb + 54], s).
        s = 곱해더하기(판[1280 + 55], 키칸[kb + 55], s).
        s = 곱해더하기(판[1280 + 56], 키칸[kb + 56], s).
        s = 곱해더하기(판[1280 + 57], 키칸[kb + 57], s).
        s = 곱해더하기(판[1280 + 58], 키칸[kb + 58], s).
        s = 곱해더하기(판[1280 + 59], 키칸[kb + 59], s).
        s = 곱해더하기(판[1280 + 60], 키칸[kb + 60], s).
        s = 곱해더하기(판[1280 + 61], 키칸[kb + 61], s).
        s = 곱해더하기(판[1280 + 62], 키칸[kb + 62], s).
        s = 곱해더하기(판[1280 + 63], 키칸[kb + 63], s).
        s = s * 0.125.
        판[t] = s.
        내큰값 = 큰쪽(내큰값, s).
    }
    판[1024 + tid] = 내큰값.
    동기화().
    반복 (정수 접기 = 128: 접기 > 0: 접기 /= 2) {
        tid < 접기이면 { 판[1024 + tid] = 큰쪽(판[1024 + tid], 판[1024 + tid + 접기]). }
        동기화().
    }
    짧은실수 큰값 = 판[1024].
    동기화().
    반복 (정수 t = tid: t <= 위치: t += 256) { 판[t] = 근사지수(판[t] - 큰값). }
    동기화().
    정수 j = tid / 64.
    정수 d = tid % 64.
    짧은실수 o = 0 으로 짧은실수.
    짧은실수 l = 0 으로 짧은실수.
    정수 t = j.
    반복 (: t + 12 <= 위치: t += 16) {
        짧은실수 p0 = 판[t + 0].
        짧은실수 p1 = 판[t + 4].
        짧은실수 p2 = 판[t + 8].
        짧은실수 p3 = 판[t + 12].
        짧은실수 v0 = 값칸[캐시 + (t + 0) * 768 + d].
        짧은실수 v1 = 값칸[캐시 + (t + 4) * 768 + d].
        짧은실수 v2 = 값칸[캐시 + (t + 8) * 768 + d].
        짧은실수 v3 = 값칸[캐시 + (t + 12) * 768 + d].
        o = 곱해더하기(p0, v0, o).
        l = l + p0.
        o = 곱해더하기(p1, v1, o).
        l = l + p1.
        o = 곱해더하기(p2, v2, o).
        l = l + p2.
        o = 곱해더하기(p3, v3, o).
        l = l + p3.
    }
    반복 (: t <= 위치: t += 4) {
        짧은실수 p = 판[t].
        o = 곱해더하기(p, 값칸[캐시 + t * 768 + d], o).
        l = l + p.
    }
    판[1024 + tid] = o.
    d == 0이면 { 판[1344 + j] = l. }
    동기화().
    tid < 64이면 {
        짧은실수 합 = (판[1344] + 판[1346]) + (판[1345] + 판[1347]).
        출력[행 * 768 + 머리 * 64 + tid] = ((판[1024 + tid] + 판[1152 + tid]) + (판[1088 + tid] + 판[1216 + tid])) / 합.
    }
}

(* 블록 하나가 (머리, 한 문장의 질의 16 개) — 키·값 조각 32 개씩을 두 판에 번갈아 올린다. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 타일어텐션 256 2 *)
[짧은실수 참조 q에서 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 타일어텐션]는 {
    정수 tid = 블록안가로().
    정수 머리 = 블록가로().
    정수 조각수 = (묶음안행수 + 15) / 16.

    짧은실수 w13 = 영.
    짧은실수 w14 = 영.
    짧은실수 w15 = 영.
    짧은실수 w16 = 영.
    짧은실수 w17 = 영.
    짧은실수 w18 = 영.
    짧은실수 w19 = 영.
    짧은실수 w20 = 영.
    짧은실수 w21 = 영.
    짧은실수 w22 = 영.
    짧은실수 w23 = 영.
    짧은실수 w24 = 영.
    짧은실수 w25 = 영.
    짧은실수 w26 = 영.
    짧은실수 w27 = 영.
    짧은실수 w28 = 영.
    짧은실수 w29 = 영.
    짧은실수 w30 = 영.
    짧은실수 w31 = 영.
    짧은실수 w32 = 영.
    짧은실수 w33 = 영.
    짧은실수 w34 = 영.
    짧은실수 w35 = 영.
    짧은실수 w36 = 영.
    짧은실수 w37 = 영.
    짧은실수 w38 = 영.
    짧은실수 w39 = 영.
    짧은실수 w40 = 영.
    짧은실수 w41 = 영.
    짧은실수 w42 = 영.
    짧은실수 w43 = 영.
    짧은실수 w44 = 영.
    짧은실수 w45 = 영.
    짧은실수 w46 = 영.
    짧은실수 w47 = 영.
    정수 k = 가닥.
    반복 (: k + 188 < 깊이: k += 192) {
        w0 = 가중치[(k + 0) * 열수 + c].
        w1 = 가중치[(k + 4) * 열수 + c].
        w2 = 가중치[(k + 8) * 열수 + c].
        w3 = 가중치[(k + 12) * 열수 + c].
        w4 = 가중치[(k + 16) * 열수 + c].
        w5 = 가중치[(k + 20) * 열수 + c].
        w6 = 가중치[(k + 24) * 열수 + c].
        w7 = 가중치[(k + 28) * 열수 + c].
        w8 = 가중치[(k + 32) * 열수 + c].
        w9 = 가중치[(k + 36) * 열수 + c].
        w10 = 가중치[(k + 40) * 열수 + c].
        w11 = 가중치[(k + 44) * 열수 + c].
        w12 = 가중치[(k + 48) * 열수 + c].
        w13 = 가중치[(k + 52) * 열수 + c].
        w14 = 가중치[(k + 56) * 열수 + c].

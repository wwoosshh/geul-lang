        행 = 행0 + 칸 / 64.
        열 = 열0 + 칸 % 64.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[(칸 / 64) * 68 + 칸 % 64] + 판[4352 + (칸 / 64) * 68 + 칸 % 64]) + 치우침[열].
            출력[행 * 열수 + 열] = 잔차[행 * 열수 + 열] + v.
        }

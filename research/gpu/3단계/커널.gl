        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 1] = a7_5.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 2] = a7_6.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + 32 + tx * 4 + 3] = a7_7.
    }
    동기화().
    정수 행 = 0.
    정수 열 = 0.
    정수 자리 = 0.
    정수 칸 = 0.
    짧은실수 v = 영.
    짧은실수 u = 영.
    짧은실수 th = 영.
    반복 (정수 m는 0부터 16 전까지) {
        칸 = m * 256 + tid.
        행 = 행0 + 칸 / 64.
        열 = 열0 + 칸 % 64.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[(칸 / 64) * 68 + 칸 % 64] + 판[4352 + (칸 / 64) * 68 + 칸 % 64]) + 치우침[열].
            자리 = ((행 / 묶음안행수) * 최대길이 + 위치시작 + 행 % 묶음안행수) * 768.
            열 < 768이면 { 출력[행 * 768 + 열] = v. }
            아니면 열 < 1536이면 { 키칸[자리 + 열 - 768] = v. }
            아니면 { 값칸[자리 + 열 - 1536] = v. }
        }
    }
}

(* 32 × 32 칸을 블록 하나가 — 가닥 g 의 스레드 64 개가 k ≡ g (mod 4) 를 맡고, 스레드 하나가 4 × 4 칸 *)
(* 실행한도 작은타일선형_KV 256 4 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 작은타일선형_KV]는 {
    정수 tid = 블록안가로().
    정수 가닥 = tid / 64.
    정수 t64 = tid % 64.
    정수 ty = t64 / 8.
    정수 tx = t64 % 8.
    정수 행0 = 블록가로() * 32.
    정수 열0 = 블록세로() * 32.
    짧은실수 참조 판 = 공유판24().
    정수 a행 = 행0 + tid / 8.
    a행 >= 행수이면 { a행 = 행수 - 1. }
    정수 ak = (tid % 8) * 4.
    정수 a저장 = ak * 32 + ((tid / 8) ^ ((tid % 8) * 4)).
    정수 a원 = a행 * 깊이 + ak.
    정수 열32 = 열수 * 32.
    정수 b저장 = (tid / 8) * 32 + (tid % 8) * 4.
    정수 b원 = (tid / 8) * 열수 + 열0 + (tid % 8) * 4.
    정수 타일수 = 깊이 / 32.
    정수 올판 = 0.
    올판 = 0.
    비동기복사(판 에, 올판 * 1024 + a저장 + 0 를, 입력 에서, a원 + 0 로).
    비동기복사(판 에, 올판 * 1024 + a저장 + 32 를, 입력 에서, a원 + 1 로).
    비동기복사(판 에, 올판 * 1024 + a저장 + 64 를, 입력 에서, a원 + 2 로).
    비동기복사(판 에, 올판 * 1024 + a저장 + 96 를, 입력 에서, a원 + 3 로).
    비동기복사16(판 에, 3072 + 올판 * 1024 + b저장 를, 가중치 에서, b원 로).
    비동기묶기().
    타일수 > 1이면 {
        a원 = a원 + 32.
        b원 = b원 + 열32.
        올판 = 1.
        비동기복사(판 에, 올판 * 1024 + a저장 + 0 를, 입력 에서, a원 + 0 로).
        비동기복사(판 에, 올판 * 1024 + a저장 + 32 를, 입력 에서, a원 + 1 로).
        비동기복사(판 에, 올판 * 1024 + a저장 + 64 를, 입력 에서, a원 + 2 로).

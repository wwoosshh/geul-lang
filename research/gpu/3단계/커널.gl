        a3 = 곱해더하기(입력[x바탕3 + k], w0, a3).
    }
    짧은실수 참조 판 = 공유판4().
    가닥 >= 2이면 {
        판[((가닥 - 2) * 4 + 0) * 32 + tx] = a0.
        판[((가닥 - 2) * 4 + 1) * 32 + tx] = a1.
        판[((가닥 - 2) * 4 + 2) * 32 + tx] = a2.
        판[((가닥 - 2) * 4 + 3) * 32 + tx] = a3.
    }
    동기화().
    가닥 < 2이면 {
        a0 = a0 + 판[(가닥 * 4 + 0) * 32 + tx].
        a1 = a1 + 판[(가닥 * 4 + 1) * 32 + tx].
        a2 = a2 + 판[(가닥 * 4 + 2) * 32 + tx].
        a3 = a3 + 판[(가닥 * 4 + 3) * 32 + tx].
    }
    동기화().
    가닥 == 1이면 {
        판[0 + tx] = a0.
        판[32 + tx] = a1.
        판[64 + tx] = a2.
        판[96 + tx] = a3.
    }
    동기화().
    (가닥 == 0 그리고 열 < 열수)이면 {
        짧은실수 v = 영.
        짧은실수 u = 영.
        짧은실수 th = 영.
        정수 자리 = 0.
        0 < 행수이면 {
            v = (a0 + 판[0 + tx]) + 치우침[열].
            u = 0.7978845608 * (v + 0.044715 * v * v * v).
            th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
            출력[0 * 열수 + 열] = 0.5 * v * (1.0 + th).
        }
        1 < 행수이면 {
            v = (a1 + 판[32 + tx]) + 치우침[열].
            u = 0.7978845608 * (v + 0.044715 * v * v * v).
            th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
            출력[1 * 열수 + 열] = 0.5 * v * (1.0 + th).
        }
        2 < 행수이면 {
            v = (a2 + 판[64 + tx]) + 치우침[열].

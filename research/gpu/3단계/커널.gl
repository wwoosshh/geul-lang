    가닥 < 2이면 {
        a0 = a0 + 판[(가닥 * 4 + 0) * 32 + tx].
        a1 = a1 + 판[(가닥 * 4 + 1) * 32 + tx].
        a2 = a2 + 판[(가닥 * 4 + 2) * 32 + tx].
        a3 = a3 + 판[(가닥 * 4 + 3) * 32 + tx].
    }

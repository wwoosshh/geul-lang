        w36 = 가중치[(k + 144) * 열수 + c].
        w37 = 가중치[(k + 148) * 열수 + c].
        w38 = 가중치[(k + 152) * 열수 + c].
        w39 = 가중치[(k + 156) * 열수 + c].
        w40 = 가중치[(k + 160) * 열수 + c].
        w41 = 가중치[(k + 164) * 열수 + c].
        w42 = 가중치[(k + 168) * 열수 + c].
        w43 = 가중치[(k + 172) * 열수 + c].
        w44 = 가중치[(k + 176) * 열수 + c].
        w45 = 가중치[(k + 180) * 열수 + c].
        w46 = 가중치[(k + 184) * 열수 + c].
        w47 = 가중치[(k + 188) * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k + 0], w0, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 4], w1, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 8], w2, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 12], w3, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 16], w4, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 20], w5, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 24], w6, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 28], w7, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 32], w8, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 36], w9, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 40], w10, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 44], w11, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 48], w12, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 52], w13, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 56], w14, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 60], w15, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 64], w16, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 68], w17, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 72], w18, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 76], w19, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 80], w20, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 84], w21, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 88], w22, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 92], w23, a0).

        a0 = 곱해더하기(입력[x바탕0 + k + 32], w8, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 32], w8, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 32], w8, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 32], w8, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 36], w9, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 36], w9, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 36], w9, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 36], w9, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 40], w10, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 40], w10, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 40], w10, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 40], w10, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 44], w11, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 44], w11, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 44], w11, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 44], w11, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 48], w12, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 48], w12, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 48], w12, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 48], w12, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 52], w13, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 52], w13, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 52], w13, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 52], w13, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 56], w14, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 56], w14, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 56], w14, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 56], w14, a3).
        a0 = 곱해더하기(입력[x바탕0 + k + 60], w15, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 60], w15, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 60], w15, a2).
        a3 = 곱해더하기(입력[x바탕3 + k + 60], w15, a3).
    }
    반복 (: k < 깊이: k += 4) {
        w0 = 가중치[k * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k], w0, a0).
        a1 = 곱해더하기(입력[x바탕1 + k], w0, a1).
        a2 = 곱해더하기(입력[x바탕2 + k], w0, a2).
        a3 = 곱해더하기(입력[x바탕3 + k], w0, a3).
    }
    짧은실수 참조 판 = 공유판4().
    가닥 >= 2이면 {
        판[((가닥 - 2) * 4 + 0) * 32 + tx] = a0.
        판[((가닥 - 2) * 4 + 1) * 32 + tx] = a1.
        판[((가닥 - 2) * 4 + 2) * 32 + tx] = a2.
        판[((가닥 - 2) * 4 + 3) * 32 + tx] = a3.
    }
    동기화().
    가닥 < 2이면 {
        a0 = a0 + 판[(가닥 * 4 + 0) * 32 + tx].
        a1 = a1 + 판[(가닥 * 4 + 1) * 32 + tx].
        a2 = a2 + 판[(가닥 * 4 + 2) * 32 + tx].
        a3 = a3 + 판[(가닥 * 4 + 3) * 32 + tx].
    }
    동기화().
    가닥 == 1이면 {
        판[0 + tx] = a0.
        판[32 + tx] = a1.
        판[64 + tx] = a2.
        판[96 + tx] = a3.
    }
    동기화().
    (가닥 == 0 그리고 열 < 열수)이면 {
        짧은실수 v = 영.
        짧은실수 u = 영.
        짧은실수 th = 영.
        정수 자리 = 0.
        0 < 행수이면 {
            v = (a0 + 판[0 + tx]) + 치우침[열].
            u = 0.7978845608 * (v + 0.044715 * v * v * v).
            th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
            출력[0 * 열수 + 열] = 0.5 * v * (1.0 + th).
        }
        1 < 행수이면 {
            v = (a1 + 판[32 + tx]) + 치우침[열].
            u = 0.7978845608 * (v + 0.044715 * v * v * v).
            th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
            출력[1 * 열수 + 열] = 0.5 * v * (1.0 + th).
        }
        2 < 행수이면 {
            v = (a2 + 판[64 + tx]) + 치우침[열].
            u = 0.7978845608 * (v + 0.044715 * v * v * v).
            th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
            출력[2 * 열수 + 열] = 0.5 * v * (1.0 + th).
        }
        3 < 행수이면 {
            v = (a3 + 판[96 + tx]) + 치우침[열].
            u = 0.7978845608 * (v + 0.044715 * v * v * v).
            th = 1.0 - 2.0 / (근사지수(2.0 * u) + 1.0).
            출력[3 * 열수 + 열] = 0.5 * v * (1.0 + th).
        }
    }
    (* 다음 커널의 가중치를 L2 로 미리 — 128 바이트 줄마다 한 번, 모든 스레드가 나눠서 *)
    반복 (정수 미 = 실행번호() * 32: 미 < 다음수: 미 += 실행개수() * 32) { 미리읽기(다음, 미). }
}

(* 행 1 개 × 열 32 개를 블록 하나(가닥 4 × 열 32)가 — 가중치를 48 개씩 먼저 읽고 차례로 곱해더한다 *)
[짧은실수 참조 입력에서 짧은실수 참조 가중치와 짧은실수 참조 치우침과 짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로 짧은실수 참조 다음을 정수 다음수로 깊은줄선형1_겔루]는 {
    정수 tid = 블록안가로().
    정수 가닥 = tid / 32.
    정수 tx = tid % 32.
    정수 열 = 블록가로() * 32 + tx.
    정수 c = 열.
    c >= 열수이면 { c = 열수 - 1. }
    정수 i0 = 0.
    i0 >= 행수이면 { i0 = 행수 - 1. }
    정수 x바탕0 = i0 * 깊이.
    짧은실수 영 = 0 으로 짧은실수.
    짧은실수 a0 = 영.
    짧은실수 w0 = 영.
    짧은실수 w1 = 영.
    짧은실수 w2 = 영.
    짧은실수 w3 = 영.
    짧은실수 w4 = 영.

        a0 = 곱해더하기(입력[x바탕0 + k + 104], w26, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 108], w27, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 112], w28, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 116], w29, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 120], w30, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 124], w31, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 128], w32, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 132], w33, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 136], w34, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 140], w35, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 144], w36, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 148], w37, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 152], w38, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 156], w39, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 160], w40, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 164], w41, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 168], w42, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 172], w43, a0).
        a0 = 곱해더하기(입력[x바탕0 + k + 176], w44, a0).

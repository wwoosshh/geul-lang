        동기화().
        tid < 64이면 {
            행 = m0 + tid.
            행 < 끝m이면 {
                큰 = 판[8704 + tid * 17].
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 1]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 2]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 3]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 4]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 5]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 6]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 7]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 8]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 9]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 10]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 11]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 12]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 13]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 14]).
                큰 = 큰쪽(큰, 판[8704 + tid * 17 + 15]).
                최대칸[((행바탕 + 행) * 12 + 머리) * 조각수 + 키조각] = 큰.
            }
        }
    }
}

(* 어텐션 (나) — 블록 하나가 (머리, 질의 32 개)의 지수·합·가중합. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 가중합타일 256 2 *)
[짧은실수 참조 점수칸에서 짧은실수 참조 최대칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 가중합타일]는 {
    정수 tid = 블록안가로().
    정수 머리 = 블록가로().
    정수 조각수 = (묶음안행수 + 31) / 32.
    정수 문장 = 블록세로() / 조각수.
    정수 m0 = (조각수 - 1 - 블록세로() % 조각수) * 32.
    정수 끝m = m0 + 32.
    끝m > 묶음안행수이면 { 끝m = 묶음안행수. }
    정수 끝위치 = 위치시작 + 끝m - 1.
    정수 조각끝 = 끝위치 / 32.
    정수 캐시 = 문장 * 최대길이 * 768 + 머리 * 64.
    정수 행바탕 = 문장 * 묶음안행수.
    정수 큰조각수 = 최대길이 / 64.
    짧은실수 참조 판 = 공유판24().
    정수 qp = tid / 16.
    정수 dg = tid % 16.
    (* P 를 채우는 일: 스레드 (pi = tid/8, pj = tid%8) 가 질의 pi 의 키 pj + 8r *)
    정수 pi = tid / 8.
    정수 pj = tid % 8.
    정수 p내m = m0 + pi.
    p내m >= 끝m이면 { p내m = 끝m - 1. }
    정수 p위치 = 위치시작 + p내m.
    정수 점수줄 = ((행바탕 + p내m) * 12 + 머리) * 최대길이.
    정수 최대줄 = ((행바탕 + p내m) * 12 + 머리) * 큰조각수.
    짧은실수 큰값 = 최대칸[최대줄].
    반복 (정수 c = 1: c <= p위치 / 64: c += 1) { 큰값 = 큰쪽(큰값, 최대칸[최대줄 + c]). }
    정수 내m0 = m0 + 2 * qp + 0.
    정수 쓸것0 = 1.
    내m0 >= 끝m이면 { 내m0 = 끝m - 1. 쓸것0 = 0. }
    정수 내위치0 = 위치시작 + 내m0.
    정수 n유효0 = 0.
    정수 내m1 = m0 + 2 * qp + 1.
    정수 쓸것1 = 1.
    내m1 >= 끝m이면 { 내m1 = 끝m - 1. 쓸것1 = 0. }
    정수 내위치1 = 위치시작 + 내m1.
    정수 n유효1 = 0.
    정수 옮줄 = tid / 16.
    정수 옮칸 = (tid % 16) * 4.
    정수 vp = 0.
    정수 pq = pi * 40.
    정수 pr0 = (2 * qp) * 40.
    정수 pr1 = (2 * qp + 1) * 40.

        판[가닥 * 4352 + (32 + ty * 4 + 0) * 68 + 32 + tx * 4 + 2] = a4_6.
        판[가닥 * 4352 + (32 + ty * 4 + 0) * 68 + 32 + tx * 4 + 3] = a4_7.
        판[가닥 * 4352 + (32 + ty * 4 + 1) * 68 + tx * 4 + 0] = a5_0.
        판[가닥 * 4352 + (32 + ty * 4 + 1) * 68 + tx * 4 + 1] = a5_1.
        판[가닥 * 4352 + (32 + ty * 4 + 1) * 68 + tx * 4 + 2] = a5_2.
        판[가닥 * 4352 + (32 + ty * 4 + 1) * 68 + tx * 4 + 3] = a5_3.
        판[가닥 * 4352 + (32 + ty * 4 + 1) * 68 + 32 + tx * 4 + 0] = a5_4.
        판[가닥 * 4352 + (32 + ty * 4 + 1) * 68 + 32 + tx * 4 + 1] = a5_5.
        판[가닥 * 4352 + (32 + ty * 4 + 1) * 68 + 32 + tx * 4 + 2] = a5_6.
        판[가닥 * 4352 + (32 + ty * 4 + 1) * 68 + 32 + tx * 4 + 3] = a5_7.
        판[가닥 * 4352 + (32 + ty * 4 + 2) * 68 + tx * 4 + 0] = a6_0.
        판[가닥 * 4352 + (32 + ty * 4 + 2) * 68 + tx * 4 + 1] = a6_1.
        판[가닥 * 4352 + (32 + ty * 4 + 2) * 68 + tx * 4 + 2] = a6_2.
        판[가닥 * 4352 + (32 + ty * 4 + 2) * 68 + tx * 4 + 3] = a6_3.
        판[가닥 * 4352 + (32 + ty * 4 + 2) * 68 + 32 + tx * 4 + 0] = a6_4.
        판[가닥 * 4352 + (32 + ty * 4 + 2) * 68 + 32 + tx * 4 + 1] = a6_5.
        판[가닥 * 4352 + (32 + ty * 4 + 2) * 68 + 32 + tx * 4 + 2] = a6_6.
        판[가닥 * 4352 + (32 + ty * 4 + 2) * 68 + 32 + tx * 4 + 3] = a6_7.
        판[가닥 * 4352 + (32 + ty * 4 + 3) * 68 + tx * 4 + 0] = a7_0.

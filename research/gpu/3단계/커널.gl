        짧은실수 합 = (l0 + l2) + (l1 + l3).
        출력[(행바탕 + 내m) * 768 + 머리 * 64 + tj * 4 + 0] = ((o0_0 + o2_0) + (o1_0 + o3_0)) / 합.
        출력[(행바탕 + 내m) * 768 + 머리 * 64 + tj * 4 + 1] = ((o0_1 + o2_1) + (o1_1 + o3_1)) / 합.
        출력[(행바탕 + 내m) * 768 + 머리 * 64 + tj * 4 + 2] = ((o0_2 + o2_2) + (o1_2 + o3_2)) / 합.
        출력[(행바탕 + 내m) * 768 + 머리 * 64 + tj * 4 + 3] = ((o0_3 + o2_3) + (o1_3 + o3_3)) / 합.
    }
}

(* 블록 하나가 (머리, 한 문장의 질의 32 개) — 키·값 조각 32 개씩을 두 판에 번갈아 올린다. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 타일어텐션32 256 2 *)

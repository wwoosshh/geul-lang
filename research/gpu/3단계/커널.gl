        판[4096 + 가닥 * 1056 + (ty * 4 + 3) * 33 + tx * 4 + 2] = a3_2.
        판[4096 + 가닥 * 1056 + (ty * 4 + 3) * 33 + tx * 4 + 3] = a3_3.
    }
    동기화().
    정수 행 = 0.
    정수 열 = 0.
    정수 자리 = 0.
    정수 칸 = 0.
    짧은실수 v = 영.
    짧은실수 u = 영.
    짧은실수 th = 영.
    반복 (정수 m는 0부터 4 전까지) {
        칸 = m * 256 + tid.
        행 = 행0 + 칸 / 32.
        열 = 열0 + 칸 % 32.
        (행 < 행수 그리고 열 < 열수)이면 {
            v = (판[4096 + (칸 / 32) * 33 + 칸 % 32] + 판[5152 + (칸 / 32) * 33 + 칸 % 32]) + 치우침[열].
            출력[행 * 열수 + 열] = v.
        }

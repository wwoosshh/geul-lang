        w14 = 가중치[(k + 56) * 열수 + c].
        w15 = 가중치[(k + 60) * 열수 + c].
        a0 = 곱해더하기(입력[x바탕0 + k + 0], w0, a0).
        a1 = 곱해더하기(입력[x바탕1 + k + 0], w0, a1).
        a2 = 곱해더하기(입력[x바탕2 + k + 0], w0, a2).

    짧은실수 참조 판 = 공유판4().
    가닥 >= 2이면 {
        판[((가닥 - 2) * 4 + 0) * 32 + tx] = a0.
        판[((가닥 - 2) * 4 + 1) * 32 + tx] = a1.
        판[((가닥 - 2) * 4 + 2) * 32 + tx] = a2.
        판[((가닥 - 2) * 4 + 3) * 32 + tx] = a3.
    }

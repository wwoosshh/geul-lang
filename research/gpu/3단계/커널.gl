    }
    판[1024 + tid] = 내큰값.
    동기화().
    반복 (정수 접기 = 128: 접기 > 0: 접기 /= 2) {
        tid < 접기이면 { 판[1024 + tid] = 큰쪽(판[1024 + tid], 판[1024 + tid + 접기]). }
        동기화().
    }
    짧은실수 큰값 = 판[1024].
    동기화().
    반복 (정수 t = tid: t <= 위치: t += 256) { 판[t] = 근사지수(판[t] - 큰값). }
    동기화().
    정수 j = tid / 64.
    정수 d = tid % 64.
    짧은실수 o = 0 으로 짧은실수.
    짧은실수 l = 0 으로 짧은실수.
    정수 t = j.
    반복 (: t + 12 <= 위치: t += 16) {
        짧은실수 p0 = 판[t + 0].
        짧은실수 p1 = 판[t + 4].
        짧은실수 p2 = 판[t + 8].
        짧은실수 p3 = 판[t + 12].
        짧은실수 v0 = 값칸[캐시 + (t + 0) * 768 + d].
        짧은실수 v1 = 값칸[캐시 + (t + 4) * 768 + d].
        짧은실수 v2 = 값칸[캐시 + (t + 8) * 768 + d].
        짧은실수 v3 = 값칸[캐시 + (t + 12) * 768 + d].
        o = 곱해더하기(p0, v0, o).
        l = l + p0.
        o = 곱해더하기(p1, v1, o).
        l = l + p1.
        o = 곱해더하기(p2, v2, o).
        l = l + p2.
        o = 곱해더하기(p3, v3, o).
        l = l + p3.
    }
    반복 (: t <= 위치: t += 4) {
        짧은실수 p = 판[t].
        o = 곱해더하기(p, 값칸[캐시 + t * 768 + d], o).
        l = l + p.
    }
    판[1024 + tid] = o.
    d == 0이면 { 판[1344 + j] = l. }
    동기화().
    tid < 64이면 {
        짧은실수 합 = (판[1344] + 판[1346]) + (판[1345] + 판[1347]).
        출력[행 * 768 + 머리 * 64 + tid] = ((판[1024 + tid] + 판[1152 + tid]) + (판[1088 + tid] + 판[1216 + tid])) / 합.
    }
}

(* 블록 하나가 (머리, 한 문장의 질의 16 개) — 키·값 조각 32 개씩을 두 판에 번갈아 올린다. 순서 약속은 커널생성.py 의 설명 *)
(* 실행한도 타일어텐션 256 2 *)
[짧은실수 참조 q에서 짧은실수 참조 키칸과 짧은실수 참조 값칸과 짧은실수 참조 출력에 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 타일어텐션]는 {
    정수 tid = 블록안가로().
    정수 머리 = 블록가로().
    정수 조각수 = (묶음안행수 + 15) / 16.
    정수 문장 = 블록세로() / 조각수.
    정수 m0 = (블록세로() % 조각수) * 16.
    정수 끝m = m0 + 16.
    끝m > 묶음안행수이면 { 끝m = 묶음안행수. }
    정수 qi = tid / 16.
    정수 tj = tid % 16.
    정수 내m = m0 + qi.
    정수 쓸것 = 1.

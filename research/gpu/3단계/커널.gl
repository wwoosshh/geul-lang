        a3_3 = a3_3 + 판[1920 + 가닥 * 64 + t64].
    }
    동기화().
    가닥 < 2이면 {
        판[4096 + 가닥 * 1056 + (ty * 4 + 0) * 33 + tx * 4 + 0] = a0_0.
        판[4096 + 가닥 * 1056 + (ty * 4 + 0) * 33 + tx * 4 + 1] = a0_1.
        판[4096 + 가닥 * 1056 + (ty * 4 + 0) * 33 + tx * 4 + 2] = a0_2.

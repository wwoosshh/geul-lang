                    짧은실수 x7_2 = 숨칸[tid + 736].
                    짧은실수 p7 = ((영 + x7_0) + x7_1) + x7_2.
                    짧은실수 합 = ((p0 + p4) + (p2 + p6)) + ((p1 + p5) + (p3 + p7)).
                    합 = 합 + 아래에서받기(합, 16).
                    합 = 합 + 아래에서받기(합, 8).
                    합 = 합 + 아래에서받기(합, 4).
                    합 = 합 + 아래에서받기(합, 2).
                    합 = 합 + 아래에서받기(합, 1).
                    합 = 레인에서받기(합, 0).
                    짧은실수 평균0 = 합 / 768.0.
                    짧은실수 e0_0 = x0_0 - 평균0.
                    짧은실수 e0_1 = x0_1 - 평균0.
                    짧은실수 e0_2 = x0_2 - 평균0.
                    짧은실수 r0 = ((영 + e0_0 * e0_0) + e0_1 * e0_1) + e0_2 * e0_2.
                    짧은실수 e1_0 = x1_0 - 평균0.
                    짧은실수 e1_1 = x1_1 - 평균0.
                    짧은실수 e1_2 = x1_2 - 평균0.
                    짧은실수 r1 = ((영 + e1_0 * e1_0) + e1_1 * e1_1) + e1_2 * e1_2.
                    짧은실수 e2_0 = x2_0 - 평균0.
                    짧은실수 e2_1 = x2_1 - 평균0.
                    짧은실수 e2_2 = x2_2 - 평균0.
                    짧은실수 r2 = ((영 + e2_0 * e2_0) + e2_1 * e2_1) + e2_2 * e2_2.
                    짧은실수 e3_0 = x3_0 - 평균0.
                    짧은실수 e3_1 = x3_1 - 평균0.
                    짧은실수 e3_2 = x3_2 - 평균0.
                    짧은실수 r3 = ((영 + e3_0 * e3_0) + e3_1 * e3_1) + e3_2 * e3_2.

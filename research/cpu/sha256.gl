(* SHA-256 — GeulPU 의 호스트/해시.gl 을 그대로 옮긴 것(64 비트 정수 + 32 비트 가리개, 상수는 정수목록).
   64 MB 의 정해진 바이트를 해시한다. 짝: sha256.c (같은 알고리즘을 C 로 그대로) *)
포함 "표준/목록.gl"

정수목록 참조 해시K.
상수 정수 낱말틀 = 4294967295.

[문자열 글을 정수목록 참조 목록에 십육진낱말들]는 {
    정수 v = 0.
    정수 자리 = 0.
    반복 (정수 k = 0: 글[k] != 0: k += 1) {
        정수 c = 글[k] & 255.
        정수 d = -1.
        (c >= 48 그리고 c <= 57)이면 { d = c - 48. }
        (c >= 97 그리고 c <= 102)이면 { d = c - 87. }
        (c >= 65 그리고 c <= 70)이면 { d = c - 55. }
        d >= 0이면 { v = v * 16 + d. 자리 += 1. }
        아니면 자리 > 0이면 { 정수목록_추가(목록, v). v = 0. 자리 = 0. }
    }
    자리 > 0이면 { 정수목록_추가(목록, v). }
}

[해시준비]는 {
    해시K != 없음이면 { 반환. }
    해시K = 정수목록_만들기().
    십육진낱말들("428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174", 해시K).
    십육진낱말들("e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967", 해시K).
    십육진낱말들("27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070", 해시K).
    십육진낱말들("19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2", 해시K).
}

[정수 x를 정수 n을 오른돌림]는 -> 정수 { 반환 ((x >> n) | (x << (32 - n))) & 낱말틀. }

[정수 참조 h를 문자열 블록을 해시블록]는 {
    정수[64] w.
    반복 (정수 i는 0부터 16 전까지) {
        w[i] = ((블록[4 * i] & 255) << 24) | ((블록[4 * i + 1] & 255) << 16) | ((블록[4 * i + 2] & 255) << 8) | (블록[4 * i + 3] & 255).
    }
    반복 (정수 i2는 16부터 64 전까지) {
        정수 a = w[i2 - 15].
        정수 b = w[i2 - 2].
        정수 s0 = 오른돌림(a, 7) ^ 오른돌림(a, 18) ^ (a >> 3).
        정수 s1 = 오른돌림(b, 17) ^ 오른돌림(b, 19) ^ (b >> 10).
        w[i2] = (w[i2 - 16] + s0 + w[i2 - 7] + s1) & 낱말틀.
    }
    정수 A = h[0]. 정수 B = h[1]. 정수 C = h[2]. 정수 D = h[3].
    정수 E = h[4]. 정수 F = h[5]. 정수 G = h[6]. 정수 H = h[7].
    반복 (정수 t는 0부터 64 전까지) {
        정수 S1 = 오른돌림(E, 6) ^ 오른돌림(E, 11) ^ 오른돌림(E, 25).
        정수 ch = (E & F) ^ ((E ^ 낱말틀) & G).
        정수 t1 = (H + S1 + ch + 정수목록_값(해시K, t) + w[t]) & 낱말틀.
        정수 S0 = 오른돌림(A, 2) ^ 오른돌림(A, 13) ^ 오른돌림(A, 22).
        정수 maj = (A & B) ^ (A & C) ^ (B & C).
        정수 t2 = (S0 + maj) & 낱말틀.
        H = G. G = F. F = E.
        E = (D + t1) & 낱말틀.
        D = C. C = B. B = A.
        A = (t1 + t2) & 낱말틀.
    }
    h[0] = (h[0] + A) & 낱말틀. h[1] = (h[1] + B) & 낱말틀. h[2] = (h[2] + C) & 낱말틀. h[3] = (h[3] + D) & 낱말틀.
    h[4] = (h[4] + E) & 낱말틀. h[5] = (h[5] + F) & 낱말틀. h[6] = (h[6] + G) & 낱말틀. h[7] = (h[7] + H) & 낱말틀.
}

묶음 해시틀은 정수[8] h, 정수 전체, 정수 남은수, 문자[64] 남은.

[해시틀 참조 s를 해시시작]는 {
    해시준비().
    s→h[0] = 1779033703. s→h[1] = 3144134277. s→h[2] = 1013904242. s→h[3] = 2773480762.
    s→h[4] = 1359893119. s→h[5] = 2600822924. s→h[6] = 528734635. s→h[7] = 1541459225.
    s→전체 = 0.
    s→남은수 = 0.
}

[해시틀 참조 s를 공허 참조 자료를 정수 길이를 해시더하기]는 {
    문자열 d = 자료 으로 문자열.
    정수 k = 0.
    s→전체 = s→전체 + 길이.
    (s→남은수 > 0 그리고 k < 길이)동안 {
        s→남은[s→남은수] = d[k].
        s→남은수 += 1.
        k += 1.
        s→남은수 == 64이면 { 해시블록(s→h, s→남은). s→남은수 = 0. }
    }
    (k + 64 <= 길이)동안 {
        해시블록(s→h, d + k).
        k += 64.
    }
    (k < 길이)동안 {
        s→남은[s→남은수] = d[k].
        s→남은수 += 1.
        k += 1.
    }
}

[해시틀 참조 s를 해시끝]는 -> 문자열 {
    정수 비트 = s→전체 * 8.
    문자[128] 꼬리.
    정수 n = 0.
    꼬리[n] = -128. n += 1.
    ((s→남은수 + n) % 64 != 56)동안 { 꼬리[n] = 0. n += 1. }
    반복 (정수 j는 0부터 8 전까지) { 꼬리[n] = (비트 >> (56 - 8 * j)) & 255. n += 1. }
    정수 앞전체 = s→전체.
    해시더하기(s, 꼬리, n).
    s→전체 = 앞전체.
    문자열 답글 = 할당(65).
    문자열 수 = "0123456789abcdef".
    반복 (정수 i는 0부터 8 전까지) {
        반복 (정수 b는 0부터 8 전까지) { 답글[i * 8 + b] = 수[(s→h[i] >> (28 - 4 * b)) & 15]. }
    }
    답글[64] = 0.
    반환 답글.
}

[시작하기]는 -> 정수 {
    정수 n = 67108864.
    문자열 버퍼 = 할당(n).
    반복 (정수 i는 0부터 n 전까지) { 버퍼[i] = ((i * 2654435761) >> 13) & 255. }
    해시틀 s.
    해시시작(&s).
    해시더하기(&s, 버퍼, n).
    "{해시끝(&s)}\n"을 쓰다.
    반환 0.
}

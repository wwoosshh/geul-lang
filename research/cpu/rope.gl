(* RoPE 표 — GeulPU 의 호스트/로프.gl(커밋 0399de4)을 그대로 옮긴 것에 재기의 시작을 붙였다. 짝: rope.c (같은 알고리즘을 C 로 그대로).
   두 배 정밀도 실수와 큰 정수(원주율), fp64 다항식의 빠른 길과 바른 반올림 — GeulPU 가 7B 를 올릴 때 CPU 에서 하는 일이다. *)
포함 "표준/수학.gl"
포함 "표준/입출력.gl"

(* RoPE 표 — 계약/정수계약.rope표 와 같은 정의를 글 언어로(GeulPU 18단계):
     θ_i = θ^(−2i/64) 를 fp64 로 바르게 반올림, 각 = 위치 · θ_i (fp64 곱 하나), cos(각) · sin(각) 을 짧은실수로 바르게 반올림.
   파이썬판은 numpy 의 fp64 로 구하고 경계에 가까운 것만 decimal(60 · 80 자리)로 다시 구한다. 여기서도 같은 꼴: 먼저 fp64 다항식과 그
   엄밀한 오차 한계로(빠른 길 — 18단계 뒤), 한계 안에 반올림의 경계가 들면 두 배 정밀도 실수(double-double — 실수 둘의 합, 약 104 비트)로
   계산하고, 거기서도 경계에 너무 가까우면 멈춘다 — 조용히 다른 값을 내지 않는다. 원주율은 큰 정수(32 비트 낱말들)로 마친의 식에서 구한다.

   두 배 정밀도의 연산: 오차 없는 합 · 곱(Knuth TwoSum, Dekker TwoProduct — 융합 곱셈 없이 쪼개기로), 정확한 더하기(Joldes · Muller ·
   Popescu 2017 의 AccurateDWPlusDW — 결과에 대한 상대 오차 3u²), 곱하기 · 나누기(QD 라이브러리의 꼴). *)

묶음 겹은 실수 위, 실수 아래.

(* ---- 오차 없는 변환 ---- *)
[겹 참조 r를 실수 a를 실수 b를 겹합]는 {
    실수 s = a + b.
    실수 bb = s - a.
    r→위 = s.
    r→아래 = (a - (s - bb)) + (b - bb).
}

[겹 참조 r를 실수 a를 실수 b를 빠른합]는 {
    실수 s = a + b.
    r→위 = s.
    r→아래 = b - (s - a).
}

[겹 참조 r를 실수 a를 실수 b를 겹곱]는 {
    실수 p = a * b.
    실수 ta = 134217729.0 * a.
    실수 ah = ta - (ta - a).
    실수 al = a - ah.
    실수 tb = 134217729.0 * b.
    실수 bh = tb - (tb - b).
    실수 bl = b - bh.
    r→위 = p.
    r→아래 = ((ah * bh - p) + ah * bl + al * bh) + al * bl.
}

(* ---- 두 배 정밀도 연산 (r 은 a · b 와 같은 자리여도 된다) ---- *)
[겹 참조 r를 겹 참조 a를 겹 참조 b를 겹더하기]는 {
    겹 s.
    겹 t.
    겹합(&s, a→위, b→위).
    겹합(&t, a→아래, b→아래).
    실수 c = s→아래 + t→위.
    겹 v.
    빠른합(&v, s→위, c).
    실수 w = t→아래 + v→아래.
    빠른합(r, v→위, w).
}

[겹 참조 r를 겹 참조 a를 겹 참조 b를 겹빼기]는 {
    겹 nb.
    nb→위 = 0.0 - b→위.
    nb→아래 = 0.0 - b→아래.
    겹더하기(r, a, &nb).
}

[겹 참조 r를 겹 참조 a를 겹 참조 b를 겹곱하기]는 {
    겹 p.
    겹곱(&p, a→위, b→위).
    실수 e = p→아래 + (a→위 * b→아래 + a→아래 * b→위).
    빠른합(r, p→위, e).
}

[겹 참조 r를 겹 참조 a를 실수 d를 겹실곱]는 {
    겹 p.
    겹곱(&p, a→위, d).
    실수 e = p→아래 + a→아래 * d.
    빠른합(r, p→위, e).
}

(* QD 의 정확한 나눗셈: q1 = a/b, 나머지로 q2 · q3 *)
[겹 참조 r를 겹 참조 a를 겹 참조 b를 겹나누기]는 {
    실수 q1 = a→위 / b→위.
    겹 t.
    겹실곱(&t, b, q1).
    겹 rr.
    겹빼기(&rr, a, &t).
    실수 q2 = rr→위 / b→위.
    겹실곱(&t, b, q2).
    겹빼기(&rr, &rr, &t).
    실수 q3 = rr→위 / b→위.
    겹 q.
    빠른합(&q, q1, q2).
    겹 q3겹.
    q3겹→위 = q3.
    q3겹→아래 = 0.0.
    겹더하기(r, &q, &q3겹).
}

[겹 참조 r를 실수 a를 겹값]는 { r→위 = a. r→아래 = 0.0. }

[겹 참조 r를 겹 참조 a를 실수 d를 겹실나누기]는 {
    겹 b.
    b→위 = d.
    b→아래 = 0.0.
    겹나누기(r, a, &b).
}

(* ---- 큰 정수 고정소수점 (원주율) — 낱말 0 은 정수 부분, 낱말 1 … 8 은 소수 부분(32 비트씩, 256 비트) ---- *)
상수 정수 큰낱말수 = 9.

[정수 참조 a를 큰영]는 { 반복 (정수 i는 0부터 큰낱말수 전까지) { a[i] = 0. } }

[정수 참조 a를 큰영인가]는 -> 참거짓 {
    반복 (정수 i는 0부터 큰낱말수 전까지) { a[i] != 0이면 { 반환 거짓. } }
    반환 참.
}

[정수 참조 a를 정수 d를 큰나누기작은]는 {
    정수 나머지 = 0.
    반복 (정수 i는 0부터 큰낱말수 전까지) {
        정수 cur = (나머지 << 32) + a[i].
        a[i] = cur / d.
        나머지 = cur % d.
    }
}

[정수 참조 a를 정수 참조 b를 큰더하기]는 {
    정수 올림 = 0.
    반복 (정수 i = 큰낱말수 - 1: i >= 0: i -= 1) {
        정수 s = a[i] + b[i] + 올림.
        a[i] = s & 4294967295.
        올림 = s >> 32.
    }
}

[정수 참조 a를 정수 참조 b를 큰빼기]는 {
    정수 빌림 = 0.
    반복 (정수 i = 큰낱말수 - 1: i >= 0: i -= 1) {
        정수 s = a[i] - b[i] - 빌림.
        빌림 = 0.
        s < 0이면 { s = s + 4294967296. 빌림 = 1. }
        a[i] = s.
    }
}

[정수 참조 a를 정수 m을 큰곱작은]는 {
    정수 올림 = 0.
    반복 (정수 i = 큰낱말수 - 1: i >= 0: i -= 1) {
        정수 s = a[i] * m + 올림.
        a[i] = s & 4294967295.
        올림 = s >> 32.
    }
}

(* atan(1/x) = Σ (−1)^j / ((2j+1) x^(2j+1)) *)
[정수 참조 합을 정수 x를 큰아크탄]는 {
    정수[9] 거듭.
    정수[9] 항.
    큰영(거듭).
    거듭[0] = 1.
    큰나누기작은(거듭, x).
    큰영(합).
    큰더하기(합, 거듭).
    정수 j = 1.
    (참)동안 {
        큰나누기작은(거듭, x * x).
        반복 (정수 i는 0부터 큰낱말수 전까지) { 항[i] = 거듭[i]. }
        큰나누기작은(항, 2 * j + 1).
        큰영인가(항)이면 { 탈출. }
        j % 2 == 1이면 { 큰빼기(합, 항). } 아니면 { 큰더하기(합, 항). }
        j += 1.
    }
}

(* 비트 n: n = 0 은 2⁰ (낱말 0 의 맨 아래), n ≥ 1 은 2^(−n) *)
[정수 참조 a를 정수 n을 큰비트]는 -> 정수 {
    n == 0이면 { 반환 a[0] & 1. }
    반환 (a[(n - 1) / 32 + 1] >> (31 - (n - 1) % 32)) & 1.
}

[정수 참조 a를 정수 n을 큰비트끄기]는 {
    n == 0이면 { a[0] = a[0] & (0 - 2). 반환. }
    정수 i = (n - 1) / 32 + 1.
    a[i] = a[i] & (4294967295 ^ (1 << (31 - (n - 1) % 32))).
}

(* 값의 맨 위 비트수 비트를 실수로(잘라서 — 정확한 실수) 떼어 내고 큰 수에서 지운다 *)
[정수 참조 a를 정수 비트수를 큰위비트떼기]는 -> 실수 {
    정수 n0 = 0.
    (n0 <= 256 그리고 큰비트(a, n0) == 0)동안 { n0 += 1. }
    n0 > 256이면 { 반환 0.0. }
    정수 M = 0.
    반복 (정수 j는 0부터 비트수 전까지) {
        정수 n = n0 + j.
        정수 b = 0.
        n <= 256이면 { b = 큰비트(a, n). }
        M = (M << 1) | b.
        (n <= 256 그리고 b == 1)이면 { 큰비트끄기(a, n). }
    }
    반환 이진스케일(M 으로 실수, 0 - n0 - (비트수 - 1)).
}

[정수 참조 a를 큰위실수떼기]는 -> 실수 { 반환 큰위비트떼기(a, 53). }

(* π/2 를 실수 넷의 합으로(약 212 비트) *)
실수 반파이1 = 0.0. 실수 반파이2 = 0.0. 실수 반파이3 = 0.0. 실수 반파이4 = 0.0.
겹 반파이겹.
겹 겹로그2.
(* 빠른 길의 π/2 — 36 비트 · 36 비트 · 53 비트 (위치 < 2^17 이면 k · 앞의 둘은 정확한 곱) *)
실수 빠른반파이1 = 0.0. 실수 빠른반파이2 = 0.0. 실수 빠른반파이3 = 0.0.

[원주율준비]는 {
    정수[9] a.
    정수[9] b.
    큰아크탄(a, 5).
    큰곱작은(a, 16).
    큰아크탄(b, 239).
    큰곱작은(b, 4).
    큰빼기(a, b).                   (* π *)
    큰나누기작은(a, 2).              (* π/2 *)
    정수[9] c.
    반복 (정수 i는 0부터 큰낱말수 전까지) { c[i] = a[i]. }
    빠른반파이1 = 큰위비트떼기(c, 36).
    빠른반파이2 = 큰위비트떼기(c, 36).
    빠른반파이3 = 큰위비트떼기(c, 53).
    반파이1 = 큰위실수떼기(a).
    반파이2 = 큰위실수떼기(a).
    반파이3 = 큰위실수떼기(a).
    반파이4 = 큰위실수떼기(a).
    빠른합(&반파이겹, 반파이1, 반파이2).
    (* ln 2 = 2 atanh(1/3) = 2 Σ (1/3)^(2j+1) / (2j+1) — 두 배 정밀도로 *)
    겹 t.
    겹 하나.
    겹값(&하나, 1.0).
    겹실나누기(&t, &하나, 3.0).
    겹 t2.
    겹곱하기(&t2, &t, &t).
    겹 거듭.
    거듭→위 = t→위. 거듭→아래 = t→아래.
    겹 합.
    합→위 = t→위. 합→아래 = t→아래.
    반복 (정수 j는 1부터 40 전까지) {
        겹곱하기(&거듭, &거듭, &t2).
        겹 항.
        겹실나누기(&항, &거듭, (2 * j + 1) 으로 실수).
        겹더하기(&합, &합, &항).
    }
    겹실곱(&겹로그2, &합, 2.0).
}

(* ---- 두 배 정밀도의 exp · ln (QD 의 꼴) ---- *)
[겹 참조 r를 겹 참조 a를 겹지수]는 {
    a→위 == 0.0이면 { 겹값(r, 1.0). 반환. }
    실수 m = 내림(a→위 / 겹로그2→위 + 0.5).
    겹 s.
    겹실곱(&s, &겹로그2, m).
    겹 x.
    겹빼기(&x, a, &s).
    겹실곱(&x, &x, 1.0 / 512.0).      (* r = (a − m ln2) / 512 — 2 의 거듭제곱이라 정확하다 *)
    (* exp(x) − 1 = x + x²/2 + x³/6 + … *)
    겹 합.
    합→위 = x→위. 합→아래 = x→아래.
    겹 항.
    항→위 = x→위. 항→아래 = x→아래.
    반복 (정수 n은 2부터 20 전까지) {
        겹곱하기(&항, &항, &x).
        겹실나누기(&항, &항, n 으로 실수).
        겹더하기(&합, &합, &항).
    }
    (* (1 + s)^512: s ← 2s + s² 를 아홉 번 *)
    반복 (정수 i는 0부터 9 전까지) {
        겹 제곱.
        겹곱하기(&제곱, &합, &합).
        겹실곱(&합, &합, 2.0).
        겹더하기(&합, &합, &제곱).
    }
    겹 하나.
    겹값(&하나, 1.0).
    겹더하기(&합, &합, &하나).
    r→위 = 이진스케일(합→위, m 으로 정수).
    r→아래 = 이진스케일(합→아래, m 으로 정수).
}

(* ln(a) — 뉴턴: y ← y + a · exp(−y) − 1 (세 번) *)
[겹 참조 r를 겹 참조 a를 겹로그]는 {
    겹 y.
    겹값(&y, 자연로그(a→위)).
    반복 (정수 i는 0부터 3 전까지) {
        겹 ny.
        ny→위 = 0.0 - y→위. ny→아래 = 0.0 - y→아래.
        겹 e.
        겹지수(&e, &ny).
        겹 t.
        겹곱하기(&t, a, &e).
        겹 하나.
        겹값(&하나, 1.0).
        겹빼기(&t, &t, &하나).
        겹더하기(&y, &y, &t).
    }
    r→위 = y→위. r→아래 = y→아래.
}

(* ---- 바른 반올림 ---- *)
정수 어려운경우 = 0.          (* 경계에 너무 가까워 정할 수 없었던 수 — 0 이어야 한다 *)

(* 두 배 정밀도 v(상대 오차 ≤ 2^-90 로 보장된 것)를 실수(fp64)로 바르게 반올림 *)
[겹 참조 v를 실수로반올림]는 -> 실수 {
    (* v 는 빠른합으로 정규화되어 있다: 위 = RN(위 + 아래). 아래가 반 ulp 에 아주 가까우면 경계 *)
    실수 위 = v→위.
    실수 반ulp = 실수_절댓값(위) * 1.1102230246251565e-16.     (* 2^-53 · |위| — 위의 ulp 의 반 이하 *)
    실수 경계 = 실수_절댓값(위) * 8.077935669463161e-28.        (* 2^-90 · |위| *)
    (실수_절댓값(실수_절댓값(v→아래) - 반ulp) <= 경계 또는 실수_절댓값(v→아래) > 반ulp * 2.0)이면 { 어려운경우 += 1. }
    반환 위.
}

[실수 x를 짧은위]는 -> 짧은실수 {
    짧은실수 f = x 으로 짧은실수.
    반환 f.
}

(* 짧은실수 f 의 다음 위 · 아래 짧은실수 (유한한 0 이 아닌 수) *)
합침 짧은비트는 짧은실수 f, 중간정수 i.

[짧은실수 f를 정수 방향을 짧은이웃]는 -> 짧은실수 {
    짧은비트 u.
    u의 f = f.
    (* 양수: 위 = 비트 + 1, 음수: 위 = 비트 − 1 *)
    정수 b = u의 i.
    f > 0.0이면 { b = b + 방향. } 아니면 { b = b - 방향. }
    u의 i = b.
    반환 u의 f.
}

(* 두 배 정밀도 v(상대 오차 ≤ 2^-90)를 짧은실수로 바르게 반올림 *)
[겹 참조 v를 짧은로반올림]는 -> 짧은실수 {
    실수 위 = v→위.
    위 == 0.0이면 { 반환 0.0 으로 짧은실수. }
    짧은실수 t = 위 으로 짧은실수.
    실수 t64 = t 으로 실수.
    t64 == 위이면 { 반환 t. }          (* 위가 짧은실수다 — 아래(|아래| ≤ 반 ulp64)로는 반올림이 바뀌지 않는다 *)
    짧은실수 다른 = t.
    t64 < 위이면 { 다른 = 짧은이웃(t, 1). } 아니면 { 다른 = 짧은이웃(t, -1). }
    (위 < 0.0)이면 {
        t64 < 위이면 { 다른 = 짧은이웃(t, -1). } 아니면 { 다른 = 짧은이웃(t, 1). }
    }
    실수 다른64 = 다른 으로 실수.
    실수 가운데 = (t64 + 다른64) * 0.5.
    실수 d = (위 - 가운데) + v→아래.
    실수 경계 = 실수_절댓값(위) * 8.077935669463161e-28.
    실수_절댓값(d) <= 경계이면 { 어려운경우 += 1. }
    (* v > 가운데 면 둘 중 큰 쪽, 아니면 작은 쪽 *)
    d > 0.0이면 {
        t64 > 다른64이면 { 반환 t. }
        반환 다른.
    }
    t64 < 다른64이면 { 반환 t. }
    반환 다른.
}

(* ---- cos · sin (실수 x ≥ 0) — 두 배 정밀도 ---- *)
겹 로프cos.
겹 로프sin.

[실수 x를 겹삼각]는 {
    x == 0.0이면 { 겹값(&로프cos, 1.0). 겹값(&로프sin, 0.0). 반환. }
    실수 k = 내림(x * 0.6366197723675814 + 0.5).           (* 2/π *)
    정수 q = (k 으로 정수) % 4.
    (* r = x − k · (π/2 의 네 조각) — 조각마다 오차 없는 곱 *)
    겹 r.
    겹값(&r, x).
    겹 p.
    겹곱(&p, k, 반파이1). 겹빼기(&r, &r, &p).
    겹곱(&p, k, 반파이2). 겹빼기(&r, &r, &p).
    겹곱(&p, k, 반파이3). 겹빼기(&r, &r, &p).
    겹곱(&p, k, 반파이4). 겹빼기(&r, &r, &p).
    겹 r2.
    겹곱하기(&r2, &r, &r).
    (* sin r = r − r³/3! + …, cos r = 1 − r²/2! + … *)
    겹 s. s→위 = r→위. s→아래 = r→아래.
    겹 c. 겹값(&c, 1.0).
    겹 ts. ts→위 = r→위. ts→아래 = r→아래.
    겹 tc. 겹값(&tc, 1.0).
    반복 (정수 j는 1부터 18 전까지) {
        겹곱하기(&ts, &ts, &r2).
        겹실나누기(&ts, &ts, ((2 * j) * (2 * j + 1)) 으로 실수).
        겹곱하기(&tc, &tc, &r2).
        겹실나누기(&tc, &tc, ((2 * j - 1) * (2 * j)) 으로 실수).
        j % 2 == 1이면 { 겹빼기(&s, &s, &ts). 겹빼기(&c, &c, &tc). }
        아니면 { 겹더하기(&s, &s, &ts). 겹더하기(&c, &c, &tc). }
    }
    q == 0이면 { 로프sin→위 = s→위. 로프sin→아래 = s→아래. 로프cos→위 = c→위. 로프cos→아래 = c→아래. }
    아니면 q == 1이면 { 로프sin→위 = c→위. 로프sin→아래 = c→아래. 로프cos→위 = 0.0 - s→위. 로프cos→아래 = 0.0 - s→아래. }
    아니면 q == 2이면 { 로프sin→위 = 0.0 - s→위. 로프sin→아래 = 0.0 - s→아래. 로프cos→위 = 0.0 - c→위. 로프cos→아래 = 0.0 - c→아래. }
    아니면 { 로프sin→위 = 0.0 - c→위. 로프sin→아래 = 0.0 - c→아래. 로프cos→위 = s→위. 로프cos→아래 = s→아래. }
}

(* ---- 빠른 길: fp64 의 cos · sin 과 오차의 한계 (파이썬판의 _바른반올림32 와 같은 꼴 — 경계에 가까우면 두 배 정밀도의 길로) ----
   줄이기 — k = ⌊x · 2/π + ½⌋ (x < 2^17 이라 k < 2^17), r = x − k · π/2 를 실수 둘 rh + rl 로: r1 = x − k · P1 (k · P1 은 정확한 곱,
     빼기도 정확 — 둘 다 2^-53 의 배수이고 |차| < 1), p2 = k · P2 (정확), (r2, e2) = TwoSum(r1, −p2), (rh, t) = TwoSum(r2, −k · P3),
     rl = t + e2. P1 · P2 · P3 은 π/2 의 36 · 36 · 53 비트 조각이라 π/2 − (P1 + P2 + P3) < 2^-124 (k 곱해 < 2^-107), k · P3 의
     반올림 ≤ 2^-107, rl 의 반올림 ≤ 2^-105 — 모두 합쳐 |rh + rl − (x − kπ/2)| ≤ 2^-104.
   다항식 — |rh| ≤ π/4 + ε 에서 테일러 급수(sin 은 r^21, cos 는 r^20 까지 — 잘라낸 항 < 2^-80)를 호너로, rl 은 1 차로
     (sin(rh + rl) ≈ S + rl · C, cos ≈ C − rl · S — 버린 rl² 항 < 2^-105). 호너 · 더하기의 반올림은 값의 몇 ulp(2^-51 · |값| 아래).
   그래서 |근삿값 − 참값| ≤ 2^-51 · |값| + 2^-103 — 판정의 한계는 그 64 배인 2^-45 · |근삿값| + 2^-97 로 넉넉히 잡는다. *)
실수[11] 사인계수.          (* [j] = (−1)^j / (2j + 1)!, j = 1 … 10 *)
실수[11] 코사인계수.        (* [j] = (−1)^j / (2j)! *)
실수 빠른상대 = 0.0.        (* 2^-45 *)
실수 빠른절대 = 0.0.        (* 2^-97 *)
실수 빠른cos = 0.0.
실수 빠른sin = 0.0.
참거짓 빠른확실 = 참.
정수 느린경우 = 0.          (* 빠른 길로 정하지 못해 두 배 정밀도로 간 (위치, i) 의 수 *)

[빠른준비]는 {
    (* n! 은 n ≤ 22 에서 실수로 정확하다(홀수 부분 < 2^53) — 계수마다 반올림 하나 *)
    실수 f = 1.0.
    반복 (정수 n은 1부터 22 전까지) {
        f = f * (n 으로 실수).
        정수 j = n / 2.
        실수 부호 = 1.0.
        j % 2 == 1이면 { 부호 = -1.0. }
        (n % 2 == 1 그리고 n >= 3)이면 { 사인계수[j] = 부호 / f. }
        n % 2 == 0이면 { 코사인계수[j] = 부호 / f. }
    }
    빠른상대 = 이진스케일(1.0, -45).
    빠른절대 = 이진스케일(1.0, -97).
}

(* 0 < x < 2^17 *)
[실수 x를 빠른삼각]는 {
    실수 k = 내림(x * 0.6366197723675814 + 0.5).
    정수 q = (k 으로 정수) % 4.
    실수 r1 = x - k * 빠른반파이1.
    실수 p2 = 0.0 - k * 빠른반파이2.
    실수 r2 = r1 + p2.
    실수 bb = r2 - r1.
    실수 e2 = (r1 - (r2 - bb)) + (p2 - bb).
    실수 p3 = 0.0 - k * 빠른반파이3.
    실수 rh = r2 + p3.
    실수 bb2 = rh - r2.
    실수 rl = ((r2 - (rh - bb2)) + (p3 - bb2)) + e2.
    실수 z = rh * rh.
    실수 ps = 사인계수[10].
    반복 (정수 j = 9: j >= 1: j -= 1) { ps = ps * z + 사인계수[j]. }
    실수 pc = 코사인계수[10].
    반복 (정수 j2 = 9: j2 >= 1: j2 -= 1) { pc = pc * z + 코사인계수[j2]. }
    실수 s0 = rh + rh * (z * ps).
    실수 c0 = 1.0 + z * pc.
    실수 s = s0 + rl * c0.
    실수 c = c0 - rl * s0.
    q == 0이면 { 빠른cos = c. 빠른sin = s. }
    아니면 q == 1이면 { 빠른cos = 0.0 - s. 빠른sin = c. }
    아니면 q == 2이면 { 빠른cos = 0.0 - c. 빠른sin = 0.0 - s. }
    아니면 { 빠른cos = s. 빠른sin = 0.0 - c. }
}

(* fp64 근삿값 a (|a − 참값| ≤ 한계) 를 짧은실수 t 로. 참값의 바른 반올림이 t 임이 확실하면 빠른확실 = 참 — 참값이 t 의 두 이웃 가운데
   (m아래, m위) 사이에 있다는 것: a − 한계 > m아래 그리고 a + 한계 < m위. 가운데는 실수로 정확하고, a 와의 차도 정확하다(둘 다 2^(e−53)
   의 배수이고 차가 짧은실수 ulp 의 두 배 아래). *)
[실수 a를 실수 한계를 빠른짧은]는 -> 짧은실수 {
    짧은실수 t = a 으로 짧은실수.
    실수 t64 = t 으로 실수.
    실수 m아래 = (t64 + (짧은이웃(t, -1) 으로 실수)) * 0.5.
    실수 m위 = (t64 + (짧은이웃(t, 1) 으로 실수)) * 0.5.
    빠른확실 = (a - m아래 > 한계) 그리고 (m위 - a > 한계).
    반환 t.
}

(* ---- 표 ---- *)
짧은실수 참조 로프코사인표.
짧은실수 참조 로프사인표.
정수 로프표길이 = 0.        (* 만든 표의 최대길이 (없으면 0) *)
정수 로프표반 = 0.          (* 만든 표의 폭 — 머리 크기의 반(0.5B 32, 7B 64 — 22단계) *)

(* θ_i = θ^(−i/반) (i < 반) 를 fp64 로 바르게 반올림 — 머리 크기 hd = 2 · 반 의 θ^(−2i/hd) *)
[실수 밑을 정수 i를 정수 반을 로프주파수]는 -> 실수 {
    i == 0이면 { 반환 1.0. }
    겹 a.
    겹값(&a, 밑).
    겹 l.
    겹로그(&l, &a).
    겹실곱(&l, &l, (0 - i) 으로 실수).
    겹실곱(&l, &l, 1.0 / (반 으로 실수)).
    겹 e.
    겹지수(&e, &l).
    반환 실수로반올림(&e).
}

(* 표 [위치][반] — 반 = 머리 크기의 반 (32 · 64) *)
[정수 최대길이를 실수 밑을 정수 반을 로프표만들기]는 {
    원주율준비().
    빠른준비().
    로프코사인표 = 할당(최대길이 * 반 * 4).
    로프사인표 = 할당(최대길이 * 반 * 4).
    실수[64] 주파수.
    반복 (정수 i는 0부터 반 전까지) { 주파수[i] = 로프주파수(밑, i, 반). }
    반복 (정수 위치는 0부터 최대길이 전까지) {
        반복 (정수 i2는 0부터 반 전까지) {
            실수 각 = (위치 으로 실수) * 주파수[i2].
            정수 자리 = 위치 * 반 + i2.
            참거짓 확정 = 거짓.
            (각 > 0.0 그리고 각 < 131072.0)이면 {
                각을 빠른삼각하다.
                짧은실수 fc = 빠른짧은(빠른cos, 실수_절댓값(빠른cos) * 빠른상대 + 빠른절대).
                참거짓 cc = 빠른확실.
                짧은실수 fs = 빠른짧은(빠른sin, 실수_절댓값(빠른sin) * 빠른상대 + 빠른절대).
                (cc 그리고 빠른확실)이면 {
                    로프코사인표[자리] = fc.
                    로프사인표[자리] = fs.
                    확정 = 참.
                }
            }
            아닌 확정이면 {
                각 > 0.0이면 { 느린경우 += 1. }
                각을 겹삼각하다.
                로프코사인표[자리] = 짧은로반올림(&로프cos).
                로프사인표[자리] = 짧은로반올림(&로프sin).
            }
        }
    }
    어려운경우 > 0이면 {
        파일에_쓰기(표준오류(), "RoPE 표: 반올림 경계에 너무 가까운 값 %lld 개 — 두 배 정밀도로 정할 수 없다(멈춘다)\n", 어려운경우).
        1로 종료하다.
    }
    로프표길이 = 최대길이.
    로프표반 = 반.
}

(* ---- 재기의 시작 — 7B 의 표(θ = 1e6, 머리 128 → 반 64, 위치 32768)를 만들고 표의 비트를 하나의 수로 접어 찍는다 ---- *)
[시작하기]는 -> 정수 {
    로프표만들기(32768, 1000000.0, 64).
    정수 h = 0.
    정수 n = 32768 * 64.
    짧은비트 u.
    반복 (정수 k는 0부터 n 전까지) {
        u의 f = 로프코사인표[k].
        h = ((h * 31) + ((u의 i 으로 정수) & 4294967295)) & 281474976710655.
    }
    반복 (정수 k2는 0부터 n 전까지) {
        u의 f = 로프사인표[k2].
        h = ((h * 31) + ((u의 i 으로 정수) & 4294967295)) & 281474976710655.
    }
    "{h} {느린경우} {어려운경우}\n"을 쓰다.
    반환 0.
}

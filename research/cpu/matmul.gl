(* 배정밀도 행렬곱 500 × 500 (i-k-j 순서). 실수 레지스터와 배열. 짝: matmul.c *)
[시작하기]는 -> 정수 {
    정수 n = 500.
    실수 참조 a = 할당(n * n * 8).
    실수 참조 b = 할당(n * n * 8).
    실수 참조 c = 할당(n * n * 8).
    반복 (정수 i는 0부터 n * n 전까지) {
        a[i] = ((i % 7) 으로 실수) * 0.5.
        b[i] = ((i % 11) 으로 실수) * 0.25.
        c[i] = 0.0.
    }
    반복 (정수 i는 0부터 n 전까지) {
        반복 (정수 k는 0부터 n 전까지) {
            실수 aik = a[i * n + k].
            반복 (정수 j는 0부터 n 전까지) {
                c[i * n + j] = c[i * n + j] + aik * b[k * n + j].
            }
        }
    }
    실수 합 = 0.0.
    반복 (정수 q는 0부터 n * n 전까지) { 합 = 합 + c[q]. }
    "{합}\n"을 쓰다.
    반환 0.
}

(* D-57 표준의 문자열 · 메모리 · 서식 함수가 낱말(8 바이트) 단위로 읽고 옮겨도 결과가 한 바이트씩 하던 것과 같은가.
   덮는 경우: 정렬 0 ~ 15 와 길이 0 ~ 40 의 글자수(시작 앞의 바이트가 0 이 아닐 때와 0 일 때 — 같은 낱말에 든 앞 바이트를 끝으로
   보면 안 된다), 공통 앞부분의 길이마다 다른 자리 · 높은 바이트(0x80 이상) · 끝 뒤의 쓰레기 ·
   한쪽이 앞부분인 문자열_비교 · 문자열_같은가 · 메모리_비교, 겹치는 메모리_이동(앞 · 뒤, 거리 1 ~ 9), 긴 글자 묶음과 % 가 섞인
   서식화, 2^31 근처 · 음수 · 부호 없는 · 16 진의 정수_서식. 참값은 이 파일 안에서 한 바이트씩 센다 *)

[정수 a를 정수 b를 부호]는 -> 정수 {
    a < b이면 { 반환 -1. }
    a > b이면 { 반환 1. }
    반환 0.
}

[문자열 s를 참글자수]는 -> 정수 {
    정수 n = 0.
    (s[n] != 0)동안 { n를 증가하다. }
    반환 n.
}

[문자열 a를 문자열 b를 참비교]는 -> 정수 {
    정수 k = 0.
    (참)동안 {
        정수 x = a[k] & 255.
        정수 y = b[k] & 255.
        x != y이면 { 반환 부호(x, y). }
        x == 0이면 { 반환 0. }
        k를 증가하다.
    }
    반환 0.
}

[문자열 a를 문자열 b를 정수 n을 참메모리비교]는 -> 정수 {
    반복 (정수 k는 0부터 n 전까지) {
        정수 x = a[k] & 255.
        정수 y = b[k] & 255.
        x != y이면 { 반환 부호(x, y). }
    }
    반환 0.
}

(* 0 이 아닌 바이트 무늬 — 높은 바이트 · 0x01 · 0x80 · 0xFF 가 섞인다 *)
[정수 i를 무늬]는 -> 정수 {
    정수 v = (i * 37 + 11) % 255 + 1.
    i % 7 == 3이면 { v = 128. }
    i % 11 == 5이면 { v = 1. }
    i % 13 == 6이면 { v = 255. }
    반환 v.
}

[시작하기]는 -> 정수 {
    문자열 버퍼1 = 할당(256).
    문자열 버퍼2 = 할당(256).

    (* 글자수: 모든 정렬과 길이, 시작 앞의 바이트가 무늬일 때와 0 일 때 *)
    정수 건수 = 0.
    정수 어긋남 = 0.
    정수 합 = 0.
    반복 (정수 앞영은 0부터 2 전까지) {
        반복 (정수 o는 0부터 16 전까지) {
            반복 (정수 n은 0부터 41 전까지) {
                반복 (정수 i는 0부터 120 전까지) { 버퍼1[i] = 무늬(i + o * 3 + n). }
                앞영 == 1이면 { 반복 (정수 j는 0부터 o 전까지) { 버퍼1[j] = 0. } }
                버퍼1[o + n] = 0.
                정수 r = 글자수(버퍼1 + o).
                r != 참글자수(버퍼1 + o)이면 { 어긋남를 증가하다. }
                합 = 합 + r * (o + 1 + 앞영 * 16).
                건수를 증가하다.
            }
        }
    }
    "글자수 {건수} 경우, 어긋남 {어긋남}, 합 {합}\n"을 쓰다.

    (* 문자열_비교 · 문자열_같은가: 두 쪽 정렬 0 ~ 8, 공통 앞부분 0 ~ 24, 그 자리의 바이트 짝 여섯 *)
    정수[12] 짝.
    짝[0] = 65. 짝[1] = 66.        (* 'A' < 'B' *)
    짝[2] = 128. 짝[3] = 127.      (* 높은 바이트가 크다 — 부호 없이 *)
    짝[4] = 255. 짝[5] = 0.        (* 한쪽이 끝난다 *)
    짝[6] = 0. 짝[7] = 0.          (* 둘 다 끝나고 그 뒤는 서로 다른 쓰레기 *)
    짝[8] = 1. 짝[9] = 1.          (* 같고 이어진다 *)
    짝[10] = 193. 짝[11] = 65.     (* 0xC1 · 0x41 — 맨 위 비트만 다르다 *)
    건수 = 0.
    어긋남 = 0.
    합 = 0.
    반복 (정수 오1은 0부터 9 전까지) {
        반복 (정수 오2는 0부터 9 전까지) {
            반복 (정수 p는 0부터 25 전까지) {
                반복 (정수 c는 0부터 6 전까지) {
                    반복 (정수 i2는 0부터 80 전까지) {
                        정수 w = 무늬(i2 + p).
                        버퍼1[오1 + i2] = w.
                        버퍼2[오2 + i2] = w.
                    }
                    버퍼1[오1 + p] = 짝[c * 2].
                    버퍼2[오2 + p] = 짝[c * 2 + 1].
                    c == 3이면 { 버퍼1[오1 + p + 1] = 77. 버퍼2[오2 + p + 1] = 88. }
                    c == 4이면 { 버퍼1[오1 + p + 3] = 0. 버퍼2[오2 + p + 3] = 0. }
                    c != 4이면 { 버퍼1[오1 + 60] = 0. 버퍼2[오2 + 60] = 0. }
                    정수 r2 = 문자열_비교(버퍼1 + 오1, 버퍼2 + 오2).
                    정수 r3 = 문자열_비교(버퍼2 + 오2, 버퍼1 + 오1).
                    정수 기대 = 참비교(버퍼1 + 오1, 버퍼2 + 오2).
                    (r2 != 기대 또는 r3 != 0 - 기대)이면 { 어긋남를 증가하다. }
                    (문자열_같은가(버퍼1 + 오1, 버퍼2 + 오2) != (기대 == 0))이면 { 어긋남를 증가하다. }
                    합 = 합 + (r2 + 2) * (p + 1).
                    건수를 증가하다.
                }
            }
        }
    }
    "문자열_비교 {건수} 경우, 어긋남 {어긋남}, 합 {합}\n"을 쓰다.

    (* 메모리_비교: 길이 0 ~ 40, 다른 자리 0 ~ 길이(같음 포함), 정렬 *)
    건수 = 0.
    어긋남 = 0.
    합 = 0.
    반복 (정수 오는 0부터 9 전까지) {
        반복 (정수 n2는 0부터 41 전까지) {
            반복 (정수 q는 0부터 n2 + 1 전까지) {
                반복 (정수 i3는 0부터 60 전까지) {
                    버퍼1[오 + i3] = 무늬(i3).
                    버퍼2[i3] = 무늬(i3).
                }
                q < n2이면 { 버퍼1[오 + q] = (버퍼1[오 + q] & 255) ^ 128. }
                정수 r4 = 메모리_비교(버퍼1 + 오, 버퍼2, n2).
                r4 != 참메모리비교(버퍼1 + 오, 버퍼2, n2)이면 { 어긋남를 증가하다. }
                합 = 합 + (r4 + 2) * (q + 1).
                건수를 증가하다.
            }
        }
    }
    "메모리_비교 {건수} 경우, 어긋남 {어긋남}, 합 {합}\n"을 쓰다.

    (* 메모리_이동: 거리 -9 ~ 9, 길이 0 ~ 40 — 참값은 임시 자리에 먼저 떠 둔다 *)
    건수 = 0.
    어긋남 = 0.
    합 = 0.
    문자열 참값 = 할당(256).
    문자열 임시 = 할당(256).
    반복 (정수 거리는 -9부터 10 전까지) {
        반복 (정수 n3는 0부터 41 전까지) {
            반복 (정수 i4는 0부터 100 전까지) { 버퍼1[i4] = 무늬(i4 * 3 + n3). 참값[i4] = 버퍼1[i4]. }
            반복 (정수 i5는 0부터 n3 전까지) { 임시[i5] = 참값[30 + i5]. }
            반복 (정수 i6는 0부터 n3 전까지) { 참값[30 + 거리 + i6] = 임시[i6]. }
            메모리_이동(버퍼1 + 30 + 거리 에, 버퍼1 + 30 을, n3).
            반복 (정수 i7는 0부터 100 전까지) {
                버퍼1[i7] != 참값[i7]이면 { 어긋남를 증가하다. }
                합 = 합 + (버퍼1[i7] & 255).
            }
            건수를 증가하다.
        }
    }
    "메모리_이동 {건수} 경우, 어긋남 {어긋남}, 합 {합}\n"을 쓰다.

    (* 서식화: 긴 글자 묶음 · %% · 끝의 묶음 · 폭과 정렬 *)
    "가나다라마바사아자차카타파하 abcdefghijklmnopqrstuvwxyz 0123456789 ~!@#$^&*()_+ %d 끝\n"을 12345를 쓰다.
    "%%%d%%%s%%\n"을 7을 "가"를 쓰다.
    "[%5d|%-5d|%05d|%+d|% d]\n"을 42를 42를 -42를 42를 42를 쓰다.
    "%s와 %s 사이에 긴 글자 묶음이 있다 — 반복하는 글자들 글글글글글글글글글글글글글글글글글글글글\n"을 "앞"을 "뒤"를 쓰다.
    "%x %X %u %c%c\n"을 48879를 48879를 4000000000을 75를 76을 쓰다.
    "\n"을 쓰다.

    (* 정수_서식: 2^31 근처 · 음수 · 부호 없는 · 16 진 *)
    정수[16] 값들.
    값들[0] = 0. 값들[1] = 9. 값들[2] = 10. 값들[3] = 99. 값들[4] = 100.
    값들[5] = 2147483647. 값들[6] = 2147483648. 값들[7] = 2147483649. 값들[8] = 4294967295.
    값들[9] = 9223372036854775807. 값들[10] = -9223372036854775807 - 1. 값들[11] = -1. 값들[12] = -10.
    값들[13] = -2147483648. 값들[14] = 1234567890. 값들[15] = 1000000007.
    반복 (정수 k는 0부터 16 전까지) {
        "%lld %llu %llx %d\n"을 값들[k]를 값들[k]를 값들[k]를 값들[k]를 쓰다.
    }
    반환 0.
}

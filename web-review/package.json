{
  "name": "@geul/web-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "review": "node src/cli.mjs",
    "corpus": "python scripts/corpus.py verify",
    "corpus:inventory": "python scripts/change_inventory.py verify",
    "test:inventory": "python -m unittest discover -s inventory-tests",
    "test:corpus": "node scripts/check-corpus.mjs",
    "test:context": "node scripts/check-context.mjs",
    "test:functions": "node scripts/check-functions.mjs",
    "test:destructuring": "node scripts/check-destructuring.mjs",
    "test:result-links": "node scripts/check-result-links.mjs",
    "test:bindings": "node scripts/check-bindings.mjs",
    "test:records": "node scripts/check-records.mjs",
    "test:prop-equations": "node scripts/check-prop-equations.mjs",
    "test:arrays": "node scripts/check-arrays.mjs",
    "test:array-traces": "node scripts/check-array-traces.mjs",
    "test:output-props": "node scripts/check-output-props.mjs",
    "test:jsx-properties": "node scripts/check-jsx-properties.mjs",
    "test:slice-scope": "node scripts/check-slice-scope.mjs",
    "test:guards": "node scripts/check-guards.mjs",
    "test:recording-guards": "node scripts/check-recording-guards.mjs",
    "test:call-entries": "node scripts/check-call-entries.mjs",
    "test:call-arguments": "node scripts/check-call-arguments.mjs",
    "test:color-normalization": "node scripts/check-color-normalization.mjs",
    "test:discovery": "node scripts/check-discovery.mjs",
    "test:change-discovery": "node scripts/check-change-discovery.mjs",
    "audit:call-entries": "node scripts/audit-call-entry-candidates.mjs",
    "test:props": "node scripts/check-props.mjs",
    "test:references": "node scripts/check-references.mjs",
    "test:flows": "node scripts/check-flows.mjs",
    "test:react": "node scripts/check-react.mjs",
    "test:upstream": "node scripts/check-upstream.mjs",
    "test:upstream-color": "node scripts/check-upstream-color.mjs",
    "check:browser-recording": "node scripts/browser-evidence.mjs verify",
    "check:color-browser-recording": "node scripts/color-browser-evidence.mjs verify",
    "prepare:pilot": "node scripts/prepare-pilot.mjs",
    "prepare:behaviors": "node scripts/prepare-behavior-reviews.mjs",
    "score:practice": "node scripts/score-practice.mjs",
    "test:scoring": "node scripts/check-scoring.mjs",
    "prepare:inspector": "node scripts/prepare-inspector.mjs",
    "inspector": "node inspector/server.mjs",
    "practice": "node evaluation/viewer/server.mjs"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "clsx": "1.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}

{
  "schema": "web-jsx-property-selection-1",
  "scope": "원본 JSX에서 선택한 속성의 생략·존재·값 관찰과 선택 속성만 남긴 별도 생성 조각을 대조한다. 원본 컴포넌트 실행과 상태 전이는 검사하지 않는다.",
  "targets": [
    {
      "id": "excalidraw-color-invalid-property",
      "case": "excalidraw-color-error",
      "path": "packages/excalidraw/components/ColorPicker/ColorInput.tsx",
      "tag": "input",
      "attribute": "aria-invalid",
      "beforeProvided": false,
      "afterProvided": true,
      "afterExpression": "!!errorMessage",
      "reactProbeVersion": "19.0.0"
    }
  ]
}

(* 토큰 덤프 드라이버: 토큰덤프 <파일.gl>  → docs/05-덤프-형식.md 의 토큰 덤프 *)

포함 "self/렉서.gl"

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    argc < 2이면 {
        파일에_쓰기(표준오류(), "사용법: 토큰덤프 <파일.gl>\n").
        반환 3.
    }
    아닌 파일토큰화(argv[1])이면 {
        파일에_쓰기(표준오류(), "%s:0:0: 오류: 파일을 열 수 없습니다\n", argv[1]).
        반환 1.
    }
    반복 (정수 i = 0: i < 토큰수(): i += 1) {
        토큰 참조 t = 동적배열_원소(토큰들, i).
        쓰기("%lld:%lld\t%s\t%s\n", t→줄, t→열, 종류이름(t→종류), t→글).
    }
    반환 0.
}

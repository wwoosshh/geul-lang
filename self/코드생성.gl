(* 자체호스팅 4단계 — IR → x86-64 기계어 (ref/geul/codegen.py, runtime.py).
   모든 임시값은 스택 슬롯이다. Win64 호출 규약: rcx rdx r8 r9 / xmm0-3, 섀도 32B, 5번째부터 스택, rsp 16 정렬. *)

포함 "self/하강.gl"
포함 "self/x64.gl"

(* ===== 이미지 ===== *)
안정배열 참조 코드고정들.          (* 고정: IAT/문자열/데이터 (rel32) *)
정수 진입오프셋 = 0.
바이트열 참조 데이터.
안정배열 참조 데이터절대고정들.    (* 고정: 문자열 (64비트 절대 주소) *)
사전 참조 데이터전역.              (* 이름 → 오프셋 *)
문자열[8] 임포트DLL들.
정수 임포트DLL수 = 0.
문자열[4096] 임포트이름들.
정수목록 참조 임포트DLL색인.       (* 이름마다 DLL 색인 *)
사전 참조 임포트있음.

(* ===== 함수 코드 생성 상태 ===== *)
정수 참조 심볼슬롯 = 없음.
정수목록 참조 임시슬롯.
정수 프레임 = 0.
IR함수 참조 G = 없음.

[정수 n을 정수 a를 올림]는 -> 정수 { 반환 (n + a - 1) / a * a. }

[정수 t를 F비트]는 -> 정수 {
    (실수형인가(t) 그리고 타입비트(t) == 32)이면 { 반환 32. }
    반환 64.
}

[정수 k를 임시타입]는 -> 정수 { 반환 정수목록_값(G→임시타입들, k). }

[배치]는 {
    정수 cur = 0.
    임시슬롯 = 정수목록_만들기().
    반복 (정수 k = 0: k < 정수목록_길이(G→지역들): k += 1) { 심볼슬롯[정수목록_값(G→지역들, k)] = 0. }
    (* 매개변수: 홈 슬롯 [rbp+16+8i] *)
    반복 (정수 i = 0: i < G→매개수: i += 1) { 심볼슬롯[정수목록_값(G→지역들, i)] = 16 + 8 * i. }
    반복 (정수 j = 0: j < 정수목록_길이(G→지역들): j += 1) {
        정수 s = 정수목록_값(G→지역들, j).
        심볼슬롯[s] != 0이면 { 계속. }
        정수 크기값 = 타입크기(심볼보기(s)→타입).
        크기값 < 8이면 { 크기값 = 8. }
        크기값 = 올림(크기값, 8).
        정수 a = 8.
        크기값 >= 16이면 { a = 16. }
        cur = 올림(cur + 크기값, a).
        심볼슬롯[s] = 0 - cur.
    }
    반복 (정수 t = 0: t < 정수목록_길이(G→임시타입들): t += 1) {
        cur = cur + 8.
        정수목록_추가(임시슬롯, 0 - cur).
    }
    정수 지역크기 = 올림(cur, 16).
    정수 인자수 = G→최대인자수.
    인자수 < 4이면 { 인자수 = 4. }
    정수 out = 올림(인자수 * 8, 16).
    프레임 = 지역크기 + out.
}

[정수 r를 정수 t를 임시적재]는 { LOAD(r, RBP, 정수목록_값(임시슬롯, t), 64, 1). }
[정수 t를 정수 r를 임시저장]는 { STORE(RBP, 정수목록_값(임시슬롯, t), r, 64). }

(* 64비트 레지스터의 값을 타입 t 의 정규 표현(부호/영 확장)으로 *)
[정수 r를 정수 t를 정규화]는 {
    (정수형인가(t) 그리고 타입비트(t) < 64)이면 {
        타입부호(t)이면 { MOVSX(r, r, 타입비트(t)). }
        아니면 { MOVZX(r, r, 타입비트(t)). }
    }
}

[에필로그]는 { MOV레지(RSP, RBP). POP(RBP). RET(). }

[명령 참조 m를 이항생성]는 {
    정수 t = 임시타입(m→dst).
    문자열 op = m→글.
    op[0] == 102이면 {
        정수 비트 = F비트(t).
        MOVSD_LOAD(XMM0, RBP, 정수목록_값(임시슬롯, m→a), 비트).
        MOVSD_LOAD(XMM1, RBP, 정수목록_값(임시슬롯, m→b), 비트).
        FOP(op + 1, XMM0, XMM1, 비트).
        MOVSD_STORE(RBP, 정수목록_값(임시슬롯, m→dst), XMM0, 비트).
        반환.
    }
    임시적재(RAX, m→a).
    임시적재(RCX, m→b).
    (문자열_같은가(op, "add") 또는 문자열_같은가(op, "sub") 또는 문자열_같은가(op, "and") 또는 문자열_같은가(op, "or") 또는 문자열_같은가(op, "xor"))이면 { ALU(op, RAX, RCX). }
    아니면 문자열_같은가(op, "mul")이면 { IMUL(RAX, RCX). }
    아니면 문자열_같은가(op, "sdiv")이면 { CQO(). IDIV(RCX). }
    아니면 문자열_같은가(op, "srem")이면 { CQO(). IDIV(RCX). MOV레지(RAX, RDX). }
    아니면 문자열_같은가(op, "udiv")이면 { ALU("xor", RDX, RDX). DIV(RCX). }
    아니면 문자열_같은가(op, "urem")이면 { ALU("xor", RDX, RDX). DIV(RCX). MOV레지(RAX, RDX). }
    아니면 문자열_같은가(op, "shl")이면 { SHIFT_CL("shl", RAX). }
    아니면 문자열_같은가(op, "lshr")이면 { SHIFT_CL("shr", RAX). }
    아니면 { SHIFT_CL("sar", RAX). }
    정규화(RAX, t).
    임시저장(m→dst, RAX).
}

[문자열 cond를 정수비교코드]는 -> 문자열 {
    문자열_같은가(cond, "eq")이면 { 반환 "e". }
    문자열_같은가(cond, "ne")이면 { 반환 "ne". }
    문자열_같은가(cond, "lt")이면 { 반환 "l". }
    문자열_같은가(cond, "le")이면 { 반환 "le". }
    문자열_같은가(cond, "gt")이면 { 반환 "g". }
    문자열_같은가(cond, "ge")이면 { 반환 "ge". }
    문자열_같은가(cond, "ult")이면 { 반환 "b". }
    문자열_같은가(cond, "ule")이면 { 반환 "be". }
    문자열_같은가(cond, "ugt")이면 { 반환 "a". }
    반환 "ae".
}

[명령 참조 m를 비교생성]는 {
    문자열 cond = m→글.
    정수 t = m→타입.
    cond[0] == 102이면 {
        정수 비트 = F비트(t).
        MOVSD_LOAD(XMM0, RBP, 정수목록_값(임시슬롯, m→a), 비트).
        MOVSD_LOAD(XMM1, RBP, 정수목록_값(임시슬롯, m→b), 비트).
        문자열 c = cond + 1.
        문자열_같은가(c, "eq")이면 {
            UCOMIS(XMM0, XMM1, 비트). SETCC("e", RAX). SETCC("np", RCX).
            MOVZX(RAX, RAX, 8). MOVZX(RCX, RCX, 8). ALU("and", RAX, RCX).
        }
        아니면 문자열_같은가(c, "ne")이면 {
            UCOMIS(XMM0, XMM1, 비트). SETCC("ne", RAX). SETCC("p", RCX).
            MOVZX(RAX, RAX, 8). MOVZX(RCX, RCX, 8). ALU("or", RAX, RCX).
        }
        아니면 {
            (문자열_같은가(c, "lt") 또는 문자열_같은가(c, "le"))이면 {
                UCOMIS(XMM1, XMM0, 비트).
                문자열_같은가(c, "lt")이면 { SETCC("a", RAX). } 아니면 { SETCC("ae", RAX). }
            }
            아니면 {
                UCOMIS(XMM0, XMM1, 비트).
                문자열_같은가(c, "gt")이면 { SETCC("a", RAX). } 아니면 { SETCC("ae", RAX). }
            }
            MOVZX(RAX, RAX, 8).
        }
        임시저장(m→dst, RAX).
        반환.
    }
    임시적재(RAX, m→a).
    임시적재(RCX, m→b).
    ALU("cmp", RAX, RCX).
    SETCC(정수비교코드(cond), RAX).
    MOVZX(RAX, RAX, 8).
    임시저장(m→dst, RAX).
}

[명령 참조 m를 변환생성]는 {
    문자열 kind = m→글.
    정수 st = 임시타입(m→a).
    정수 dt = 임시타입(m→dst).
    (문자열_같은가(kind, "sext") 또는 문자열_같은가(kind, "zext") 또는 문자열_같은가(kind, "trunc"))이면 {
        임시적재(RAX, m→a).
        (문자열_같은가(kind, "trunc") 또는 타입비트(dt) < 64)이면 {
            타입부호(dt)이면 { MOVSX(RAX, RAX, 타입비트(dt)). }
            아니면 { MOVZX(RAX, RAX, 타입비트(dt)). }
        }
        임시저장(m→dst, RAX).
        반환.
    }
    (문자열_같은가(kind, "sitofp") 또는 문자열_같은가(kind, "uitofp"))이면 {
        정수 비트 = F비트(dt).
        임시적재(RAX, m→a).
        문자열_같은가(kind, "uitofp")이면 {
            문자[256] b.
            버퍼에_쓰기(b, 256, ".%s.u2f%lld", G→이름, m→dst).
            문자열 l_neg = 문자열_복제(b).
            문자열 l_end = 문자열_합치기(l_neg, "e").
            TEST(RAX, RAX).
            JCC("l", l_neg).
            CVTSI2F(XMM0, RAX, 비트).
            JMP(l_end).
            라벨(l_neg).
            MOV레지(RCX, RAX).
            MOV즉시(RDX, 1, 0).
            ALU("and", RCX, RDX).
            바이트내기(72). 바이트내기(209). 바이트내기(232).
            ALU("or", RAX, RCX).
            CVTSI2F(XMM0, RAX, 비트).
            FOP("add", XMM0, XMM0, 비트).
            라벨(l_end).
        }
        아니면 { CVTSI2F(XMM0, RAX, 비트). }
        MOVSD_STORE(RBP, 정수목록_값(임시슬롯, m→dst), XMM0, 비트).
        반환.
    }
    문자열_같은가(kind, "fptosi")이면 {
        정수 비트2 = F비트(st).
        MOVSD_LOAD(XMM0, RBP, 정수목록_값(임시슬롯, m→a), 비트2).
        CVTTF2SI(RAX, XMM0, 비트2).
        정규화(RAX, dt).
        임시저장(m→dst, RAX).
        반환.
    }
    문자열_같은가(kind, "fpext")이면 {
        MOVSD_LOAD(XMM0, RBP, 정수목록_값(임시슬롯, m→a), 32).
        CVTSS2SD(XMM0, XMM0).
        MOVSD_STORE(RBP, 정수목록_값(임시슬롯, m→dst), XMM0, 64).
        반환.
    }
    (* fptrunc *)
    MOVSD_LOAD(XMM0, RBP, 정수목록_값(임시슬롯, m→a), 64).
    CVTSD2SS(XMM0, XMM0).
    MOVSD_STORE(RBP, 정수목록_값(임시슬롯, m→dst), XMM0, 32).
}

[명령 참조 m를 호출생성]는 {
    정수 n = m→목록수.
    참거짓 가변 = 거짓.
    m→타입 >= 0이면 { 가변 = 타입보기(m→타입)→가변. }
    (* 스택 인자 (5번째부터) *)
    반복 (정수 k = 4: k < n: k += 1) {
        임시적재(RAX, 정수목록_값(인자풀, m→목록시작 + k)).
        STORE(RSP, 8 * k, RAX, 64).
    }
    정수 nr = n.
    nr > 4이면 { nr = 4. }
    반복 (정수 k2 = 0: k2 < nr: k2 += 1) {
        정수 arg = 정수목록_값(인자풀, m→목록시작 + k2).
        정수 t = 임시타입(arg).
        실수형인가(t)이면 {
            MOVSD_LOAD(k2, RBP, 정수목록_값(임시슬롯, arg), F비트(t)).
            가변이면 { 임시적재(인자레지(k2), arg). }
        }
        아니면 { 임시적재(인자레지(k2), arg). }
    }
    m→글 != 없음이면 {
        m→외부여부이면 { CALL_IAT(m→글). }
        아니면 { CALL라벨(m→글). }
    }
    아니면 {
        임시적재(R11, m→a).
        CALL레지(R11).
    }
    m→dst >= 0이면 {
        정수 rt = 임시타입(m→dst).
        실수형인가(rt)이면 { MOVSD_STORE(RBP, 정수목록_값(임시슬롯, m→dst), XMM0, F비트(rt)). }
        아니면{
            정규화(RAX, rt).
            임시저장(m→dst, RAX).
        }
    }
}

[명령 참조 m를 명령생성]는 {
    정수 op = m→op.
    op == 명_라벨이면 { 라벨(m→글). 반환. }
    op == 명_점프이면 { JMP(m→글). 반환. }
    op == 명_분기이면 {
        임시적재(RAX, m→a).
        TEST(RAX, RAX).
        JCC("ne", m→글).
        JMP(m→글2).
        반환.
    }
    op == 명_상수이면 {
        MOV즉시(RAX, m→값, m→부호없음).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_실수상수이면 {
        MOV즉시(RAX, m→값, 1).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_문자열이면 {
        LEA_RIP(RAX, 고정_문자열, 없음, m→값).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_지역주소이면 {
        LEA(RAX, RBP, 심볼슬롯[m→값]).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_전역주소이면 {
        LEA_RIP(RAX, 고정_데이터, m→글, 0).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_함수주소이면 {
        m→외부여부이면 { LOAD_RIP(RAX, 고정_IAT, m→글, 0). }
        아니면 { LEA_RIP(RAX, 고정_함수, m→글, 0). }
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_복사이면 {
        임시적재(RAX, m→a).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_적재이면 {
        정수 t = 임시타입(m→dst).
        임시적재(RCX, m→a).
        실수형인가(t)이면 { LOAD(RAX, RCX, 0, F비트(t), 0). }
        아니면 정수형인가(t)이면 { LOAD(RAX, RCX, 0, 타입비트(t), 타입부호(t)). }
        아니면 { LOAD(RAX, RCX, 0, 64, 1). }
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_저장이면 {
        정수 t2 = m→타입.
        임시적재(RCX, m→a).
        임시적재(RAX, m→b).
        정수 비트 = 64.
        (정수형인가(t2) 또는 실수형인가(t2))이면 { 비트 = 타입비트(t2). }
        STORE(RCX, 0, RAX, 비트).
        반환.
    }
    op == 명_오프셋이면 {
        임시적재(RAX, m→a).
        m→값 != 0이면 { ALU즉시("add", RAX, m→값). }
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_원소주소이면 {
        임시적재(RAX, m→a).
        임시적재(RCX, m→b).
        m→값 != 1이면 {
            MOV즉시(RDX, m→값, 0).
            IMUL(RCX, RDX).
        }
        ALU("add", RAX, RCX).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_이항이면 { 이항생성(m). 반환. }
    op == 명_비교이면 { 비교생성(m). 반환. }
    op == 명_부호반전이면 {
        정수 t3 = 임시타입(m→dst).
        실수형인가(t3)이면 {
            임시적재(RAX, m→a).
            MOV즉시(RCX, 1 << (F비트(t3) - 1), 1).
            ALU("xor", RAX, RCX).
        }
        아니면 {
            임시적재(RAX, m→a).
            NEG(RAX).
            정규화(RAX, t3).
        }
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_비트반전이면 {
        임시적재(RAX, m→a).
        NOT(RAX).
        정규화(RAX, 임시타입(m→dst)).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_논리부정이면 {
        임시적재(RAX, m→a).
        TEST(RAX, RAX).
        SETCC("e", RAX).
        MOVZX(RAX, RAX, 8).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_변환이면 { 변환생성(m). 반환. }
    op == 명_가변인자이면 {
        임시적재(RCX, m→a).
        MOV즉시(RDX, 8, 0).
        IMUL(RCX, RDX).
        LEA(RAX, RBP, 16 + 8 * G→매개수).
        ALU("add", RAX, RCX).
        LOAD(RAX, RAX, 0, 64, 1).
        임시저장(m→dst, RAX).
        반환.
    }
    op == 명_호출이면 { 호출생성(m). 반환. }
    (* 반환 *)
    m→a >= 0이면 {
        정수 t4 = 임시타입(m→a).
        실수형인가(t4)이면 { MOVSD_LOAD(XMM0, RBP, 정수목록_값(임시슬롯, m→a), F비트(t4)). }
        아니면 { 임시적재(RAX, m→a). }
    }
    아니면 { MOV즉시(RAX, 0, 0). }
    에필로그().
}

[IR함수 참조 f를 함수생성]는 {
    G = f.
    배치().
    라벨(f→이름).
    PUSH(RBP).
    MOV레지(RBP, RSP).
    정수 남음 = 프레임.
    (남음 > 4096)동안 {
        SUB_RSP(4096).
        STORE(RSP, 0, RAX, 64).
        남음 = 남음 - 4096.
    }
    남음 != 0이면 { SUB_RSP(남음). }
    (* 레지스터 매개변수를 홈 슬롯에 저장 *)
    (* 가변 인자 함수는 4개 모두 — 가변인자(k) 가 홈 슬롯을 읽는다 *)
    정수 np = f→매개수.
    np > 4이면 { np = 4. }
    f→가변이면 { np = 4. }
    반복 (정수 i = 0: i < np: i += 1) {
        정수 t = -1.
        i < f→매개수이면 { t = 심볼보기(정수목록_값(f→지역들, i))→타입. }
        (t >= 0 그리고 실수형인가(t))이면 { MOVSD_STORE(RBP, 16 + 8 * i, i, F비트(t)). }
        아니면 { STORE(RBP, 16 + 8 * i, 인자레지(i), 64). }
    }
    반복 (정수 k = 0: k < 동적배열_길이(f→명령들): k += 1) {
        명령생성(동적배열_원소(f→명령들, k)).
    }
    정수목록_해제(임시슬롯).
    G = 없음.
}

(* ===== 시작 코드 (D-07): IR 로 만들어 같은 백엔드로 낸다 ===== *)
[문자열 이름을 임포트추가]는 {
    사전_있는가(임포트있음, 이름)이면 { 반환. }
    문자열 dll = DLL이름(이름).
    정수 di = -1.
    반복 (정수 k = 0: k < 임포트DLL수: k += 1) {
        문자열_같은가(임포트DLL들[k], dll)이면 { di = k. }
    }
    di < 0이면 { 임포트DLL들[임포트DLL수] = dll. di = 임포트DLL수. 임포트DLL수를 증가하다. }
    정수 n = 정수목록_길이(임포트DLL색인).
    임포트이름들[n] = 이름.
    정수목록_추가(임포트DLL색인, di).
    사전_넣기(임포트있음, 이름, 1).
}

[정수 v를 정수 t를 시작상수]는 -> 정수 {
    정수 d = 새임시(t).
    상수내기(d, v).
    반환 d.
}

[문자열 이름을 정수목록 참조 인자들을 정수 ret를 시작호출]는 -> 정수 {
    정수 dst = -1.
    ret >= 0이면 { dst = 새임시(ret). }
    호출내기(dst, 이름, -1, 1, 인자들, -1).
    반환 dst.
}

[시작함수만들기]는 -> IR함수 참조 {
    (* 런타임 외부 함수 (없으면 임포트에 추가) *)
    임포트추가("GetConsoleOutputCP"). 임포트추가("SetConsoleOutputCP"). 임포트추가("GetCommandLineW").
    임포트추가("CommandLineToArgvW"). 임포트추가("WideCharToMultiByte"). 임포트추가("LocalFree").
    임포트추가("malloc"). 임포트추가("ExitProcess").
    정수 I32 = T중간정수.
    정수 U32 = T부호없는중간정수.
    정수 VP = T공허참조.
    IR함수 참조 f = 동적배열_새원소(IR함수들).
    f→심볼 = -1.
    f→이름 = "__글_시작".
    f→명령들 = 동적배열_만들기(크기(명령)).
    f→임시타입들 = 정수목록_만들기().
    f→라벨수 = 0.
    f→지역들 = 정수목록_만들기().
    f→매개수 = 0.
    f→최대인자수 = 0.
    f→가변 = 0.
    정수 argc심볼 = 새심볼(심볼_변수, "argc", I32).
    심볼보기(argc심볼)→저장 = 저장_지역.
    정수목록_추가(f→지역들, argc심볼).
    F = f.
    정수목록 참조 인자 = 정수목록_만들기().
    정수 saved = 시작호출("GetConsoleOutputCP", 인자, U32).
    정수목록_비우기(인자). 정수목록_추가(인자, 시작상수(65001, U32)).
    시작호출("SetConsoleOutputCP", 인자, I32).
    정수목록_비우기(인자).
    정수 cmd = 시작호출("GetCommandLineW", 인자, VP).
    정수 argc_addr = 새임시(참조타입(I32)).
    주소내기(명_지역주소, argc_addr, argc심볼).
    정수목록_비우기(인자). 정수목록_추가(인자, cmd). 정수목록_추가(인자, argc_addr).
    정수 argvw = 시작호출("CommandLineToArgvW", 인자, VP).
    정수 argc32 = 새임시(I32).
    적재내기(argc32, argc_addr).
    정수 argc = 새임시(T정수).
    변환내기(argc, "sext", argc32).
    정수 n1 = 새임시(T정수).
    정수 one = 시작상수(1, T정수).
    이항내기(n1, "add", argc, one).
    정수 nbytes = 새임시(T정수).
    정수 eight = 시작상수(8, T정수).
    이항내기(nbytes, "mul", n1, eight).
    정수목록_비우기(인자). 정수목록_추가(인자, nbytes).
    정수 argv = 시작호출("malloc", 인자, VP).
    정수 i = 새임시(T정수).
    상수내기(i, 0).
    문자열 top = 새라벨("루프").
    문자열 body = 새라벨("몸").
    문자열 done = 새라벨("끝").
    라벨내기(top).
    정수 c = 새임시(T참거짓).
    비교내기(c, "lt", i, argc, T정수).
    분기내기(c, body, done).
    라벨내기(body).
    정수 wslot = 새임시(참조타입(VP)).
    원소주소내기(wslot, argvw, i, 8).
    정수 w = 새임시(VP).
    적재내기(w, wslot).
    정수 zero = 시작상수(0, VP).
    정수목록_비우기(인자).
    정수목록_추가(인자, 시작상수(65001, U32)). 정수목록_추가(인자, 시작상수(0, U32)). 정수목록_추가(인자, w).
    정수목록_추가(인자, 시작상수(-1, I32)). 정수목록_추가(인자, zero). 정수목록_추가(인자, 시작상수(0, I32)).
    정수목록_추가(인자, zero). 정수목록_추가(인자, zero).
    정수 n = 시작호출("WideCharToMultiByte", 인자, I32).
    정수 n64 = 새임시(T정수).
    변환내기(n64, "sext", n).
    정수목록_비우기(인자). 정수목록_추가(인자, n64).
    정수 buf = 시작호출("malloc", 인자, VP).
    정수목록_비우기(인자).
    정수목록_추가(인자, 시작상수(65001, U32)). 정수목록_추가(인자, 시작상수(0, U32)). 정수목록_추가(인자, w).
    정수목록_추가(인자, 시작상수(-1, I32)). 정수목록_추가(인자, buf). 정수목록_추가(인자, n).
    정수목록_추가(인자, zero). 정수목록_추가(인자, zero).
    시작호출("WideCharToMultiByte", 인자, I32).
    정수 aslot = 새임시(참조타입(VP)).
    원소주소내기(aslot, argv, i, 8).
    저장내기(aslot, buf, VP).
    정수 i2 = 새임시(T정수).
    정수 one2 = 시작상수(1, T정수).
    이항내기(i2, "add", i, one2).
    복사내기(i, i2).
    점프내기(top).
    라벨내기(done).
    정수 last = 새임시(참조타입(VP)).
    원소주소내기(last, argv, argc, 8).
    정수 zero2 = 시작상수(0, VP).
    저장내기(last, zero2, VP).
    정수목록_비우기(인자). 정수목록_추가(인자, argvw).
    시작호출("LocalFree", 인자, VP).
    (* 시작하기 *)
    심볼 참조 entry = 심볼보기(진입심볼).
    정수 ft = entry→타입.
    정수목록_비우기(인자).
    entry→매개수 == 2이면 {
        정수 argc_t = 매개타입(ft, 0).
        정수 argc_arg = argc.
        타입비트(argc_t) != 64이면 {
            argc_arg = 새임시(argc_t).
            변환내기(argc_arg, "trunc", argc).
        }
        정수목록_추가(인자, argc_arg). 정수목록_추가(인자, argv).
    }
    정수 ret = 타입보기(ft)→반환타입.
    정수 code32 = -1.
    ret >= 0이면 {
        정수 code = 새임시(ret).
        호출내기(code, entry→이름, -1, 0, 인자, -1).
        code32 = 새임시(U32).
        타입비트(ret) > 32이면 { 변환내기(code32, "trunc", code). }
        아니면 { 변환내기(code32, "zext", code). }
    }
    아니면 {
        호출내기(-1, entry→이름, -1, 0, 인자, -1).
        code32 = 시작상수(0, U32).
    }
    정수목록_비우기(인자). 정수목록_추가(인자, saved).
    시작호출("SetConsoleOutputCP", 인자, I32).
    정수목록_비우기(인자). 정수목록_추가(인자, code32).
    시작호출("ExitProcess", 인자, -1).
    반환내기(-1).
    정수목록_해제(인자).
    F = 없음.
    반환 f.
}

(* ===== 전체 생성 ===== *)
[생성]는 {
    어셈초기화().
    코드고정들 = 안정배열_만들기(크기(고정)).
    데이터 = 바이트열_만들기().
    데이터절대고정들 = 안정배열_만들기(크기(고정)).
    데이터전역 = 사전_만들기().
    임포트DLL색인 = 정수목록_만들기().
    임포트있음 = 사전_만들기().
    (* 임포트: 사용자 외부 선언 순서, 그다음 런타임 *)
    반복 (정수 k = 0: k < 정수목록_길이(외부목록): k += 1) {
        임포트추가(심볼보기(정수목록_값(외부목록, k))→링크이름).
    }
    정수 사용자함수수 = 동적배열_길이(IR함수들).
    IR함수 참조 start = 시작함수만들기().
    심볼슬롯 = 초기할당(안정배열_길이(심볼들) + 1, 8).
    함수생성(start).
    반복 (정수 fi = 0: fi < 사용자함수수: fi += 1) {
        함수생성(동적배열_원소(IR함수들, fi)).
    }
    라벨해결().
    진입오프셋 = 사전_값(라벨표, "__글_시작").
    (* 코드 고정: func 라벨은 코드 안 상대 주소로 바로 해결 *)
    반복 (정수 k2 = 0: k2 < 안정배열_길이(외부고정들): k2 += 1) {
        고정 참조 fx = 안정배열_원소(외부고정들, k2).
        fx→종류 == 고정_함수이면 {
            정수 대상위치 = 사전_값_기본(라벨표, fx→대상, -1).
            대상위치 < 0이면 { 파일에_쓰기(표준오류(), "내부 오류: 함수 라벨 없음: %s\n", fx→대상). 종료(2). }
            바이트열_고치기32(코드, fx→위치, 대상위치 - (fx→위치 + 4)).
        }
        아니면 {
            고정 참조 c = 안정배열_새원소(코드고정들).
            c→위치 = fx→위치. c→종류 = fx→종류. c→대상 = fx→대상. c→색인 = fx→색인.
        }
    }
    (* 전역 데이터 *)
    반복 (정수 g = 0: g < 정수목록_길이(전역심볼들): g += 1) {
        심볼 참조 gs = 심볼보기(정수목록_값(전역심볼들, g)).
        정수 t = gs→타입.
        정수 크기값 = 타입크기(t).
        크기값 < 1이면 { 크기값 = 1. }
        정수 al = 타입보기(t)→정렬.
        al < 1이면 { al = 1. }
        al > 16이면 { al = 16. }
        정수 off = 올림(바이트열_길이(데이터), al).
        바이트열_채우기(데이터, off - 바이트열_길이(데이터)).
        사전_넣기(데이터전역, gs→이름, off).
        gs→초기종류 == 0이면 { 바이트열_채우기(데이터, 크기값). }
        아니면 gs→초기종류 == 3이면 {
            고정 참조 d = 안정배열_새원소(데이터절대고정들).
            d→위치 = off. d→종류 = 고정_문자열. d→대상 = 없음. d→색인 = gs→초기값.
            바이트열_채우기(데이터, 8).
        }
        아니면 gs→초기종류 == 2이면 {
            타입비트(t) == 64이면 { 바이트열_넣기64(데이터, gs→초기값). }
            아니면 {
                실수비트64 u.
                u의 i = gs→초기값.
                바이트열_넣기32(데이터, 실수를비트로(u의 f, 32)).
            }
        }
        아니면 {
            정수 비트 = 64.
            정수형인가(t)이면 { 비트 = 타입비트(t). }
            정수 v = gs→초기값.
            비트 == 8이면 { 바이트열_넣기(데이터, v & 255). }
            아니면 비트 == 16이면 { 바이트열_넣기16(데이터, v). }
            아니면 비트 == 32이면 { 바이트열_넣기32(데이터, v). }
            아니면 { 바이트열_넣기64(데이터, v). }
        }
    }
}

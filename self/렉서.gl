(* 자체호스팅 1단계 — 렉서 (명세 2.1). 참조 구현 ref/geul/lexer.py 와 같은 토큰 덤프를 낸다.
   사용: 렉서 <파일.gl>   → 표준출력에 토큰 덤프 (docs/05-덤프-형식.md)
   제한: 입력이 NFC 라고 가정한다 (참조 구현은 NFC 정규화를 한다). *)

포함 "표준/입출력.gl"

(* ===== 표 ===== *)
상수 정수 키워드수 = 44.
문자열[44] 키워드표.
상수 정수 접사수 = 14.
문자열[14] 접사표.
상수 정수 기호수 = 40.
문자열[40] 기호표.

[표초기화]는 {
    키워드표[0] = "정수". 키워드표[1] = "긴정수". 키워드표[2] = "중간정수". 키워드표[3] = "짧은정수".
    키워드표[4] = "작은정수". 키워드표[5] = "부호없는". 키워드표[6] = "실수". 키워드표[7] = "짧은실수".
    키워드표[8] = "문자". 키워드표[9] = "문자열". 키워드표[10] = "참거짓". 키워드표[11] = "공허".
    키워드표[12] = "참조". 키워드표[13] = "참". 키워드표[14] = "거짓". 키워드표[15] = "없음".
    키워드표[16] = "포함". 키워드표[17] = "외부". 키워드표[18] = "정적". 키워드표[19] = "상수".
    키워드표[20] = "별칭". 키워드표[21] = "묶음". 키워드표[22] = "나열". 키워드표[23] = "합침".
    키워드표[24] = "반환". 키워드표[25] = "이면". 키워드표[26] = "아니면". 키워드표[27] = "동안".
    키워드표[28] = "반복". 키워드표[29] = "반복하기". 키워드표[30] = "갈래". 키워드표[31] = "경우".
    키워드표[32] = "기본". 키워드표[33] = "탈출". 키워드표[34] = "계속". 키워드표[35] = "그리고".
    키워드표[36] = "또는". 키워드표[37] = "아닌". 키워드표[38] = "크기". 키워드표[39] = "시작하기".
    키워드표[40] = "정수". 키워드표[41] = "정수". 키워드표[42] = "정수". 키워드표[43] = "정수".
    접사표[0] = "에서". 접사표[1] = "으로". 접사표[2] = "보다". 접사표[3] = "을". 접사표[4] = "를".
    접사표[5] = "에". 접사표[6] = "로". 접사표[7] = "와". 접사표[8] = "과". 접사표[9] = "이".
    접사표[10] = "가". 접사표[11] = "은". 접사표[12] = "는". 접사표[13] = "의".
    (* 긴 것부터 *)
    기호표[0] = "<<=". 기호표[1] = ">>=". 기호표[2] = "...". 기호표[3] = "->". 기호표[4] = "<=".
    기호표[5] = ">=". 기호표[6] = "==". 기호표[7] = "!=". 기호표[8] = "<<". 기호표[9] = ">>".
    기호표[10] = "+=". 기호표[11] = "-=". 기호표[12] = "*=". 기호표[13] = "/=". 기호표[14] = "%=".
    기호표[15] = "&=". 기호표[16] = "|=". 기호표[17] = "^=". 기호표[18] = "(". 기호표[19] = ")".
    기호표[20] = "[". 기호표[21] = "]". 기호표[22] = "\{". 기호표[23] = "\}". 기호표[24] = ",".
    기호표[25] = ":". 기호표[26] = "&". 기호표[27] = "+". 기호표[28] = "-". 기호표[29] = "*".
    기호표[30] = "/". 기호표[31] = "%". 기호표[32] = "<". 기호표[33] = ">". 기호표[34] = "^".
    기호표[35] = "|". 기호표[36] = "~". 기호표[37] = "?". 기호표[38] = "=". 기호표[39] = "→".
}

(* ===== 상태 ===== *)
문자열 파일이름.
문자열 소스.
정수 길이.
정수 위치.
정수 줄.
정수 열.

[정수 오류줄을 정수 오류열을 문자열 메시지를 오류]는 {
    파일에_쓰기(표준오류(), "%s:%lld:%lld: 오류: %s\n", 파일이름, 오류줄, 오류열, 메시지).
    종료(1).
}

(* ===== UTF-8 ===== *)
[정수 p를 바이트]는 -> 정수 {
    p >= 길이이면 { 반환 0. }
    정수 b = 소스[p].
    b < 0이면 { b = b + 256. }
    반환 b.
}

[정수 p를 글자바이트수]는 -> 정수 {
    정수 b = 바이트(p).
    b < 128이면 { 반환 1. }
    b >= 240이면 { 반환 4. }
    b >= 224이면 { 반환 3. }
    b >= 192이면 { 반환 2. }
    반환 1.
}

[정수 p를 코드포인트]는 -> 정수 {
    정수 b = 바이트(p).
    b < 128이면 { 반환 b. }
    정수 n = 글자바이트수(p).
    n == 2이면 { 반환 ((b & 31) << 6) | (바이트(p + 1) & 63). }
    n == 3이면 { 반환 ((b & 15) << 12) | ((바이트(p + 1) & 63) << 6) | (바이트(p + 2) & 63). }
    반환 ((b & 7) << 18) | ((바이트(p + 1) & 63) << 12) | ((바이트(p + 2) & 63) << 6) | (바이트(p + 3) & 63).
}

[정수 cp를 한글인가]는 -> 참거짓 {
    (cp >= 44032 그리고 cp <= 55203)이면 { 반환 참. }
    (cp >= 4352 그리고 cp <= 4607)이면 { 반환 참. }
    (cp >= 12592 그리고 cp <= 12687)이면 { 반환 참. }
    반환 거짓.
}

[정수 cp를 라틴시작인가]는 -> 참거짓 {
    반환 cp == 95 또는 (cp >= 97 그리고 cp <= 122) 또는 (cp >= 65 그리고 cp <= 90).
}

[정수 cp를 숫자인가]는 -> 참거짓 {
    반환 cp >= 48 그리고 cp <= 57.
}

[정수 cp를 이름글자인가]는 -> 참거짓 {
    반환 한글인가(cp) 또는 라틴시작인가(cp) 또는 숫자인가(cp).
}

(* 현재 위치에서 코드포인트 하나 전진 *)
[전진]는 {
    위치 >= 길이이면 { 반환. }
    바이트(위치) == 10이면 {
        줄을 증가하다.
        열 = 1.
        위치를 증가하다.
        반환.
    }
    위치 = 위치 + 글자바이트수(위치).
    열을 증가하다.
}

[정수 n을 n전진]는 {
    (n > 0)동안 { 전진(). n을 감소하다. }
}

(* ===== 출력 ===== *)
[정수 토큰줄을 정수 토큰열을 문자열 종류를 정수 시작을 정수 끝을 토큰출력]는 {
    쓰기("%lld:%lld\t%s\t%.*s\n", 토큰줄, 토큰열, 종류, 끝 - 시작, 소스 + 시작).
}

(* 소스[시작..끝) 가 문자열 s 와 같은가 *)
[정수 시작을 정수 끝을 문자열 s를 조각같은가]는 -> 참거짓 {
    정수 n = 글자수(s).
    끝 - 시작 != n이면 { 반환 거짓. }
    반환 메모리_비교(소스 + 시작, s, n) == 0.
}

[정수 p를 문자열 s를 조각시작하는가]는 -> 참거짓 {
    정수 n = 글자수(s).
    p + n > 길이이면 { 반환 거짓. }
    반환 메모리_비교(소스 + p, s, n) == 0.
}

(* ===== 공백·주석 ===== *)
[주석건너뛰기]는 {
    정수 시작줄 = 줄.
    정수 시작열 = 열.
    정수 깊이 = 0.
    (위치 < 길이)동안 {
        (바이트(위치) == 40 그리고 바이트(위치 + 1) == 42)이면 {
            깊이를 증가하다.
            n전진(2).
        }
        아니면 (바이트(위치) == 42 그리고 바이트(위치 + 1) == 41)이면 {
            깊이를 감소하다.
            n전진(2).
            깊이 == 0이면 { 반환. }
        }
        아니면 {
            전진().
        }
    }
    오류(시작줄, 시작열, "주석이 닫히지 않았습니다").
}

[공백건너뛰기]는 {
    (위치 < 길이)동안 {
        정수 b = 바이트(위치).
        (b == 32 또는 b == 9 또는 b == 10 또는 b == 13)이면 { 전진(). }
        아니면 (b == 40 그리고 바이트(위치 + 1) == 42)이면 { 주석건너뛰기(). }
        아니면 { 반환. }
    }
}

(* ===== 토큰 ===== *)
[숫자읽기]는 {
    정수 시작 = 위치. 정수 시작줄 = 줄. 정수 시작열 = 열.
    (바이트(위치) == 48 그리고 (바이트(위치 + 1) == 120 또는 바이트(위치 + 1) == 88))이면 {
        n전진(2).
        정수 자릿수 = 0.
        (위치 < 길이)동안 {
            정수 b = 바이트(위치).
            정수 십육진 = 숫자인가(b) 또는 (b >= 97 그리고 b <= 102) 또는 (b >= 65 그리고 b <= 70).
            아닌 십육진이면 { 탈출. }
            전진(). 자릿수를 증가하다.
        }
        자릿수 == 0이면 { 오류(시작줄, 시작열, "16진 리터럴에 숫자가 없습니다"). }
        토큰출력(시작줄, 시작열, "정수리터럴", 시작, 위치).
        반환.
    }
    정수 이전밑줄 = 0.
    (위치 < 길이 그리고 (숫자인가(바이트(위치)) 또는 바이트(위치) == 95))동안 {
        바이트(위치) == 95이면 {
            (아닌 숫자인가(바이트(위치 + 1)) 또는 이전밑줄)이면 {
                오류(시작줄, 시작열, "정수 리터럴의 밑줄은 숫자 사이에만 올 수 있습니다").
            }
            이전밑줄 = 1.
        }
        아니면 { 이전밑줄 = 0. }
        전진().
    }
    참거짓 실수형 = 거짓.
    (바이트(위치) == 46 그리고 숫자인가(바이트(위치 + 1)))이면 {
        실수형 = 참.
        전진().
        (숫자인가(바이트(위치)))동안 { 전진(). }
        정수 e = 바이트(위치).
        (e == 101 또는 e == 69)이면 {
            (숫자인가(바이트(위치 + 1)) 또는 (바이트(위치 + 1) == 45 그리고 숫자인가(바이트(위치 + 2))))이면 {
                전진().
                바이트(위치) == 45이면 { 전진(). }
                (숫자인가(바이트(위치)))동안 { 전진(). }
            }
        }
    }
    실수형이면 { 토큰출력(시작줄, 시작열, "실수리터럴", 시작, 위치). }
    아니면 { 토큰출력(시작줄, 시작열, "정수리터럴", 시작, 위치). }
}

[단어읽기]는 {
    정수 시작 = 위치. 정수 시작줄 = 줄. 정수 시작열 = 열.
    참거짓 라틴시작 = 라틴시작인가(코드포인트(위치)).
    참거짓 한글있음 = 거짓.
    (위치 < 길이 그리고 이름글자인가(코드포인트(위치)))동안 {
        한글인가(코드포인트(위치))이면 { 한글있음 = 참. }
        전진().
    }
    (라틴시작 그리고 아닌 한글있음)이면 {
        토큰출력(시작줄, 시작열, "식별자", 시작, 위치).
        반환.
    }
    반복 (정수 i = 0: i < 키워드수: i += 1) {
        조각같은가(시작, 위치, 키워드표[i])이면 {
            토큰출력(시작줄, 시작열, "키워드", 시작, 위치).
            반환.
        }
    }
    반복 (정수 j = 0: j < 접사수: j += 1) {
        조각같은가(시작, 위치, 접사표[j])이면 {
            토큰출력(시작줄, 시작열, "접사", 시작, 위치).
            반환.
        }
    }
    토큰출력(시작줄, 시작열, "단어", 시작, 위치).
}

[정수 e를 이스케이프인가]는 -> 참거짓 {
    반환 e == 110 또는 e == 116 또는 e == 114 또는 e == 48 또는 e == 92 또는 e == 34 또는 e == 123 또는 e == 125 또는 e == 39.
}

[문자열읽기]는 {
    정수 시작 = 위치. 정수 시작줄 = 줄. 정수 시작열 = 열.
    전진().
    (참)동안 {
        정수 b = 바이트(위치).
        (위치 >= 길이 또는 b == 10)이면 { 오류(시작줄, 시작열, "문자열이 닫히지 않았습니다"). }
        b == 34이면 { 전진(). 탈출. }
        b == 92이면 {
            아닌 이스케이프인가(바이트(위치 + 1))이면 {
                문자[64] 메시지.
                버퍼에_쓰기(메시지, 64, "알 수 없는 이스케이프 '\\%c'", 바이트(위치 + 1)).
                오류(줄, 열, 메시지).
            }
            n전진(2).
        }
        아니면 { 전진(). }
    }
    토큰출력(시작줄, 시작열, "문자열리터럴", 시작, 위치).
}

[문자읽기]는 {
    정수 시작 = 위치. 정수 시작줄 = 줄. 정수 시작열 = 열.
    전진().
    정수 b = 바이트(위치).
    b == 92이면 {
        아닌 이스케이프인가(바이트(위치 + 1))이면 {
            문자[64] 메시지.
            버퍼에_쓰기(메시지, 64, "알 수 없는 이스케이프 '\\%c'", 바이트(위치 + 1)).
            오류(시작줄, 시작열, 메시지).
        }
        n전진(2).
    }
    아니면 {
        (위치 >= 길이 또는 b == 39)이면 { 오류(시작줄, 시작열, "문자 리터럴이 비어 있습니다"). }
        코드포인트(위치) > 127이면 { 오류(시작줄, 시작열, "문자 리터럴은 코드포인트 127 이하만 허용됩니다 (한글은 문자열로)"). }
        전진().
    }
    바이트(위치) != 39이면 { 오류(시작줄, 시작열, "문자 리터럴이 닫히지 않았습니다"). }
    전진().
    토큰출력(시작줄, 시작열, "문자리터럴", 시작, 위치).
}

[기호읽기]는 {
    정수 시작 = 위치. 정수 시작줄 = 줄. 정수 시작열 = 열.
    반복 (정수 i = 0: i < 기호수: i += 1) {
        조각시작하는가(위치, 기호표[i])이면 {
            i == 39이면 {
                (* → 는 -> 의 어휘 별칭 *)
                전진().
                쓰기("%lld:%lld\t기호\t->\n", 시작줄, 시작열).
                반환.
            }
            정수 n = 글자수(기호표[i]).
            n전진(n).
            토큰출력(시작줄, 시작열, "기호", 시작, 위치).
            반환.
        }
    }
    문자[64] 메시지.
    버퍼에_쓰기(메시지, 64, "알 수 없는 문자 '%.*s'", 글자바이트수(위치), 소스 + 위치).
    오류(시작줄, 시작열, 메시지).
}

[토큰화]는 {
    (참)동안 {
        공백건너뛰기().
        위치 >= 길이이면 {
            쓰기("%lld:%lld\t끝\t\n", 줄, 열).
            반환.
        }
        정수 b = 바이트(위치).
        정수 cp = 코드포인트(위치).
        숫자인가(b)이면 { 숫자읽기(). }
        아니면 (한글인가(cp) 또는 라틴시작인가(cp))이면 { 단어읽기(). }
        아니면 b == 34이면 { 문자열읽기(). }
        아니면 b == 39이면 { 문자읽기(). }
        아니면 b == 46이면 {
            정수 다음 = 바이트(위치 + 1).
            (위치 + 1 >= 길이 또는 다음 == 32 또는 다음 == 9 또는 다음 == 10 또는 다음 == 13 또는 다음 == 125 또는 다음 == 41)이면 {
                쓰기("%lld:%lld\t종결\t.\n", 줄, 열).
                전진().
            }
            아니면 (다음 == 46 그리고 바이트(위치 + 2) == 46)이면 {
                쓰기("%lld:%lld\t기호\t...\n", 줄, 열).
                n전진(3).
            }
            아니면 {
                오류(줄, 열, "'.' 뒤에는 공백, 줄바꿈, '}' 또는 ')'가 와야 합니다").
            }
        }
        아니면 { 기호읽기(). }
    }
}

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    argc < 2이면 {
        파일에_쓰기(표준오류(), "사용법: 렉서 <파일.gl>\n").
        반환 3.
    }
    표초기화().
    파일이름 = argv[1].
    소스 = 파일_전체읽기(파일이름).
    소스 == 없음이면 {
        파일에_쓰기(표준오류(), "%s:0:0: 오류: 파일을 열 수 없습니다\n", 파일이름).
        반환 1.
    }
    길이 = 글자수(소스).
    (* BOM 제거 *)
    (길이 >= 3 그리고 바이트(0) == 239 그리고 바이트(1) == 187 그리고 바이트(2) == 191)이면 {
        소스 = 소스 + 3.
        길이 = 길이 - 3.
    }
    (* CRLF → LF *)
    정수 쓰기위치 = 0.
    반복 (정수 i = 0: i < 길이: i += 1) {
        (소스[i] == 13 그리고 소스[i + 1] == 10)이면 { 계속. }
        소스[쓰기위치] = 소스[i].
        쓰기위치를 증가하다.
    }
    소스[쓰기위치] = 0.
    길이 = 쓰기위치.
    위치 = 0. 줄 = 1. 열 = 1.
    토큰화().
    반환 0.
}

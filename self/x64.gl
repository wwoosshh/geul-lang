(* 자체호스팅 4단계 — x86-64 인코더 (ref/geul/x64.py). 필요한 명령만, 항상 명시적 인코딩.
   메모리 피연산자는 [base+disp32] 또는 [rip+disp32]. *)

포함 "표준/바이트열.gl"
포함 "표준/사전.gl"
포함 "표준/배열.gl"

상수 정수 RAX = 0.
상수 정수 RCX = 1.
상수 정수 RDX = 2.
상수 정수 RBX = 3.
상수 정수 RSP = 4.
상수 정수 RBP = 5.
상수 정수 RSI = 6.
상수 정수 RDI = 7.
상수 정수 R8 = 8.
상수 정수 R9 = 9.
상수 정수 R10 = 10.
상수 정수 R11 = 11.
상수 정수 R12 = 12.
상수 정수 R13 = 13.
상수 정수 R14 = 14.
상수 정수 R15 = 15.
상수 정수 XMM0 = 0.
상수 정수 XMM1 = 1.
(* XMM6-XMM15 는 피호출자 보존: 실수 값 할당 (D-20) *)
(* XMM6-XMM15 는 피호출자 보존: 실수 값 할당 (D-20) *)
상수 정수 기준없음 = -1.

(* 고정 종류 *)
상수 정수 고정_라벨 = 0.
상수 정수 고정_IAT = 1.
상수 정수 고정_문자열 = 2.
상수 정수 고정_데이터 = 3.
상수 정수 고정_함수 = 4.

묶음 고정은 정수 위치, 정수 종류, 문자열 대상, 정수 색인.

바이트열 참조 코드.
사전 참조 라벨표.
안정배열 참조 라벨고정들.
안정배열 참조 외부고정들.

[어셈초기화]는 {
    코드 = 바이트열_만들기().
    라벨표 = 사전_만들기().
    라벨고정들 = 안정배열_만들기(크기(고정)).
    외부고정들 = 안정배열_만들기(크기(고정)).
}

[정수 b를 바이트내기]는 { 바이트열_넣기(코드, b & 255). }
[정수 v를 바이트32내기]는 { 바이트열_넣기32(코드, v). }
[정수 v를 바이트64내기]는 { 바이트열_넣기64(코드, v). }
[코드위치]는 -> 정수 { 반환 바이트열_길이(코드). }

[문자열 이름을 라벨]는 {
    사전_있는가(라벨표, 이름)이면 {
        파일에_쓰기(표준오류(), "내부 오류: 중복 라벨: {이름}\n").
        2로 종료하다.
    }
    사전_넣기(라벨표, 이름, 코드위치()).
}

[정수 r를 인자레지]는 -> 정수 {
    r == 0이면 { 반환 RCX. }
    r == 1이면 { 반환 RDX. }
    r == 2이면 { 반환 R8. }
    반환 R9.
}

[문자열 cc를 조건코드]는 -> 정수 {
    문자열_같은가(cc, "e")이면 { 반환 4. }
    문자열_같은가(cc, "ne")이면 { 반환 5. }
    문자열_같은가(cc, "l")이면 { 반환 12. }
    문자열_같은가(cc, "ge")이면 { 반환 13. }
    문자열_같은가(cc, "le")이면 { 반환 14. }
    문자열_같은가(cc, "g")이면 { 반환 15. }
    문자열_같은가(cc, "b")이면 { 반환 2. }
    문자열_같은가(cc, "ae")이면 { 반환 3. }
    문자열_같은가(cc, "be")이면 { 반환 6. }
    문자열_같은가(cc, "a")이면 { 반환 7. }
    문자열_같은가(cc, "p")이면 { 반환 10. }
    반환 11.
}

[정수 base를 기준레지]는 -> 정수 {
    base < 0이면 { 반환 0. }
    반환 base.
}

(* ---------- 기본 ---------- *)
[정수 w를 정수 r를 정수 x를 정수 b를 정수 강제를 REX]는 {
    정수 v = 64 | (w << 3) | ((r >> 3) << 2) | ((x >> 3) << 1) | (b >> 3).
    (v != 64 또는 강제)이면 { 바이트내기(v). }
}

[정수 mod를 정수 reg를 정수 rm를 MODRM]는 {
    바이트내기((mod << 6) | ((reg & 7) << 3) | (rm & 7)).
}

(* [base+disp32] 형태 ModRM (+SIB). base 가 기준없음이면 [rip+disp32] *)
[정수 reg를 정수 base를 정수 disp를 MEM]는 {
    base < 0이면 {
        MODRM(0, reg, 5).
        disp를 바이트32내다.
        반환.
    }
    (base & 7) == 4이면 {
        MODRM(2, reg, 4).
        36를 바이트내다.
    }
    아니면 { MODRM(2, reg, base). }
    disp를 바이트32내다.
}

(* [base+index*scale+disp32] 형태 ModRM + SIB *)
[정수 reg를 정수 base를 정수 index를 정수 scale를 정수 disp를 MEM색인]는 {
    MODRM(2, reg, 4).
    정수 sb = 0.
    scale == 2이면 { sb = 1. }
    아니면 scale == 4이면 { sb = 2. }
    아니면 scale == 8이면 { sb = 3. }
    바이트내기((sb << 6) | ((index & 7) << 3) | (base & 7)).
    disp를 바이트32내다.
}

[정수 종류를 문자열 대상을 정수 색인을 RIP고정]는 {
    고정 참조 f = 안정배열_새원소(외부고정들).
    f→위치 = 코드위치() - 4. f→종류 = 종류. f→대상 = 대상. f→색인 = 색인.
}

[정수 종류를 문자열 라벨이름을 라벨고정]는 {
    고정 참조 f = 안정배열_새원소(라벨고정들).
    f→위치 = 코드위치(). f→종류 = 종류. f→대상 = 라벨이름. f→색인 = 0.
}

(* ---------- 정수 mov ---------- *)
(* 부호없음: 값을 64비트 부호없는 수로 본다 (2^63 이상 리터럴, 실수 비트) *)
[정수 r를 정수 v를 정수 부호없음을 MOV즉시]는 {
    (v >= 0 그리고 v < 4294967296)이면 {
        REX(0, 0, 0, r, 0).
        바이트내기(184 + (r & 7)).
        v를 바이트32내다.
        반환.
    }
    (아닌 부호없음 그리고 v >= -2147483648 그리고 v < 0)이면 {
        REX(1, 0, 0, r, 0).
        199를 바이트내다.
        MODRM(3, 0, r).
        v를 바이트32내다.
        반환.
    }
    REX(1, 0, 0, r, 0).
    바이트내기(184 + (r & 7)).
    v를 바이트64내다.
}

[정수 dst를 정수 src를 MOV레지]는 {
    REX(1, src, 0, dst, 0). 바이트내기(137). MODRM(3, src, dst).
}

(* r <- [base+disp], 64비트로 확장 *)
[정수 r를 정수 base를 정수 disp를 정수 비트를 정수 부호를 LOAD]는 {
    정수 b = 기준레지(base).
    비트 == 64이면 { REX(1, r, 0, b, 0). 바이트내기(139). MEM(r, base, disp). 반환. }
    비트 == 32이면 {
        부호이면 { REX(1, r, 0, b, 0). 바이트내기(99). MEM(r, base, disp). }
        아니면 { REX(0, r, 0, b, 0). 바이트내기(139). MEM(r, base, disp). }
        반환.
    }
    비트 == 16이면 {
        REX(1, r, 0, b, 0). 바이트내기(15).
        부호이면 { 바이트내기(191). } 아니면 { 바이트내기(183). }
        MEM(r, base, disp).
        반환.
    }
    REX(1, r, 0, b, 0). 바이트내기(15).
    부호이면 { 바이트내기(190). } 아니면 { 바이트내기(182). }
    MEM(r, base, disp).
}

[정수 base를 정수 disp를 정수 r를 정수 비트를 STORE]는 {
    정수 b = 기준레지(base).
    비트 == 64이면 { REX(1, r, 0, b, 0). 바이트내기(137). MEM(r, base, disp). 반환. }
    비트 == 32이면 { REX(0, r, 0, b, 0). 바이트내기(137). MEM(r, base, disp). 반환. }
    비트 == 16이면 { 바이트내기(102). REX(0, r, 0, b, 0). 바이트내기(137). MEM(r, base, disp). 반환. }
    REX(0, r, 0, b, r >= 4). 바이트내기(136). MEM(r, base, disp).
}

[정수 r를 정수 base를 정수 disp를 LEA]는 {
    REX(1, r, 0, 기준레지(base), 0). 바이트내기(141). MEM(r, base, disp).
}

(* r <- [base+index*scale+disp], 64비트로 확장 *)
[정수 r를 정수 base를 정수 index를 정수 scale를 정수 disp를 정수 비트를 정수 부호를 LOAD색인]는 {
    비트 == 64이면 { REX(1, r, index, base, 0). 바이트내기(139). MEM색인(r, base, index, scale, disp). 반환. }
    비트 == 32이면 {
        부호이면 { REX(1, r, index, base, 0). 바이트내기(99). MEM색인(r, base, index, scale, disp). }
        아니면 { REX(0, r, index, base, 0). 바이트내기(139). MEM색인(r, base, index, scale, disp). }
        반환.
    }
    비트 == 16이면 {
        REX(1, r, index, base, 0). 바이트내기(15).
        부호이면 { 바이트내기(191). } 아니면 { 바이트내기(183). }
        MEM색인(r, base, index, scale, disp).
        반환.
    }
    REX(1, r, index, base, 0). 바이트내기(15).
    부호이면 { 바이트내기(190). } 아니면 { 바이트내기(182). }
    MEM색인(r, base, index, scale, disp).
}

[정수 base를 정수 index를 정수 scale를 정수 disp를 정수 r를 정수 비트를 STORE색인]는 {
    비트 == 64이면 { REX(1, r, index, base, 0). 바이트내기(137). MEM색인(r, base, index, scale, disp). 반환. }
    비트 == 32이면 { REX(0, r, index, base, 0). 바이트내기(137). MEM색인(r, base, index, scale, disp). 반환. }
    비트 == 16이면 { 바이트내기(102). REX(0, r, index, base, 0). 바이트내기(137). MEM색인(r, base, index, scale, disp). 반환. }
    REX(0, r, index, base, r >= 4). 바이트내기(136). MEM색인(r, base, index, scale, disp).
}

[정수 r를 정수 base를 정수 index를 정수 scale를 정수 disp를 LEA색인]는 {
    REX(1, r, index, base, 0). 바이트내기(141). MEM색인(r, base, index, scale, disp).
}

[정수 base를 정수 index를 정수 scale를 정수 disp를 정수 v를 정수 비트를 STORE즉시색인]는 {
    비트 == 64이면 { REX(1, 0, index, base, 0). 바이트내기(199). MEM색인(0, base, index, scale, disp). 바이트32내기(v). 반환. }
    비트 == 32이면 { REX(0, 0, index, base, 0). 바이트내기(199). MEM색인(0, base, index, scale, disp). 바이트32내기(v). 반환. }
    비트 == 16이면 { 바이트내기(102). REX(0, 0, index, base, 0). 바이트내기(199). MEM색인(0, base, index, scale, disp). 바이트내기(v & 255). 바이트내기((v >> 8) & 255). 반환. }
    REX(0, 0, index, base, 0). 바이트내기(198). MEM색인(0, base, index, scale, disp). 바이트내기(v & 255).
}

[정수 dst를 정수 src를 정수 비트를 MOVSX]는 {
    비트 == 8이면 { REX(1, dst, 0, src, 1). 바이트내기(15). 바이트내기(190). MODRM(3, dst, src). }
    아니면 비트 == 16이면 { REX(1, dst, 0, src, 0). 바이트내기(15). 바이트내기(191). MODRM(3, dst, src). }
    아니면 비트 == 32이면 { REX(1, dst, 0, src, 0). 바이트내기(99). MODRM(3, dst, src). }
}

[정수 dst를 정수 src를 정수 비트를 MOVZX]는 {
    비트 == 8이면 { REX(1, dst, 0, src, 1). 바이트내기(15). 바이트내기(182). MODRM(3, dst, src). }
    아니면 비트 == 16이면 { REX(1, dst, 0, src, 0). 바이트내기(15). 바이트내기(183). MODRM(3, dst, src). }
    아니면 비트 == 32이면 { REX(0, dst, 0, src, 0). 바이트내기(139). MODRM(3, dst, src). }
}

(* ---------- 산술 ---------- *)
[문자열 op를 ALU코드]는 -> 정수 {
    문자열_같은가(op, "add")이면 { 반환 1. }
    문자열_같은가(op, "or")이면 { 반환 9. }
    문자열_같은가(op, "and")이면 { 반환 33. }
    문자열_같은가(op, "sub")이면 { 반환 41. }
    문자열_같은가(op, "xor")이면 { 반환 49. }
    반환 57.
}

[문자열 op를 ALU확장]는 -> 정수 {
    문자열_같은가(op, "add")이면 { 반환 0. }
    문자열_같은가(op, "or")이면 { 반환 1. }
    문자열_같은가(op, "and")이면 { 반환 4. }
    문자열_같은가(op, "sub")이면 { 반환 5. }
    문자열_같은가(op, "xor")이면 { 반환 6. }
    반환 7.
}

(* dst op= src (64비트). op: add or and sub xor cmp *)
[문자열 op를 정수 dst를 정수 src를 ALU]는 {
    REX(1, src, 0, dst, 0). 바이트내기(ALU코드(op)). MODRM(3, src, dst).
}

[문자열 op를 정수 dst를 정수 imm를 ALU즉시]는 {
    REX(1, 0, 0, dst, 0). 바이트내기(129). MODRM(3, ALU확장(op), dst). 바이트32내기(imm).
}

[정수 dst를 정수 src를 IMUL]는 { REX(1, dst, 0, src, 0). 바이트내기(15). 바이트내기(175). MODRM(3, dst, src). }

(* dst <- src * imm32 *)
[정수 dst를 정수 src를 정수 imm를 IMUL즉시]는 { REX(1, dst, 0, src, 0). 바이트내기(105). MODRM(3, dst, src). 바이트32내기(imm). }

[문자열 op를 정수 r를 정수 n을 SHIFT즉시]는 {
    정수 ext = 4.
    문자열_같은가(op, "shr")이면 { ext = 5. }
    아니면 문자열_같은가(op, "sar")이면 { ext = 7. }
    REX(1, 0, 0, r, 0). 바이트내기(193). MODRM(3, ext, r). 바이트내기(n & 63).
}

(* [base+disp] <- imm (비트 크기) *)
[정수 base를 정수 disp를 정수 v를 정수 비트를 STORE즉시]는 {
    정수 b = 기준레지(base).
    비트 == 64이면 { REX(1, 0, 0, b, 0). 바이트내기(199). MEM(0, base, disp). 바이트32내기(v). 반환. }
    비트 == 32이면 { REX(0, 0, 0, b, 0). 바이트내기(199). MEM(0, base, disp). 바이트32내기(v). 반환. }
    비트 == 16이면 { 바이트내기(102). REX(0, 0, 0, b, 0). 바이트내기(199). MEM(0, base, disp). 바이트내기(v & 255). 바이트내기((v >> 8) & 255). 반환. }
    REX(0, 0, 0, b, 0). 바이트내기(198). MEM(0, base, disp). 바이트내기(v & 255).
}
[CQO]는 { 바이트내기(72). 바이트내기(153). }
[정수 r를 IDIV]는 { REX(1, 0, 0, r, 0). 바이트내기(247). MODRM(3, 7, r). }
[정수 r를 DIV]는 { REX(1, 0, 0, r, 0). 바이트내기(247). MODRM(3, 6, r). }

[문자열 op를 정수 r를 SHIFT_CL]는 {
    정수 ext = 4.
    문자열_같은가(op, "shr")이면 { ext = 5. }
    아니면 문자열_같은가(op, "sar")이면 { ext = 7. }
    REX(1, 0, 0, r, 0). 바이트내기(211). MODRM(3, ext, r).
}

[정수 r를 NEG]는 { REX(1, 0, 0, r, 0). 바이트내기(247). MODRM(3, 3, r). }
[정수 r를 NOT]는 { REX(1, 0, 0, r, 0). 바이트내기(247). MODRM(3, 2, r). }
[정수 a를 정수 b를 TEST]는 { REX(1, b, 0, a, 0). 바이트내기(133). MODRM(3, b, a). }
[문자열 cc를 정수 r를 SETCC]는 { REX(0, 0, 0, r, r >= 4). 바이트내기(15). 바이트내기(144 + 조건코드(cc)). MODRM(3, 0, r). }

(* ---------- 분기·호출 ---------- *)
[문자열 라벨이름을 JMP]는 { 바이트내기(233). 라벨고정(고정_라벨, 라벨이름). 바이트32내기(0). }
[문자열 cc를 문자열 라벨이름을 JCC]는 { 바이트내기(15). 바이트내기(128 + 조건코드(cc)). 라벨고정(고정_라벨, 라벨이름). 바이트32내기(0). }
[문자열 라벨이름을 CALL라벨]는 { 바이트내기(232). 라벨고정(고정_라벨, 라벨이름). 바이트32내기(0). }
[문자열 이름을 CALL_IAT]는 { 바이트내기(255). 바이트내기(21). 바이트32내기(0). RIP고정(고정_IAT, 이름, 0). }
[정수 r를 CALL레지]는 { REX(0, 0, 0, r, 0). 바이트내기(255). MODRM(3, 2, r). }
[정수 r를 PUSH]는 { REX(0, 0, 0, r, 0). 바이트내기(80 + (r & 7)). }
[정수 r를 POP]는 { REX(0, 0, 0, r, 0). 바이트내기(88 + (r & 7)). }
[RET]는 { 바이트내기(195). }
[정수 n을 SUB_RSP]는 { ALU즉시("sub", RSP, n). }
[정수 n을 ADD_RSP]는 { ALU즉시("add", RSP, n). }

[정수 r를 정수 종류를 문자열 대상을 정수 색인을 LEA_RIP]는 {
    REX(1, r, 0, 0, 0). 바이트내기(141). MODRM(0, r, 5). 바이트32내기(0). RIP고정(종류, 대상, 색인).
}

[정수 r를 정수 종류를 문자열 대상을 정수 색인을 LOAD_RIP]는 {
    REX(1, r, 0, 0, 0). 바이트내기(139). MODRM(0, r, 5). 바이트32내기(0). RIP고정(종류, 대상, 색인).
}

(* ---------- SSE ---------- *)
(* rm_reg 가 -1 이면 메모리 형태 [base+disp] *)
[정수 prefix를 정수 opcode를 정수 reg를 정수 rm_reg를 정수 base를 정수 disp를 정수 w를 SSE]는 {
    prefix != 0이면 { 바이트내기(prefix). }
    rm_reg >= 0이면 {
        REX(w, reg, 0, rm_reg, 0). 바이트내기(15). 바이트내기(opcode). MODRM(3, reg, rm_reg).
        반환.
    }
    REX(w, reg, 0, 기준레지(base), 0). 바이트내기(15). 바이트내기(opcode). MEM(reg, base, disp).
}

(* [base+index*scale+disp] 메모리 피연산자를 쓰는 SSE *)
[정수 prefix를 정수 opcode를 정수 reg를 정수 base를 정수 index를 정수 scale를 정수 disp를 SSE색인]는 {
    prefix != 0이면 { 바이트내기(prefix). }
    REX(0, reg, index, base, 0). 바이트내기(15). 바이트내기(opcode). MEM색인(reg, base, index, scale, disp).
}

(* dst <- src (XMM 128비트 복사) *)
[정수 dst를 정수 src를 MOVAPS]는 { SSE(0, 40, dst, src, 0, 0, 0). }
[정수 x를 정수 base를 정수 disp를 MOVUPS_LOAD]는 { SSE(0, 16, x, -1, base, disp, 0). }
[정수 base를 정수 disp를 정수 x를 MOVUPS_STORE]는 { SSE(0, 17, x, -1, base, disp, 0). }

(* x <- r (정수 레지스터의 비트를 XMM 으로) *)
[정수 x를 정수 r를 MOVQ_XR]는 {
    바이트내기(102). REX(1, x, 0, r, 0). 바이트내기(15). 바이트내기(110). MODRM(3, x, r).
}

(* r <- x 의 하위 비트 (32 이면 영 확장) *)
[정수 r를 정수 x를 정수 비트를 MOVQ_RX]는 {
    102를 바이트내다.
    비트 == 64이면 { REX(1, x, 0, r, 0). } 아니면 { REX(0, x, 0, r, 0). }
    바이트내기(15). 바이트내기(126). MODRM(3, x, r).
}


[정수 비트를 F접두]는 -> 정수 {
    비트 == 64이면 { 반환 242. }
    반환 243.
}

[정수 x를 정수 base를 정수 disp를 정수 비트를 MOVSD_LOAD]는 { SSE(F접두(비트), 16, x, -1, base, disp, 0). }
[정수 base를 정수 disp를 정수 x를 정수 비트를 MOVSD_STORE]는 { SSE(F접두(비트), 17, x, -1, base, disp, 0). }
[정수 x를 정수 base를 정수 index를 정수 scale를 정수 disp를 정수 비트를 MOVSD_LOAD색인]는 { SSE색인(F접두(비트), 16, x, base, index, scale, disp). }
[정수 base를 정수 index를 정수 scale를 정수 disp를 정수 x를 정수 비트를 MOVSD_STORE색인]는 { SSE색인(F접두(비트), 17, x, base, index, scale, disp). }

[문자열 op를 정수 x를 정수 y를 정수 비트를 FOP]는 {
    정수 code = 88.
    문자열_같은가(op, "sub")이면 { code = 92. }
    아니면 문자열_같은가(op, "mul")이면 { code = 89. }
    아니면 문자열_같은가(op, "div")이면 { code = 94. }
    SSE(F접두(비트), code, x, y, 0, 0, 0).
}

[정수 x를 정수 y를 정수 비트를 UCOMIS]는 {
    비트 == 64이면 { SSE(102, 46, x, y, 0, 0, 0). }
    아니면 { SSE(0, 46, x, y, 0, 0, 0). }
}

[정수 x를 정수 r를 정수 비트를 CVTSI2F]는 { SSE(F접두(비트), 42, x, r, 0, 0, 1). }
[정수 r를 정수 x를 정수 비트를 CVTTF2SI]는 { SSE(F접두(비트), 44, r, x, 0, 0, 1). }
[정수 x를 정수 y를 CVTSD2SS]는 { SSE(242, 90, x, y, 0, 0, 0). }
[정수 x를 정수 y를 CVTSS2SD]는 { SSE(243, 90, x, y, 0, 0, 0). }

(* ---------- 고정 ---------- *)
[라벨해결]는 {
    반복 (정수 k는 0부터 안정배열_길이(라벨고정들) 전까지) {
        고정 참조 f = 안정배열_원소(라벨고정들, k).
        정수 대상위치 = 사전_값_기본(라벨표, f→대상, -1).
        대상위치 < 0이면 {
            파일에_쓰기(표준오류(), "내부 오류: 라벨 없음: {f→대상}\n").
            2로 종료하다.
        }
        바이트열_고치기32(코드, f→위치, 대상위치 - (f→위치 + 4) 를).
    }
}
